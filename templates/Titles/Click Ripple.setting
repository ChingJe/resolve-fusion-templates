				Input17 = InstanceInput { SourceOp = "ColRipEdge", Source = "TopLeftRed", Name = "Outline Colour", ControlGroup = 4 },
				Input18 = InstanceInput { SourceOp = "ColRipEdge", Source = "TopLeftGreen", ControlGroup = 4 },
				Input19 = InstanceInput { SourceOp = "ColRipEdge", Source = "TopLeftBlue", ControlGroup = 4 },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "RipFinal", Source = "Output" }
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				RipCtrl = Background {
					ViewInfo = OperatorInfo { Pos = { -495, -82.5 } },
					Inputs = {
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Hit = Input { Expression = "(function(txt, fps, len, ts, n, gap, life)\n  local a, b, any = -1, -1, false\n  local function hit(sec)\n    for k = 0, n - 1 do\n      local dt = ts - (sec + k*gap)\n      if dt >= 0 and dt < life then\n        if a < 0 or dt < a then a, b = dt, a elseif b < 0 or dt < b then b = dt end\n      end\n    end\n  end\n  for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n    local stamp = line:match(\"^%s*(%S+)\")\n    if stamp then\n      local sec\n      local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n      if pct then sec = tonumber(pct) / 100 * len / fps\n      elseif fr then sec = tonumber(fr) / fps\n      elseif stamp:match(\"^[%d:%.]+$\") then\n        sec = 0\n        for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n      end\n      if sec then any = true; hit(sec) end\n    end\n  end\n  if not any then hit(0) end\n  return Point(a, b)\nend)(RipList.Value, iif(FpsOverride > 0, FpsOverride, comp:GetPrefs('Comp.FrameFormat.Rate') or 24), max(comp.RenderEnd - comp.RenderStart, 1), (time - comp.RenderStart)/iif(FpsOverride > 0, FpsOverride, comp:GetPrefs('Comp.FrameFormat.Rate') or 24), RipClicks, RipGap, RipLife)" },

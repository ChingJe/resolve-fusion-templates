						Intermediate1 = Input { Value = "sqrt(((x - p1x)*w/h)^2 + (y - p1y)^2)" },
						AlphaExpression = Input { Value = "i7" },
						BlueExpression = Input { Value = "i7" },
						GreenExpression = Input { Value = "i7" },
						RedExpression = Input { Value = "i7" },
						Intermediate3 = Input { Value = "if(n3 > 1 && min(max(n6*(1 + 0.25*(n3 - 1)) - 0.25, 0), 1) > 0, min(max((n2*(1 - 0.6*min(max(n6*(1 + 0.25*(n3 - 1)) - 0.25, 0), 1))/2 - abs(i1 - n1*(1 - (1 - min(max(n6*(1 + 0.25*(n3 - 1)) - 0.25, 0), 1))^3)))*h + 0.5, 0), 1)*(1 - min(max(n6*(1 + 0.25*(n3 - 1)) - 0.25, 0), 1))^1.2, 0)" },
						Intermediate5 = Input { Value = "n4*(1 - n6)*min(max((n1*(1 - (1 - n6)^3) - i1)*h + 0.5, 0), 1)" },

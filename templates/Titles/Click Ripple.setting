{
	Tools = ordered() {
		ClickRipple = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "RipCtrl", Source = "RipPos", Name = "Position" },
				Input2 = InstanceInput { SourceOp = "RipCtrl", Source = "RipList", Name = "Click Times (one per line, empty = once at the start)" },
				Input3 = InstanceInput { SourceOp = "RipCtrl", Source = "RipClicks", Name = "Clicks Each Time" },

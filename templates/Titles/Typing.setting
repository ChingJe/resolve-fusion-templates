						},
						LineX = {
							INP_MaxScale = 4,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "LineX",
							INP_Default = 0,
							INP_MinScale = -4
						},
						Curs = {
							LINKID_DataType = "Point",
							LINKS_Name = "Curs",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "OffsetControl"
						},
						Show = {
							INP_MaxScale = 1,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Show",
							INP_Default = 0,
							INP_MinScale = 0
						}
					},
					Inputs = {
						TyPos = Input { Value = { 0.5, 0.14 } },
						GlobalIn = Input { Value = -480 },
						Width = Input { Value = 1920 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Height = Input { Value = 1080 },
						TopLeftAlpha = Input { Value = 0 },
						UseFrameFormatSettings = Input { Value = 1 },
						Idx = Input { Expression = "(function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(TyCtrl:GetValue(\"TyCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(TyCtrl:GetValue(\"TyCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(TyCtrl.TyList.Value, TyCtrl.TyTimed, TyCtrl.TyCue, iif(TyCtrl.FpsOverride > 0, TyCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 1)" },
						GlobalOut = Input { Value = 3534 },
						Since = Input { Expression = "(function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(TyCtrl:GetValue(\"TyCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(TyCtrl:GetValue(\"TyCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(TyCtrl.TyList.Value, TyCtrl.TyTimed, TyCtrl.TyCue, iif(TyCtrl.FpsOverride > 0, TyCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 2)" },
						Until = Input { Expression = "min((function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(TyCtrl:GetValue(\"TyCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(TyCtrl:GetValue(\"TyCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(TyCtrl.TyList.Value, TyCtrl.TyTimed, TyCtrl.TyCue, iif(TyCtrl.FpsOverride > 0, TyCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 3), comp.RenderEnd - time + 1)" },
						Cur = Input { Expression = "Text((function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(TyCtrl:GetValue(\"TyCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(TyCtrl:GetValue(\"TyCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(TyCtrl.TyList.Value, TyCtrl.TyTimed, TyCtrl.TyCue, iif(TyCtrl.FpsOverride > 0, TyCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 4))" },
						Total = Input { Expression = "(function(s) local n = 0 for ch in s:gmatch(\"[^\" .. string.char(128) .. \"-\" .. string.char(191) .. \"][\" .. string.char(128) .. \"-\" .. string.char(191) .. \"]*\") do n = n + 1 end return n end)(Cur.Value)" },
						Count = Input { Expression = "(function(since, untl, n, speed, done, fps, exit, del)\n  if n < 1 then return Point(0, 0) end\n  local frames = (speed > 0) and n/speed*fps or done*(since + untl)\n  local c, busy = math.floor(n*math.min((since + 1)/math.max(frames, 1), 1) + 0.0001), 0\n  if since + 1 < frames then busy = 1 end\n  if exit == 1 then\n    local left = math.floor(math.max(untl - 1, 0)*del/fps)\n    if left <= n then busy = 1 end\n    c = math.min(c, left)\n  end\n  return Point(c, busy)\nend)(Since, Until, Total, TySpeed, TyEnd, iif(FpsOverride > 0, FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), TyExit, TyDel)" },
						Typed = Input { Expression = "Text((function(s, n) local out, k = {}, 0 for ch in s:gmatch(\"[^\" .. string.char(128) .. \"-\" .. string.char(191) .. \"][\" .. string.char(128) .. \"-\" .. string.char(191) .. \"]*\") do if k >= n then break end k = k + 1 out[k] = ch end return table.concat(out) end)(Cur.Value, Count.X))" },
						Rule = Input { Expression = "(function() local d = TyRuler.Output.DataWindow if not d then return Point(0, 0) end local w, h = TyRuler.Output.Width, TyRuler.Output.Height return Point(d.left/w, d.right/w) end)()" },
						RuleY = Input { Expression = "(function() local d = TyRuler.Output.DataWindow if not d then return Point(0, 0) end local w, h = TyRuler.Output.Width, TyRuler.Output.Height return Point(d.bottom/h, d.top/h) end)()" },
						Wid = Input { Expression = "max((function() local d = TyMeasure.Output.DataWindow if not d then return 0 end local w, h = TyMeasure.Output.Width, TyMeasure.Output.Height return d.right/w end)() - Rule.Y, 0)" },
						FullW = Input { Expression = "max((function() local d = TyFull.Output.DataWindow if not d then return 0 end local w, h = TyFull.Output.Width, TyFull.Output.Height return d.right/w end)() - Rule.Y, 0)" },
						LineX = Input { Expression = "iif(TyAlign == 0, TyPos.X, iif(TyAlign == 1, TyPos.X - FullW/2, TyPos.X - Wid/2))" },
						Curs = Input { Expression = "Point(LineX + Wid + Rule.X - 0.05 + TySize*0.03, iif(TyCursor == 0, TySize*0.07, iif(TyCursor == 3, 0, TySize*0.5)))" },
						Show = Input { Expression = "iif(TyCursor == 3 or Idx < 1, 0, iif(Count.Y > 0 or TyBlink <= 0, 1, iif((Since/iif(FpsOverride > 0, FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24)*TyBlink) % 1 < 0.5, 1, 0)))" }
					}

							ICS_ControlPage = "Driver",
							INPID_InputControl = "OffsetControl"
						},
						Wid = {
							INP_MaxScale = 4,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Wid",
							INP_Default = 0,
							INP_MinScale = 0
						},
						FullW = {
							INP_MaxScale = 4,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "FullW",
							INP_Default = 0,

							INP_Default = 0,
							INP_Integer = true,
							LINKS_Name = "Lines Start With A Time (0:02 Text)",
							ICS_ControlPage = "Controls",
							LINKID_DataType = "Number"
						},
						Idx = {
							INPID_InputControl = "SliderControl",
							LINKS_Name = "Idx",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_Integer = false,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INP_MaxScale = 100
						},
						Scale = {
							INPID_InputControl = "SliderControl",
							LINKS_Name = "Scale",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_Integer = false,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INP_MaxScale = 4
						},
						Since = {
							INPID_InputControl = "SliderControl",
							LINKS_Name = "Since",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_Integer = false,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INP_MaxScale = 100
						},
						Until = {
							INPID_InputControl = "SliderControl",
							LINKS_Name = "Until",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_Integer = false,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INP_MaxScale = 100
						},
						T = {
							INPID_InputControl = "SliderControl",
							LINKS_Name = "T",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_Integer = false,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INP_MaxScale = 1
						},
						Fade = {
							INPID_InputControl = "SliderControl",
							LINKS_Name = "Fade",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_Integer = false,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INP_MaxScale = 1
						},
						Rot = {
							INPID_InputControl = "SliderControl",
							LINKS_Name = "Rot",
							INP_Default = 0,
							INP_MinScale = -90,
							INP_Integer = false,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INP_MaxScale = 90
						},
						Cur = {
							INPID_InputControl = "TextEditControl",
							TEC_Lines = 1,
							LINKS_Name = "Cur",
							INPS_DefaultText = "",
							ICS_ControlPage = "Driver",
							LINKID_DataType = "Text"
						}
					},
					CtrlWZoom = false,
					Inputs = {
						Off = Input { Expression = "(function(e, t, s, n, dur, now)\n  local function r(k) local v = math.sin(now*12.9898 + k)*43758.5453 return (v - math.floor(v))*2 - 1 end\n  if e == 1 then\n    local a = 0\n    if n >= dur*0.8 then a = 0.012*s*math.max(0, 1 - (n - dur*0.8)/dur) end\n    return Point(a*r(1.3), a*r(7.7))\n  elseif e == 2 then\n    local a = 0.014*s*math.max(0, 1 - n/(dur*2))\n    return Point(a*r(1.3), a*r(7.7))\n  elseif e == 3 then\n    local u = 1 - t\n    return Point(0, -0.08*s*u*u*u)\n  end\n  return Point(0, 0)\nend)(CapEnter, T, CapPower, Since, max(CapIn, 1), time)" },
						WA = Input { Expression = "(function()\n  if SegA.StyledText.Value == \"\" then return 0 end\n  local d = SegA.Output.DataWindow\n  if not d then return 0 end\n  return math.max(d.right - d.left, 0) / SegA.Output.Width\nend)()" },
						WB = Input { Expression = "(function()\n  if SegB.StyledText.Value == \"\" then return 0 end\n  local d = SegB.Output.DataWindow\n  if not d then return 0 end\n  return math.max(d.right - d.left, 0) / SegB.Output.Width\nend)()" },
						WC = Input { Expression = "(function()\n  if SegC.StyledText.Value == \"\" then return 0 end\n  local d = SegC.Output.DataWindow\n  if not d then return 0 end\n  return math.max(d.right - d.left, 0) / SegC.Output.Width\nend)()" },
						GlobalIn = Input { Value = -480 },
						UseFrameFormatSettings = Input { Value = 1 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Gap = Input { Expression = "Point(iif(WA > 0 and WB > 0, CapGap*CapSize, 0), iif(WB > 0 and WC > 0, CapGap*CapSize, 0))" },
						CapPos = Input { Value = { 0.5, 0.2 } },
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						Until = Input { Expression = "(function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(VarCtrl:GetValue(\"CapCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(VarCtrl:GetValue(\"CapCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(VarCtrl.CapList.Value, VarCtrl.CapTimed, VarCtrl.CapCue, iif(VarCtrl.FpsOverride > 0, VarCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 3)" },
						Idx = Input { Expression = "(function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(VarCtrl:GetValue(\"CapCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(VarCtrl:GetValue(\"CapCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(VarCtrl.CapList.Value, VarCtrl.CapTimed, VarCtrl.CapCue, iif(VarCtrl.FpsOverride > 0, VarCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 1)" },
						Fade = Input { Expression = "iif(Idx < 1, 0, min(T*3, 1) * iif(CapOut <= 0, 1, min(max(Until/CapOut, 0), 1)))" },
						Since = Input { Expression = "(function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(VarCtrl:GetValue(\"CapCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(VarCtrl:GetValue(\"CapCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(VarCtrl.CapList.Value, VarCtrl.CapTimed, VarCtrl.CapCue, iif(VarCtrl.FpsOverride > 0, VarCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 2)" },
						TopLeftAlpha = Input { Value = 0 },
						T = Input { Expression = "iif(Idx < 1, 0, min(max((Since + 1)/max(CapIn, 1), 0), 1))" },
						Scale = Input { Expression = "(function(e, t, s)\n  if e == 0 then local u = t - 1 local k = 1.70158*s return 0.5 + 0.5*(1 + (k + 1)*u*u*u + k*u*u) end\n  if e == 1 then return 1 + 1.6*s*(1 - t)^3 end\n  return 1\nend)(CapEnter, T, CapPower)" },
						Rot = Input { Expression = "CapTilt * iif(Idx % 2 == 1, 1, -1) + CapSway*sin(time*14)" },
						Cur = Input { Expression = "Text((function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(VarCtrl:GetValue(\"CapCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(VarCtrl:GetValue(\"CapCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(VarCtrl.CapList.Value, VarCtrl.CapTimed, VarCtrl.CapCue, iif(VarCtrl.FpsOverride > 0, VarCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 4))" }

				},
				HidWordInk = Custom {
					Inputs = {
						Image3 = Input {
							SourceOp = "HidWordInkGrowB",
							Source = "Output"
						},
						PointIn2 = Input { Expression = "Point(ColHidOuter.TopLeftBlue, 0)" },
						NumberIn7 = Input { Expression = "iif((HidCtrl.HidEdge) > 0, 1, 0)" },
						AlphaExpression = Input { Value = "a1 + (1 - a1)*(i1 + (1 - i1)*i2)" },
						PointIn1 = Input { Expression = "Point(ColHidOuter.TopLeftRed, ColHidOuter.TopLeftGreen)" },
						NumberIn8 = Input { Expression = "iif((HidCtrl.HidOuter) > 0, 1, 0)" },
						Image1 = Input {
							SourceOp = "HidWord",
							Source = "Output"
						},
						Image2 = Input {
							SourceOp = "HidWordInkGrowA",
							Source = "Output"
						},
						RedExpression = Input { Value = "n1*a1 + (1 - a1)*(n4*i1 + (1 - i1)*p1x*i2)" },
						NumberIn1 = Input { Expression = "ColHidWord.TopLeftRed" },
						GreenExpression = Input { Value = "n2*a1 + (1 - a1)*(n5*i1 + (1 - i1)*p1y*i2)" },
						NumberIn2 = Input { Expression = "ColHidWord.TopLeftGreen" },
						BlueExpression = Input { Value = "n3*a1 + (1 - a1)*(n6*i1 + (1 - i1)*p2x*i2)" },
						NumberIn5 = Input { Expression = "ColHidEdge.TopLeftGreen" },
						NumberIn3 = Input { Expression = "ColHidWord.TopLeftBlue" },
						LUTIn1 = Input {
							SourceOp = "CustomTool1LUTIn11",
							Source = "Value"
						},
						LUTIn2 = Input {
							SourceOp = "CustomTool1LUTIn21",
							Source = "Value"
						},
						Intermediate1 = Input { Value = "a2*n7" },
						LUTIn4 = Input {
							SourceOp = "CustomTool1LUTIn41",
							Source = "Value"
						},
						Intermediate2 = Input { Value = "a3*n8" },
						NumberIn6 = Input { Expression = "ColHidEdge.TopLeftBlue" },
						NumberIn4 = Input { Expression = "ColHidEdge.TopLeftRed" },
						LUTIn3 = Input {
							SourceOp = "CustomTool1LUTIn31",
							Source = "Value"
						}
					},
					ViewInfo = OperatorInfo { Pos = { 165, 148.5 } }
				},
				CustomTool1LUTIn11 = LUTBezier {
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					},
					NameSet = true,
					SplineColor = { Green = 0, Blue = 0, Red = 0 },
					CtrlWZoom = false
				},
				CustomTool1LUTIn21 = LUTBezier {
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }

						},
						Gap = {
							LINKS_Name = "Gap",
							LINKID_DataType = "Point",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "OffsetControl"
						},
						WQ = {
							INP_MaxScale = 2,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "WQ",
							INP_Default = 0,
							INP_MinScale = 0
						}
					},
					Inputs = {
						GlobalIn = Input { Value = -480 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Pop = Input { Expression = "iif(R <= 0, 0, (function(t) t = t - 1 return 1 + 3.2*t*t*t + 2.2*t*t end)(R))" },
						Fade = Input { Expression = "min((time - comp.RenderStart + 1)/max(HidIn, 1)*2, 1) * iif(HidOut <= 0, 1, min(max((comp.RenderEnd - time + 1)/HidOut, 0), 1))" },
						R = Input { Expression = "min(max((time - comp.RenderStart - At + 1)/max(HidFrames, 1), 0), 1)" },
						WB = Input { Expression = "(function()\n  if HidB.StyledText.Value == \"\" then return 0 end\n  local d = HidB.Output.DataWindow\n  if not d then return 0 end\n  return math.max(d.right - d.left, 0) / HidB.Output.Width\nend)()" },
						WC = Input { Expression = "(function()\n  if HidC.StyledText.Value == \"\" then return 0 end\n  local d = HidC.Output.DataWindow\n  if not d then return 0 end\n  return math.max(d.right - d.left, 0) / HidC.Output.Width\nend)()" },
						WQ = Input { Expression = "(function()\n  if HidQ.StyledText.Value == \"\" then return 0 end\n  local d = HidQ.Output.DataWindow\n  if not d then return 0 end\n  return math.max(d.right - d.left, 0) / HidQ.Output.Width\nend)()" },
						MarkAt = Input { Expression = "Point((HidCtrl.HidPos.X - (HidCtrl.WA + HidCtrl.WB + HidCtrl.WC + HidCtrl.Gap.X + HidCtrl.Gap.Y)/2) + HidCtrl.WA + HidCtrl.Gap.X + HidCtrl.WB/2, HidCtrl.HidPos.Y + 0.28*HidCtrl.HidSize*(HidCtrl.HidMark - 1)*comp:GetPrefs('Comp.FrameFormat.Width')/comp:GetPrefs('Comp.FrameFormat.Height'))" },
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						TopLeftAlpha = Input { Value = 0 },
						HidPos = Input { Value = { 0.5, 0.2 } },
						UseFrameFormatSettings = Input { Value = 1 },
						At = Input { Expression = "(function(s, fps, len)\n  s = s:gsub(\"%s\", \"\")\n  local pct, fr = s:match(\"^([%d%.]+)%%$\"), s:match(\"^(%d+)[fF]$\")\n  if pct then return tonumber(pct)/100*len end\n  if fr then return tonumber(fr) end\n  if s:match(\"^[%d:%.]+$\") then\n    local sec = 0\n    for part in s:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec*60 + tonumber(part) end\n    if sec then return sec*fps end\n  end\n  return len/2\nend)(HidAt.Value, iif(FpsOverride > 0, FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), max(comp.RenderEnd - comp.RenderStart, 1))" },
						Gap = Input { Expression = "Point(iif(WA > 0 and WB > 0, HidGap*HidSize, 0), iif(WB > 0 and WC > 0, HidGap*HidSize, 0))" },
						WA = Input { Expression = "(function()\n  if HidA.StyledText.Value == \"\" then return 0 end\n  local d = HidA.Output.DataWindow\n  if not d then return 0 end\n  return math.max(d.right - d.left, 0) / HidA.Output.Width\nend)()" }
					},
					CtrlWZoom = false,
					ViewInfo = OperatorInfo { Pos = { -495, -82.5 } }
				},
				HidA = TextPlus {
					Inputs = {
						LayoutRotation = Input { Value = 1 },
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						VerticalJustificationNew = Input { Value = 3 },
						HorizontalJustificationNew = Input { Value = 3 },
						Size = Input { Expression = "HidCtrl.HidSize" },
						GlobalIn = Input { Value = -480 },
						TransformRotation = Input { Value = 1 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						StyledText = Input { Expression = "Text((function(s, n)\n  local a, b, c = s:match(\"^(.-)%*(.-)%*(.*)$\")\n  if not a then a, b, c = s, \"\", \"\" end\n  return (({a, b, c})[n]:gsub(\"%*\", \"\"):gsub(\"^%s+\", \"\"):gsub(\"%s+$\", \"\"))\nend)(HidCtrl.HidText.Value, 1))" },
						UseFrameFormatSettings = Input { Value = 1 },
						Font = Input { Value = "Microsoft JhengHei" },
						Softness1 = Input { Value = 1 },
						Style = Input { Value = "Bold" },
						Wrap = Input { Value = 1 }
					},
					Version = 1,
					ViewInfo = OperatorInfo { Pos = { -385, 16.5 } }
				},
				HidPutA = Merge {
					Inputs = {
						Background = Input {
							SourceOp = "HidCtrl",
							Source = "Output"
						},
						PerformDepthMerge = Input { Value = 0 },
						Foreground = Input {
							SourceOp = "HidA",
							Source = "Output"
						},
						Center = Input { Expression = "Point((HidCtrl.HidPos.X - (HidCtrl.WA + HidCtrl.WB + HidCtrl.WC + HidCtrl.Gap.X + HidCtrl.Gap.Y)/2) + HidCtrl.WA/2, HidCtrl.HidPos.Y)" }
					},
					ViewInfo = OperatorInfo { Pos = { -165, 16.5 } }
				},
				HidB = TextPlus {
					Inputs = {
						LayoutRotation = Input { Value = 1 },
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						VerticalJustificationNew = Input { Value = 3 },
						HorizontalJustificationNew = Input { Value = 3 },
						Size = Input { Expression = "HidCtrl.HidSize * HidCtrl.HidMark" },
						GlobalIn = Input { Value = -480 },
						TransformRotation = Input { Value = 1 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						StyledText = Input { Expression = "Text((function(s, n)\n  local a, b, c = s:match(\"^(.-)%*(.-)%*(.*)$\")\n  if not a then a, b, c = s, \"\", \"\" end\n  return (({a, b, c})[n]:gsub(\"%*\", \"\"):gsub(\"^%s+\", \"\"):gsub(\"%s+$\", \"\"))\nend)(HidCtrl.HidText.Value, 2))" },
						UseFrameFormatSettings = Input { Value = 1 },
						Font = Input {
							Expression = "HidA.Font",
							Value = "Microsoft JhengHei"
						},
						Softness1 = Input { Value = 1 },

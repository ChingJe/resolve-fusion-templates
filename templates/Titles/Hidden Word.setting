							INP_Default = 0.25,
							INP_MinScale = 0
						},
						At = {
							INP_MaxScale = 1000000,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "At",
							INP_Default = 0,
							INP_MinScale = 0
						},
						HidRound = {
							INP_MaxScale = 1,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Sticker Roundness",
							INP_Default = 0.3,
							INP_MinScale = 0
						},
						WA = {
							INP_MaxScale = 2,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "WA",
							INP_Default = 0,

						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						VerticalJustificationNew = Input { Value = 3 },
						StyledText = Input { Expression = "Text((function(txt, timed, idx, mode, upto)\n  local out, n = {}, 0\n  for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n    n = n + 1\n    if line:match(\"%S\") then\n      local s = line\n      if timed == 1 then s = line:match(\"^%s*%S+%s*(.-)%s*$\") or \"\" end\n      if not (mode == 3 or (mode == 1 and n == idx) or (mode == 2 and n <= upto)) then s = s:gsub(\"[^|]+\", string.char(194, 160)) if s == \"\" then s = string.char(194, 160) end end\n      out[#out + 1] = s\n    end\n  end\n  return (table.concat(out, \"\\n\"):gsub(\"%s*|%s*\", \"\\n\"))\nend)(KinCtrl.LineList.Value, KinCtrl.KinTimed, KinCtrl.Idx, 2, KinCtrl.Idx - iif(KinCtrl.T < 1, 1, 0)))" },
						Width = Input { Value = 1920 },
						Style = Input {
							Expression = "Line.Style",
							Value = "Bold"
						},
						Center = Input { Expression = "KinCtrl.KinPos" },
						Size = Input { Expression = "KinCtrl.KinSize" },
						Wrap = Input { Value = 1 },
						LayoutRotation = Input { Value = 1 },
						TransformRotation = Input { Value = 1 },
						Softness1 = Input { Value = 1 }
					},
					Version = 1
				},
				Box = TextPlus {
					ViewInfo = OperatorInfo { Pos = { -275, 82.5 } },
					Inputs = {
						Height = Input { Value = 1080 },
						AngleZ = Input { Expression = "Line.AngleZ" },
						UseFrameFormatSettings = Input { Value = 1 },
						HorizontalJustificationNew = Input { Value = 3 },
						HorizontalLeftCenterRight = Input { Expression = "Line.HorizontalLeftCenterRight" },
						VerticalJustificationNew = Input { Value = 3 },
						Width = Input { Value = 1920 },
						Red1 = Input { Value = 0.93 },
						Green1 = Input { Value = 0.16 },
						Blue1 = Input { Value = 0.16 },
						Style = Input {
							Expression = "Line.Style",
							Value = "Bold"
						},
						Center = Input { Expression = "iif(KinCtrl.KinKeep == 1, KinCtrl.KinPos, Line.Center)" },
						GlobalIn = Input { Value = -480 },
						Font = Input {
							Expression = "Line.Font",
							Value = "Open Sans"
						},
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Softness1 = Input { Value = 1 },
						StyledText = Input { Expression = "iif(KinCtrl.KinKeep == 1, Text((function(txt, timed, idx, mode, upto)\n  local out, n = {}, 0\n  for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n    n = n + 1\n    if line:match(\"%S\") then\n      local s = line\n      if timed == 1 then s = line:match(\"^%s*%S+%s*(.-)%s*$\") or \"\" end\n      if not (mode == 3 or (mode == 1 and n == idx) or (mode == 2 and n <= upto)) then s = s:gsub(\"[^|]+\", string.char(194, 160)) if s == \"\" then s = string.char(194, 160) end end\n      out[#out + 1] = s\n    end\n  end\n  return (table.concat(out, \"\\n\"):gsub(\"%s*|%s*\", \"\\n\"))\nend)(KinCtrl.LineList.Value, KinCtrl.KinTimed, KinCtrl.Idx, 3, 0)), Line.StyledText)" },
						TransformRotation = Input { Value = 1 },
						LayoutRotation = Input { Value = 1 },
						ExtendVertical1 = Input { Expression = "KinCtrl.KinPadY" },
						Size = Input { Expression = "Line.Size" },
						Wrap = Input { Value = 1 },
						ElementShape1 = Input { Value = 2 },
						Level1 = Input { Value = 0 },
						ExtendHorizontal1 = Input { Expression = "KinCtrl.KinPadX" }
					},
					Version = 1
				},
				Boxed = Merge {
					Inputs = {
						Blend = Input { Expression = "KinCtrl.KinBox * iif(KinCtrl.KinKeep == 1, iif(KinCtrl.Idx < 1, 0, iif(KinCtrl.Idx < 2, min(KinCtrl.T*3, 1), 1)), KinCtrl.Fade)" },
						PerformDepthMerge = Input { Value = 0 },
						Background = Input {
							SourceOp = "KinCtrl",
							Source = "Output"
						},
						Foreground = Input {
							SourceOp = "Box",
							Source = "Output"
						}
					},
					ViewInfo = OperatorInfo { Pos = { -55, 82.5 } }
				},
				Listed = Merge {
					Inputs = {
						Blend = Input { Expression = "iif(KinCtrl.KinKeep == 1, KinCtrl.KinDim, 0)" },
						PerformDepthMerge = Input { Value = 0 },
						Background = Input {

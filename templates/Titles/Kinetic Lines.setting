						Wrap = Input { Value = 1 },
						StyledText = Input { Expression = "iif(KinCtrl.KinKeep == 1, Text((function(txt, timed, idx, mode, upto)\n  local out, n = {}, 0\n  for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n    n = n + 1\n    if line:match(\"%S\") then\n      local s = line\n      if timed == 1 then s = line:match(\"^%s*%S+%s*(.-)%s*$\") or \"\" end\n      if not (mode == 3 or (mode == 1 and n == idx) or (mode == 2 and n <= upto)) then s = s:gsub(\"[^|]+\", string.char(194, 160)) if s == \"\" then s = string.char(194, 160) end end\n      out[#out + 1] = s\n    end\n  end\n  return (table.concat(out, \"\\n\"):gsub(\"%s*|%s*\", \"\\n\"))\nend)(KinCtrl.LineList.Value, KinCtrl.KinTimed, KinCtrl.Idx, 1, 0)), Text((function(s) return (s:gsub('%s*|%s*', '\\n')) end)((function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(KinCtrl:GetValue(\"KinCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(KinCtrl:GetValue(\"KinCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(KinCtrl.LineList.Value, KinCtrl.KinTimed, KinCtrl.KinCue, iif(KinCtrl.FpsOverride > 0, KinCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 4))))" },

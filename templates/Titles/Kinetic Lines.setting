							INP_Integer = false,
							INPID_InputControl = "SliderControl"
						},
						Idx = {
							INP_MaxScale = 100,
							LINKS_Name = "Idx",
							LINKID_DataType = "Number",
							INP_Default = 0,
							INP_MinScale = 0,
							ICS_ControlPage = "Driver",
							INP_Integer = false,

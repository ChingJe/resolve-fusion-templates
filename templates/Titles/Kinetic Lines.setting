{
	Tools = ordered() {
		KineticLines = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "KinCtrl", Source = "LineList", Name = "Lines (0:00 Text)" },
				Input2 = InstanceInput { SourceOp = "KinCtrl", Source = "KinTimed", Name = "Lines Start With A Time (0:02 Text)" },
				Input3 = InstanceInput { SourceOp = "KinCtrl", Source = "KinCue", Name = "Line Number (keyframe 1, 2, 3)" },
				Input4 = InstanceInput { SourceOp = "KinCtrl", Source = "FpsOverride", Name = "Frame Rate Override" },
				Input5 = InstanceInput { SourceOp = "Line", Source = "Font", Name = "Font", ControlGroup = 2 },
				Input6 = InstanceInput { SourceOp = "Line", Source = "Style", ControlGroup = 2 },
				Input7 = InstanceInput { SourceOp = "KinCtrl", Source = "KinSize", Name = "Size" },
				Input8 = InstanceInput { SourceOp = "Line", Source = "Red1", Name = "Color", ControlGroup = 3 },
				Input9 = InstanceInput { SourceOp = "Line", Source = "Green1", ControlGroup = 3 },
				Input10 = InstanceInput { SourceOp = "Line", Source = "Blue1", ControlGroup = 3 },
				Input11 = InstanceInput { SourceOp = "KinCtrl", Source = "KinPos", Name = "Position" },
				Input12 = InstanceInput { SourceOp = "KinCtrl", Source = "KinIn", Name = "Pop Frames" },
				Input13 = InstanceInput { SourceOp = "KinCtrl", Source = "KinOut", Name = "Fade Out Frames" },
				Input14 = InstanceInput { SourceOp = "KinCtrl", Source = "KinBounce", Name = "Bounce" },
				Input15 = InstanceInput { SourceOp = "KinCtrl", Source = "KinGrow", Name = "Grow From" },
				Input16 = InstanceInput { SourceOp = "KinCtrl", Source = "KinRise", Name = "Rise" },
				Input17 = InstanceInput { SourceOp = "KinCtrl", Source = "KinTilt", Name = "Tilt" },
				Input18 = InstanceInput { SourceOp = "KinCtrl", Source = "KinBox", Name = "Box Opacity" },
				Input19 = InstanceInput { SourceOp = "Box", Source = "Red1", Name = "Box Color", ControlGroup = 4 },
				Input20 = InstanceInput { SourceOp = "Box", Source = "Green1", ControlGroup = 4 },
				Input21 = InstanceInput { SourceOp = "Box", Source = "Blue1", ControlGroup = 4 },
				Input22 = InstanceInput { SourceOp = "KinCtrl", Source = "KinPadX", Name = "Box Padding X" },
				Input23 = InstanceInput { SourceOp = "KinCtrl", Source = "KinPadY", Name = "Box Padding Y" },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "KinFinal", Source = "Output" }
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				KinCtrl = Background {
					UserControls = {
						KinTilt = {
							INP_Default = 0,
							LINKID_DataType = "Number",
							INP_MaxScale = 30,
							INPID_InputControl = "SliderControl",
							INP_MinScale = -30,
							LINKS_Name = "Tilt",
							INP_Integer = false,
							ICS_ControlPage = "Controls"
						},
						KinBox = {
							INP_Default = 0,
							LINKID_DataType = "Number",
							INP_MaxScale = 1,
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							LINKS_Name = "Box Opacity",
							INP_Integer = false,
							ICS_ControlPage = "Controls"
						},
						KinPadX = {
							INP_Default = 0.25,
							LINKID_DataType = "Number",
							INP_MaxScale = 1,
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							LINKS_Name = "Box Padding X",
							INP_Integer = false,
							ICS_ControlPage = "Controls"
						},
						KinPadY = {
							INP_Default = 0.15,
							LINKID_DataType = "Number",
							INP_MaxScale = 1,
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							LINKS_Name = "Box Padding Y",
							INP_Integer = false,
							ICS_ControlPage = "Controls"
						},
						KinTimed = {
							INP_Default = 1,
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							LINKS_Name = "Lines Start With A Time (0:02 Text)",
							INP_Integer = true,
							ICS_ControlPage = "Controls"
						},
						KinPos = {
							ICS_ControlPage = "Controls",
							INPID_InputControl = "OffsetControl",
							LINKS_Name = "Position",
							LINKID_DataType = "Point",
							INPID_PreviewControl = "CrosshairControl"
						},
						KinCue = {
							INP_Default = 1,
							LINKID_DataType = "Number",
							INP_MaxScale = 20,
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							LINKS_Name = "Line Number (keyframe 1, 2, 3)",
							INP_Integer = false,
							ICS_ControlPage = "Controls"
						},
						FpsOverride = {
							INP_Default = 0,
							LINKID_DataType = "Number",
							INP_MaxScale = 120,
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							LINKS_Name = "Frame Rate Override",
							INP_Integer = false,
							ICS_ControlPage = "Controls"
						},
						T = {
							INP_Default = 0,
							LINKID_DataType = "Number",
							INP_MaxScale = 1,
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							LINKS_Name = "T",
							INP_Integer = false,
							ICS_ControlPage = "Driver"
						},
						KinSize = {
							INP_Default = 0.11,
							LINKID_DataType = "Number",
							INP_MaxScale = 0.4,
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0.02,
							LINKS_Name = "Size",
							INP_Integer = false,
							ICS_ControlPage = "Controls"
						},
						Back = {
							INP_Default = 0,
							LINKID_DataType = "Number",
							INP_MaxScale = 2,
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							LINKS_Name = "Back",
							INP_Integer = false,
							ICS_ControlPage = "Driver"
						},
						KinIn = {
							INP_Default = 8,
							LINKID_DataType = "Number",
							INP_MaxScale = 40,
							INPID_InputControl = "SliderControl",
							INP_MinScale = 1,
							LINKS_Name = "Pop Frames",
							INP_Integer = false,
							ICS_ControlPage = "Controls"
						},
						Idx = {
							INP_Default = 0,
							LINKID_DataType = "Number",
							INP_MaxScale = 100,
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							LINKS_Name = "Idx",
							INP_Integer = false,
							ICS_ControlPage = "Driver"
						},
						KinOut = {
							INP_Default = 3,
							LINKID_DataType = "Number",
							INP_MaxScale = 40,
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							LINKS_Name = "Fade Out Frames",
							INP_Integer = false,
							ICS_ControlPage = "Controls"
						},
						Until = {
							INP_Default = 0,
							LINKID_DataType = "Number",
							INP_MaxScale = 100,
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							LINKS_Name = "Until",
							INP_Integer = false,
							ICS_ControlPage = "Driver"
						},
						KinBounce = {
							INP_Default = 1,
							LINKID_DataType = "Number",
							INP_MaxScale = 3,
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							LINKS_Name = "Bounce",
							INP_Integer = false,
							ICS_ControlPage = "Controls"
						},
						Fade = {
							INP_Default = 0,
							LINKID_DataType = "Number",
							INP_MaxScale = 1,
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							LINKS_Name = "Fade",
							INP_Integer = false,
							ICS_ControlPage = "Driver"
						},
						KinGrow = {
							INP_Default = 0.6,
							LINKID_DataType = "Number",
							INP_MaxScale = 1.5,
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							LINKS_Name = "Grow From",
							INP_Integer = false,
							ICS_ControlPage = "Controls"
						},
						LineList = {
							TEC_Lines = 8,
							LINKID_DataType = "Text",
							INPID_InputControl = "TextEditControl",
							LINKS_Name = "Lines (0:00 Text)",
							ICS_ControlPage = "Controls",
							INPS_DefaultText = "0% FIRST LINE\n25% THEN THIS\n50% TWO LINES|IN ONE\n75% LAST ONE"
						},
						KinRise = {
							INP_Default = 0.04,
							LINKID_DataType = "Number",
							INP_MaxScale = 0.3,
							INPID_InputControl = "SliderControl",
							INP_MinScale = -0.3,
							LINKS_Name = "Rise",
							INP_Integer = false,
							ICS_ControlPage = "Controls"
						},
						Since = {
							INP_Default = 0,
							LINKID_DataType = "Number",
							INP_MaxScale = 100,
							INPID_InputControl = "SliderControl",
							INP_MinScale = 0,
							LINKS_Name = "Since",
							INP_Integer = false,
							ICS_ControlPage = "Driver"
						}
					},
					Inputs = {
						GlobalIn = Input { Value = -480 },
						Height = Input { Value = 1080 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Back = Input { Expression = "(function(t, s) t = t - 1 return 1 + (s + 1)*t*t*t + s*t*t end)(T, 1.70158*KinBounce)" },
						Fade = Input { Expression = "iif(Idx < 1, 0, min(T*3, 1) * iif(KinOut <= 0, 1, min(max(Until/KinOut, 0), 1)))" },
						Idx = Input { Expression = "(function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(KinCtrl:GetValue(\"KinCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(KinCtrl:GetValue(\"KinCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(KinCtrl.LineList.Value, KinCtrl.KinTimed, KinCtrl.KinCue, iif(KinCtrl.FpsOverride > 0, KinCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 1)" },
						Since = Input { Expression = "(function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(KinCtrl:GetValue(\"KinCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(KinCtrl:GetValue(\"KinCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(KinCtrl.LineList.Value, KinCtrl.KinTimed, KinCtrl.KinCue, iif(KinCtrl.FpsOverride > 0, KinCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 2)" },
						TopLeftAlpha = Input { Value = 0 },
						UseFrameFormatSettings = Input { Value = 1 },
						Until = Input { Expression = "(function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(KinCtrl:GetValue(\"KinCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(KinCtrl:GetValue(\"KinCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(KinCtrl.LineList.Value, KinCtrl.KinTimed, KinCtrl.KinCue, iif(KinCtrl.FpsOverride > 0, KinCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 3)" },
						T = Input { Expression = "iif(Idx < 1, 0, min(max((Since + 1)/max(KinIn, 1), 0), 1))" },
						Width = Input { Value = 1920 }
					},
					CtrlWZoom = false,
					ViewInfo = OperatorInfo { Pos = { -495, -82.5 } }
				},
				Line = TextPlus {
					Version = 1,
					ViewInfo = OperatorInfo { Pos = { -275, 16.5 } },
					Inputs = {
						GlobalIn = Input { Value = -480 },
						Height = Input { Value = 1080 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Font = Input { Value = "Microsoft JhengHei" },
						Style = Input { Value = "Bold" },
						StyledText = Input { Expression = "Text((function(s) return (s:gsub('%s*|%s*', '\\n')) end)((function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(KinCtrl:GetValue(\"KinCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(KinCtrl:GetValue(\"KinCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(KinCtrl.LineList.Value, KinCtrl.KinTimed, KinCtrl.KinCue, iif(KinCtrl.FpsOverride > 0, KinCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 4)))" },
						LayoutRotation = Input { Value = 1 },
						TransformRotation = Input { Value = 1 },
						Softness1 = Input { Value = 1 },
						AngleZ = Input { Expression = "KinCtrl.KinTilt * iif(KinCtrl.Idx % 2 == 1, 1, -1)" },
						HorizontalJustificationNew = Input { Value = 3 },
						Size = Input { Expression = "KinCtrl.KinSize * (KinCtrl.KinGrow + (1 - KinCtrl.KinGrow)*KinCtrl.Back)" },
						VerticalJustificationNew = Input { Value = 3 },
						UseFrameFormatSettings = Input { Value = 1 },
						Center = Input { Expression = "Point(KinCtrl.KinPos.X, KinCtrl.KinPos.Y - KinCtrl.KinRise*(1 - KinCtrl.Back))" },
						Wrap = Input { Value = 1 },
						Width = Input { Value = 1920 }
					}
				},
				Box = TextPlus {
					Version = 1,
					ViewInfo = OperatorInfo { Pos = { -275, 82.5 } },
					Inputs = {
						GlobalIn = Input { Value = -480 },
						Height = Input { Value = 1080 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Font = Input {
							Value = "Open Sans",
							Expression = "Line.Font"
						},
						Style = Input {
							Value = "Bold",
							Expression = "Line.Style"
						},
						Wrap = Input { Value = 1 },
						LayoutRotation = Input { Value = 1 },
						Center = Input { Expression = "Line.Center" },
						Softness1 = Input { Value = 1 },
						AngleZ = Input { Expression = "Line.AngleZ" },
						HorizontalJustificationNew = Input { Value = 3 },
						VerticalJustificationNew = Input { Value = 3 },
						StyledText = Input { Expression = "Line.StyledText" },
						Size = Input { Expression = "Line.Size" },
						Blue1 = Input { Value = 0.16 },
						Width = Input { Value = 1920 },
						ElementShape1 = Input { Value = 2 },
						Level1 = Input { Value = 0 },
						Red1 = Input { Value = 0.93 },
						Green1 = Input { Value = 0.16 },
						UseFrameFormatSettings = Input { Value = 1 },
						ExtendHorizontal1 = Input { Expression = "KinCtrl.KinPadX" },
						TransformRotation = Input { Value = 1 },
						ExtendVertical1 = Input { Expression = "KinCtrl.KinPadY" }
					}
				},
				Boxed = Merge {
					ViewInfo = OperatorInfo { Pos = { -55, 82.5 } },
					Inputs = {
						PerformDepthMerge = Input { Value = 0 },
						Foreground = Input {
							SourceOp = "Box",
							Source = "Output"
						},
						Blend = Input { Expression = "KinCtrl.KinBox * KinCtrl.Fade" },
						Background = Input {
							SourceOp = "KinCtrl",
							Source = "Output"
						}
					}
				},
				KinFinal = Merge {
					ViewInfo = OperatorInfo { Pos = { 55, 82.5 } },
					Inputs = {
						PerformDepthMerge = Input { Value = 0 },
						Foreground = Input {
							SourceOp = "Line",
							Source = "Output"
						},
						Blend = Input { Expression = "KinCtrl.Fade" },
						Background = Input {
							SourceOp = "Boxed",
							Source = "Output"
						}
					}
				}
			
			}
		}
	},
	ActiveTool = "KineticLines"
}

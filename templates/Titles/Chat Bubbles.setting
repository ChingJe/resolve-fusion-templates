							LINKID_DataType = "Point"
						}
					},
					CtrlWZoom = false,
					ViewInfo = OperatorInfo { Pos = { -495, -82.5 } },
					Inputs = {
						KO = Input { Expression = "(function(a, b) return Point(a, b - a) end)((function() local d = ChRule1.Output.DataWindow if not d or d.left < -99999 then return 0.03 end local w, h = ChRule1.Output.Width, ChRule1.Output.Height return 0.5 - d.bottom/h end)(), (function() local d = ChRule2.Output.DataWindow if not d or d.left < -99999 then return 0.06 end local w, h = ChRule2.Output.Width, ChRule2.Output.Height return 0.5 - d.bottom/h end)())" },
						KW = Input { Expression = "Point((function() local d = ChRule1.Output.DataWindow if not d or d.left < -99999 then return 0.02 end local w, h = ChRule1.Output.Width, ChRule1.Output.Height return 0.5 - d.left/w end)(), (function() local d = ChRule3.Output.DataWindow if not d or d.left < -99999 then return 0.1 end local w, h = ChRule3.Output.Width, ChRule3.Output.Height return (d.right - d.left)/w end)())" },
						M0 = Input { Expression = "Text((function(rows, idx, k)\n  local vis = {}\n  for i = 1, idx do\n    local r = rows[i]\n    if r and not (r.text == \"...\" and i < idx) then vis[#vis + 1] = r end\n  end\n  local r = vis[#vis - k]\n  return r and (r.side .. r.text) or \"\"\nend)((function(txt, timed, fps, len)\n  local rows = {}\n  for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n    local f, rest = 0, line\n    if timed ~= 0 then\n      local stamp, more = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      f, rest = nil, more\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n    end\n    if f and rest and rest:match(\"%S\") then\n      local side, words = rest:match(\"^%s*([<>])%s*(.-)%s*$\")\n      if not side then side, words = \"<\", rest:match(\"^%s*(.-)%s*$\") end\n      words = words:gsub(string.char(92) .. \"n\", string.char(10))\n      rows[#rows + 1] = {f = f, side = side, text = words}\n    end\n  end\n  return rows\nend)(ChList.Value, ChTimed, 24, 100), Cur.X, 0))" },
						Q0 = Input { Expression = "(function(m) local _, n = m:gsub('\\n', '') return Point(n + 1, iif(m:sub(1, 1) == '>', 1, 0)) end)(M0.Value)" },
						Y0 = Input { Expression = "0" },
						V0 = Input { Expression = "iif(M0.Value == '', 0, iif(0 < ChMax, 1, iif(0 == ChMax, (1 - KAnim)*(1 - KRepl), 0)))" },
						M1 = Input { Expression = "Text((function(rows, idx, k)\n  local vis = {}\n  for i = 1, idx do\n    local r = rows[i]\n    if r and not (r.text == \"...\" and i < idx) then vis[#vis + 1] = r end\n  end\n  local r = vis[#vis - k]\n  return r and (r.side .. r.text) or \"\"\nend)((function(txt, timed, fps, len)\n  local rows = {}\n  for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n    local f, rest = 0, line\n    if timed ~= 0 then\n      local stamp, more = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      f, rest = nil, more\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n    end\n    if f and rest and rest:match(\"%S\") then\n      local side, words = rest:match(\"^%s*([<>])%s*(.-)%s*$\")\n      if not side then side, words = \"<\", rest:match(\"^%s*(.-)%s*$\") end\n      words = words:gsub(string.char(92) .. \"n\", string.char(10))\n      rows[#rows + 1] = {f = f, side = side, text = words}\n    end\n  end\n  return rows\nend)(ChList.Value, ChTimed, 24, 100), Cur.X, 1))" },

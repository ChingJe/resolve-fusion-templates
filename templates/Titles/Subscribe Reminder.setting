				Input19 = InstanceInput { SourceOp = "SubCtrl", Source = "SubPreset", Name = "Colours" },
				Input20 = InstanceInput { SourceOp = "ColSubA", Source = "TopLeftRed", Name = "Custom Colour Of The Subscribe Button", ControlGroup = 3 },
				Input21 = InstanceInput { SourceOp = "ColSubA", Source = "TopLeftGreen", ControlGroup = 3 },
				Input22 = InstanceInput { SourceOp = "ColSubA", Source = "TopLeftBlue", ControlGroup = 3 },
				Input23 = InstanceInput { SourceOp = "ColSubInkA", Source = "TopLeftRed", Name = "Custom Colour Of Its Label", ControlGroup = 4 },

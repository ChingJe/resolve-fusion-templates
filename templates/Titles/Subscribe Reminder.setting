						},
						SubText = {
							INPS_DefaultText = "訂閱",
							TEC_Lines = 1,
							LINKID_DataType = "Text",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "TextEditControl",
							LINKS_Name = "Label"
						},
						Ta = {
							INP_Default = 0,
							INP_MinScale = -100000,
							INP_MaxScale = 100000,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Ta"
						},
						Tb = {
							INP_Default = 0,
							INP_MinScale = -100000,
							INP_MaxScale = 100000,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Tb"
						},
						Tc = {
							INP_Default = 0,
							INP_MinScale = -100000,
							INP_MaxScale = 100000,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Tc"
						},
						KH = {
							ICS_ControlPage = "Driver",
							INPID_InputControl = "OffsetControl",
							LINKS_Name = "KH",
							LINKID_DataType = "Point"
						},
						KWid = {
							ICS_ControlPage = "Driver",
							INPID_InputControl = "OffsetControl",
							LINKS_Name = "KWid",
							LINKID_DataType = "Point"
						},
						KWc = {
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 4,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "KWc"
						},
						KL = {
							ICS_ControlPage = "Driver",
							INPID_InputControl = "OffsetControl",
							LINKS_Name = "KL",
							LINKID_DataType = "Point"
						},
						KS = {
							ICS_ControlPage = "Driver",
							INPID_InputControl = "OffsetControl",
							LINKS_Name = "KS",
							LINKID_DataType = "Point"
						},
						KXa = {
							ICS_ControlPage = "Driver",
							INPID_InputControl = "OffsetControl",
							LINKS_Name = "KXa",
							LINKID_DataType = "Point"
						}
					},
					ViewInfo = OperatorInfo { Pos = { -495, -82.5 } },
					Inputs = {
						Height = Input { Value = 1080 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						KRing = Input { Expression = "(function(a, b, c)\n  local t, x = -1, 0\n  if a >= 0 then t, x = a, KXa.X end\n  if b >= 0 then t, x = b, KS.X + KS.Y/2 end\n  if c >= 0 then t, x = c, KXc.X end\n  if t < 0 or t > 14 or SubRing < 1 then return Point(x, 0) end\n  return Point(x, (t + 1)/15)\nend)(Ta, Tb, Tc)" },
						SubPos = Input { Value = { 0.5, 0.2 } },
						KXa = Input { Expression = "(function(s, h, w1, w2, wc, like, bell, done, first, pick)\n  local pad, a, gi, g = 0.68*s, 0.5*h, 0.32*s, 0.45*s\n  local wl = like > 0 and (pad + a + gi + wc + 0.5*s + 0.5*s + a + pad) or 0\n  local ws1 = w1 + 2.0*s\n  local ws2 = bell > 0 and (pad + a + gi + w2 + gi + 0.5*a + pad) or (w2 + 2.0*s)\n  local x0 = SubPos.X - (wl + (like > 0 and g or 0) + math.max(ws1, ws2))/2\n  local xs = x0 + wl + (like > 0 and g or 0)\n  if first > 0 then xs, x0 = x0, x0 + (done > 0 and ws2 or ws1) + g end\n  if pick == 1 then return Point(x0, wl) end\n  if pick == 2 then return Point(xs, done > 0 and ws2 or ws1) end\n  if pick == 3 then return Point(x0 + pad + a/2, x0 + pad + a + gi) end\n  if pick == 4 then return Point(x0 + pad + a + gi + wc + 0.5*s, x0 + pad + a + gi + wc + 1.0*s + a/2) end\n  if pick == 5 then return Point(xs + pad + a/2, xs + ws2 - pad - 0.25*a) end\n  if done > 0 and bell > 0 then return Point(xs + pad + a + gi, -1) end\n  return Point(xs + (done > 0 and ws2 or ws1)/2, 0)\nend)(SubSize, KH.X, KWid.X, KWid.Y, KWc, SubLike, SubBell, iif(Tb >= 0, 1, 0), SubFirst, 3)" },
						Scale = Input { Expression = "(function(t) t = t - 1 return max(1 + 2.70158*t*t*t + 1.70158*t*t, 0) end)(Show)" },
						KXd = Input { Expression = "(function(s, h, w1, w2, wc, like, bell, done, first, pick)\n  local pad, a, gi, g = 0.68*s, 0.5*h, 0.32*s, 0.45*s\n  local wl = like > 0 and (pad + a + gi + wc + 0.5*s + 0.5*s + a + pad) or 0\n  local ws1 = w1 + 2.0*s\n  local ws2 = bell > 0 and (pad + a + gi + w2 + gi + 0.5*a + pad) or (w2 + 2.0*s)\n  local x0 = SubPos.X - (wl + (like > 0 and g or 0) + math.max(ws1, ws2))/2\n  local xs = x0 + wl + (like > 0 and g or 0)\n  if first > 0 then xs, x0 = x0, x0 + (done > 0 and ws2 or ws1) + g end\n  if pick == 1 then return Point(x0, wl) end\n  if pick == 2 then return Point(xs, done > 0 and ws2 or ws1) end\n  if pick == 3 then return Point(x0 + pad + a/2, x0 + pad + a + gi) end\n  if pick == 4 then return Point(x0 + pad + a + gi + wc + 0.5*s, x0 + pad + a + gi + wc + 1.0*s + a/2) end\n  if pick == 5 then return Point(xs + pad + a/2, xs + ws2 - pad - 0.25*a) end\n  if done > 0 and bell > 0 then return Point(xs + pad + a + gi, -1) end\n  return Point(xs + (done > 0 and ws2 or ws1)/2, 0)\nend)(SubSize, KH.X, KWid.X, KWid.Y, KWc, SubLike, SubBell, iif(Tb >= 0, 1, 0), SubFirst, 6)" },
						Width = Input { Value = 1920 },
						KXc = Input { Expression = "(function(s, h, w1, w2, wc, like, bell, done, first, pick)\n  local pad, a, gi, g = 0.68*s, 0.5*h, 0.32*s, 0.45*s\n  local wl = like > 0 and (pad + a + gi + wc + 0.5*s + 0.5*s + a + pad) or 0\n  local ws1 = w1 + 2.0*s\n  local ws2 = bell > 0 and (pad + a + gi + w2 + gi + 0.5*a + pad) or (w2 + 2.0*s)\n  local x0 = SubPos.X - (wl + (like > 0 and g or 0) + math.max(ws1, ws2))/2\n  local xs = x0 + wl + (like > 0 and g or 0)\n  if first > 0 then xs, x0 = x0, x0 + (done > 0 and ws2 or ws1) + g end\n  if pick == 1 then return Point(x0, wl) end\n  if pick == 2 then return Point(xs, done > 0 and ws2 or ws1) end\n  if pick == 3 then return Point(x0 + pad + a/2, x0 + pad + a + gi) end\n  if pick == 4 then return Point(x0 + pad + a + gi + wc + 0.5*s, x0 + pad + a + gi + wc + 1.0*s + a/2) end\n  if pick == 5 then return Point(xs + pad + a/2, xs + ws2 - pad - 0.25*a) end\n  if done > 0 and bell > 0 then return Point(xs + pad + a + gi, -1) end\n  return Point(xs + (done > 0 and ws2 or ws1)/2, 0)\nend)(SubSize, KH.X, KWid.X, KWid.Y, KWc, SubLike, SubBell, iif(Tb >= 0, 1, 0), SubFirst, 5)" },
						KXb = Input { Expression = "(function(s, h, w1, w2, wc, like, bell, done, first, pick)\n  local pad, a, gi, g = 0.68*s, 0.5*h, 0.32*s, 0.45*s\n  local wl = like > 0 and (pad + a + gi + wc + 0.5*s + 0.5*s + a + pad) or 0\n  local ws1 = w1 + 2.0*s\n  local ws2 = bell > 0 and (pad + a + gi + w2 + gi + 0.5*a + pad) or (w2 + 2.0*s)\n  local x0 = SubPos.X - (wl + (like > 0 and g or 0) + math.max(ws1, ws2))/2\n  local xs = x0 + wl + (like > 0 and g or 0)\n  if first > 0 then xs, x0 = x0, x0 + (done > 0 and ws2 or ws1) + g end\n  if pick == 1 then return Point(x0, wl) end\n  if pick == 2 then return Point(xs, done > 0 and ws2 or ws1) end\n  if pick == 3 then return Point(x0 + pad + a/2, x0 + pad + a + gi) end\n  if pick == 4 then return Point(x0 + pad + a + gi + wc + 0.5*s, x0 + pad + a + gi + wc + 1.0*s + a/2) end\n  if pick == 5 then return Point(xs + pad + a/2, xs + ws2 - pad - 0.25*a) end\n  if done > 0 and bell > 0 then return Point(xs + pad + a + gi, -1) end\n  return Point(xs + (done > 0 and ws2 or ws1)/2, 0)\nend)(SubSize, KH.X, KWid.X, KWid.Y, KWc, SubLike, SubBell, iif(Tb >= 0, 1, 0), SubFirst, 4)" },
						TopLeftAlpha = Input { Value = 0 },
						Show = Input { Expression = "min(min(max((time - comp.RenderStart + 1)/max(SubIn, 1), 0), 1), iif(SubOut > 0, min(max((comp.RenderEnd - time + 1)/SubOut, 0), 1), 1))" },
						KH = Input { Expression = "Point((function() local d = SubRule3.Output.DataWindow if not d or d.left < -99999 or SubRule3.StyledText.Value == '' then return 0.03 end local w, h = SubRule3.Output.Width, SubRule3.Output.Height return (d.top - d.bottom)/w end)() + 1.0*SubSize, (function() local d = SubRule3.Output.DataWindow if not d or d.left < -99999 or SubRule3.StyledText.Value == '' then return 0 end local w, h = SubRule3.Output.Width, SubRule3.Output.Height return (d.top + d.bottom)/2/h - 0.5 end)())" },
						Ta = Input { Expression = "iif(SubLike > 0, time - comp.RenderStart - SubLikeAt*(comp.RenderEnd - comp.RenderStart), -1)" },
						Tb = Input { Expression = "time - comp.RenderStart - SubPress*(comp.RenderEnd - comp.RenderStart)" },
						Tc = Input { Expression = "iif(SubBell > 0 and Tb >= 0, time - comp.RenderStart - SubBellAt*(comp.RenderEnd - comp.RenderStart), -1)" },
						UseFrameFormatSettings = Input { Value = 1 },
						KWid = Input { Expression = "Point((function() local d = SubRule1.Output.DataWindow if not d or d.left < -99999 or SubRule1.StyledText.Value == '' then return 0 end local w, h = SubRule1.Output.Width, SubRule1.Output.Height return (d.right - d.left)/w end)(), (function() local d = SubRule2.Output.DataWindow if not d or d.left < -99999 or SubRule2.StyledText.Value == '' then return 0 end local w, h = SubRule2.Output.Width, SubRule2.Output.Height return (d.right - d.left)/w end)())" },
						KWc = Input { Expression = "max((function() local d = SubRule4.Output.DataWindow if not d or d.left < -99999 or SubRule4.StyledText.Value == '' then return 0 end local w, h = SubRule4.Output.Width, SubRule4.Output.Height return (d.right - d.left)/w end)(), (function() local d = SubRule5.Output.DataWindow if not d or d.left < -99999 or SubRule5.StyledText.Value == '' then return 0 end local w, h = SubRule5.Output.Width, SubRule5.Output.Height return (d.right - d.left)/w end)())" },
						KL = Input { Expression = "(function(s, h, w1, w2, wc, like, bell, done, first, pick)\n  local pad, a, gi, g = 0.68*s, 0.5*h, 0.32*s, 0.45*s\n  local wl = like > 0 and (pad + a + gi + wc + 0.5*s + 0.5*s + a + pad) or 0\n  local ws1 = w1 + 2.0*s\n  local ws2 = bell > 0 and (pad + a + gi + w2 + gi + 0.5*a + pad) or (w2 + 2.0*s)\n  local x0 = SubPos.X - (wl + (like > 0 and g or 0) + math.max(ws1, ws2))/2\n  local xs = x0 + wl + (like > 0 and g or 0)\n  if first > 0 then xs, x0 = x0, x0 + (done > 0 and ws2 or ws1) + g end\n  if pick == 1 then return Point(x0, wl) end\n  if pick == 2 then return Point(xs, done > 0 and ws2 or ws1) end\n  if pick == 3 then return Point(x0 + pad + a/2, x0 + pad + a + gi) end\n  if pick == 4 then return Point(x0 + pad + a + gi + wc + 0.5*s, x0 + pad + a + gi + wc + 1.0*s + a/2) end\n  if pick == 5 then return Point(xs + pad + a/2, xs + ws2 - pad - 0.25*a) end\n  if done > 0 and bell > 0 then return Point(xs + pad + a + gi, -1) end\n  return Point(xs + (done > 0 and ws2 or ws1)/2, 0)\nend)(SubSize, KH.X, KWid.X, KWid.Y, KWc, SubLike, SubBell, iif(Tb >= 0, 1, 0), SubFirst, 1)" },

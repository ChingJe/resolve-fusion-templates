						GlobalIn = Input { Value = -480 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						N = Input { Expression = "#((function(txt, sort)\n  local out = {}\n  for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n    local name, v = line:match(\"^%s*(.-)%s*(-?[%d%.]+)%s*$\")\n    if v and tonumber(v) and #out < 8 then out[#out + 1] = {name, math.max(tonumber(v), 0)} end\n  end\n  if sort == 1 then table.sort(out, function(a, b) return a[2] > b[2] end) end\n  return out\nend)(BarsCtrl.BcList.Value, BarsCtrl.BcSort))" },
						Top = Input { Expression = "(function(c)\n  local best, at = -1, -1\n  for i = 1, #c do if c[i][2] > best then best, at = c[i][2], i end end\n  return at\nend)((function(txt, sort)\n  local out = {}\n  for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n    local name, v = line:match(\"^%s*(.-)%s*(-?[%d%.]+)%s*$\")\n    if v and tonumber(v) and #out < 8 then out[#out + 1] = {name, math.max(tonumber(v), 0)} end\n  end\n  if sort == 1 then table.sort(out, function(a, b) return a[2] > b[2] end) end\n  return out\nend)(BarsCtrl.BcList.Value, BarsCtrl.BcSort))" },

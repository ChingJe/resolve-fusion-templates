			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				BarsCtrl = Background {
					ViewInfo = OperatorInfo { Pos = { -495, -82.5 } },
					Inputs = {
						P = Input { Expression = "min(max((time - comp.RenderStart) / max(comp.RenderEnd - comp.RenderStart, 1), 0), 1)" },
						B2 = Input { Expression = "(function(c, p, grow, done, bounce, hand, shown)\n  if not c[2] then return Point(0, 0) end\n  local big = 0\n  for i = 1, #c do big = math.max(big, c[i][2]) end\n  local gap = math.max(done - grow, 0) / math.max(#c - 1, 1)\n  local t = math.min(math.max((p - 1*gap) / grow, 0), 1) - 1\n  if hand == 1 then t = math.min(math.max(shown - 1, 0), 1) - 1 end\n  local s = 1.70158 * bounce\n  local g = 1 + (s + 1)*t*t*t + s*t*t\n  return Point(big > 0 and c[2][2]/big*g or 0, g)\nend)((function(txt, sort)\n  local out = {}\n  for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n    local name, v = line:match(\"^%s*(.-)%s*(-?[%d%.]+)%s*$\")\n    if v and tonumber(v) and #out < 8 then out[#out + 1] = {name, math.max(tonumber(v), 0)} end\n  end\n  if sort == 1 then table.sort(out, function(a, b) return a[2] > b[2] end) end\n  return out\nend)(BarsCtrl.BcList.Value, BarsCtrl.BcSort), P, BcGrow, BcDone, BcBounce, BcHand, BcShown)" },

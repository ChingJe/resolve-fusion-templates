						},
						CpDel = {
							LINKS_Name = "Deleted Characters Per Second",
							INP_Default = 40,
							INP_MinScale = 1,
							INP_MaxScale = 120,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",

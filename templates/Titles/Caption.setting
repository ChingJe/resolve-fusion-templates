							INP_Integer = false
						}
					},
					CtrlWZoom = false,
					ViewInfo = OperatorInfo { Pos = { -495, -82.5 } },
					Inputs = {
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						UseFrameFormatSettings = Input { Value = 1 },
						Curs = Input { Expression = "Point(CpCtrl.LineX + CpCtrl.Wid + CpCtrl.Rule.X - 0.05 + CpCtrl.LkSize*0.03, iif(CpCtrl.CpCursor == 0, CpCtrl.LkSize*0.07, iif(CpCtrl.CpCursor == 3, 0, CpCtrl.LkSize*0.5)))" },
						Idx = Input { Expression = "(function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(CpCtrl:GetValue(\"CpCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(CpCtrl:GetValue(\"CpCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(CpCtrl.CpList.Value, CpCtrl.CpTimed, CpCtrl.CpCue, iif(CpCtrl.FpsOverride > 0, CpCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 1)" },
						Wid = Input { Expression = "max((function() local d = CpMeasure.Output.DataWindow if not d then return 0 end local w, h = CpMeasure.Output.Width, CpMeasure.Output.Height return d.right/w end)() - CpCtrl.Rule.Y, 0)" },
						Since = Input { Expression = "(function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(CpCtrl:GetValue(\"CpCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(CpCtrl:GetValue(\"CpCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(CpCtrl.CpList.Value, CpCtrl.CpTimed, CpCtrl.CpCue, iif(CpCtrl.FpsOverride > 0, CpCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 2)" },
						Until = Input { Expression = "min((function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(CpCtrl:GetValue(\"CpCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(CpCtrl:GetValue(\"CpCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(CpCtrl.CpList.Value, CpCtrl.CpTimed, CpCtrl.CpCue, iif(CpCtrl.FpsOverride > 0, CpCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 3), comp.RenderEnd - time + 1)" },
						Cur = Input { Expression = "Text((function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(CpCtrl:GetValue(\"CpCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(CpCtrl:GetValue(\"CpCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(CpCtrl.CpList.Value, CpCtrl.CpTimed, CpCtrl.CpCue, iif(CpCtrl.FpsOverride > 0, CpCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 4))" },
						Total = Input { Expression = "(function(s) local n = 0 for ch in s:gmatch(\"[^\" .. string.char(128) .. \"-\" .. string.char(191) .. \"][\" .. string.char(128) .. \"-\" .. string.char(191) .. \"]*\") do n = n + 1 end return n end)(CpCtrl.Cur.Value)" },
						Prog = Input { Expression = "(function(since, untl, n, speed, done, fps)\n  if n < 1 then return 0 end\n  local frames = (speed > 0) and n/speed*fps or done*(since + untl)\n  return math.min(math.max((since + 1)/math.max(frames, 1), 0), 1)\nend)(CpCtrl.Since, CpCtrl.Until, CpCtrl.Total, CpCtrl.CpSpeed, CpCtrl.CpEnd, iif(CpCtrl.FpsOverride > 0, CpCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24))" },
						Count = Input { Expression = "(function(mode, untl, n, prog, fps, exit, del)\n  if n < 1 then return Point(0, 0) end\n  if mode == 0 then return Point(n, 0) end\n  local c, busy = math.floor(n*prog + 0.0001), 0\n  if prog < 1 then busy = 1 end\n  if mode == 1 and exit == 1 then\n    local left = math.floor(math.max(untl - 1, 0)*del/fps)\n    if left <= n then busy = 1 end\n    c = math.min(c, left)\n  end\n  return Point(c, busy)\nend)(CpCtrl.CpMode, CpCtrl.Until, CpCtrl.Total, CpCtrl.Prog, iif(CpCtrl.FpsOverride > 0, CpCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), CpCtrl.CpExit, CpCtrl.CpDel)" },
						Typed = Input { Expression = "Text((function(s, n) local out, k = {}, 0 for ch in s:gmatch(\"[^\" .. string.char(128) .. \"-\" .. string.char(191) .. \"][\" .. string.char(128) .. \"-\" .. string.char(191) .. \"]*\") do if k >= n then break end k = k + 1 out[k] = ch end return table.concat(out) end)(CpCtrl.Cur.Value, CpCtrl.Count.X))" },
						Rule = Input { Expression = "(function() local d = CpRuler.Output.DataWindow if not d then return Point(0, 0) end local w, h = CpRuler.Output.Width, CpRuler.Output.Height return Point(d.left/w, d.right/w) end)()" },
						RuleY = Input { Expression = "(function() local d = CpRuler.Output.DataWindow if not d then return Point(0, 0) end local w, h = CpRuler.Output.Width, CpRuler.Output.Height return Point(d.bottom/h, d.top/h) end)()" },
						GlobalIn = Input { Value = -480 },
						FullW = Input { Expression = "max((function() local d = CpFull.Output.DataWindow if not d then return 0 end local w, h = CpFull.Output.Width, CpFull.Output.Height return d.right/w end)() - CpCtrl.Rule.Y, 0)" },
						LineX = Input { Expression = "iif(CpCtrl.CpAlign == 0, CpCtrl.CpPos.X, CpCtrl.CpPos.X - iif(CpCtrl.CpAlign == 2 and CpCtrl.CpMode == 1, CpCtrl.Wid, CpCtrl.FullW)/2)" },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Show = Input { Expression = "iif(CpCtrl.CpMode ~= 1 or CpCtrl.CpCursor == 3 or CpCtrl.Idx < 1, 0, iif(CpCtrl.Count.Y > 0 or CpCtrl.CpBlink <= 0, 1, iif((CpCtrl.Since/iif(CpCtrl.FpsOverride > 0, CpCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24)*CpCtrl.CpBlink) % 1 < 0.5, 1, 0)))" },
						Fade = Input { Expression = "iif(CpCtrl.Idx < 1, 0, iif(CpCtrl.CpMode == 1, 1, min((CpCtrl.Since + 1)/max(CpCtrl.CpIn, 1)*2, 1)) * iif(CpCtrl.CpOut <= 0, 1, min(max(CpCtrl.Until/CpCtrl.CpOut, 0), 1)))" },
						Pop = Input { Expression = "iif(CpCtrl.CpMode == 1, 1, 1 + 0.25*max(1 - (CpCtrl.Since + 1)/max(CpCtrl.CpIn, 1), 0)^2)" },

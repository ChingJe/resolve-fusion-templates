							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Outline",
							INP_Default = 0.005,
							INP_MinScale = 0
						},
						Idx = {
							INP_MaxScale = 100,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Idx",
							INP_Default = 0,

						},
						KaOuter = {
							INP_MaxScale = 0.03,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Outer Outline",
							INP_Default = 0,
							INP_MinScale = 0
						}
					}
				},
				KaText = TextPlus {
					Inputs = {
						GlobalIn = Input { Value = -480 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Wrap = Input { Value = 1 },
						LayoutRotation = Input { Value = 1 },
						TransformRotation = Input { Value = 1 },
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						HorizontalJustificationNew = Input { Value = 3 },
						UseFrameFormatSettings = Input { Value = 1 },
						Font = Input { Value = "Microsoft JhengHei" },
						VerticalJustificationNew = Input { Value = 3 },
						Style = Input { Value = "Bold" },
						Softness1 = Input { Value = 1 },
						StyledText = Input { Expression = "Text(KaCtrl.Cur.Value)" },
						Size = Input {
							Value = 0.07,
							Expression = "KaCtrl.KaSize * (1 + 0.25*max(1 - (KaCtrl.Since + 1)/max(KaCtrl.KaIn, 1), 0)^2)"
						},
						Center = Input {
							Value = { 0.5, 0.14 },
							Expression = "KaCtrl.KaPos"
						}
					},
					Version = 1,
					ViewInfo = OperatorInfo { Pos = { -275, 16.5 } }
				},
				KaFilledGrowB = ErodeDilate {
					Inputs = {
						XAmount = Input {
							Value = 0.005,
							Expression = "(KaCtrl.KaEdge) + (KaCtrl.KaOuter)"
						},
						Input = Input {
							Source = "Output",
							SourceOp = "KaText"
						},
						Filter = Input { Value = 3 }
					},
					ViewInfo = OperatorInfo { Pos = { 55, 214.5 } }
				},
				KaFilledGrowA = ErodeDilate {
					Inputs = {
						XAmount = Input {
							Value = 0.005,
							Expression = "KaCtrl.KaEdge"
						},
						Input = Input {
							Source = "Output",
							SourceOp = "KaText"
						},
						Filter = Input { Value = 3 }
					},

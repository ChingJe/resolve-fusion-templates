{
	Tools = ordered() {
		KaraokeCaption = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "KaCtrl", Source = "KaList", Name = "Lines (0:00 Text)" },
				Input2 = InstanceInput { SourceOp = "KaCtrl", Source = "KaTimed", Name = "Lines Start With A Time (0:02 Text)" },
				Input3 = InstanceInput { SourceOp = "KaCtrl", Source = "KaCue", Name = "Line Number (keyframe 1, 2, 3)" },
				Input4 = InstanceInput { SourceOp = "KaCtrl", Source = "FpsOverride", Name = "Frame Rate Override" },
				Input5 = InstanceInput { SourceOp = "KaCtrl", Source = "KaSpeed", Name = "Characters Per Second (0 = fit the line's time)" },
				Input6 = InstanceInput { SourceOp = "KaCtrl", Source = "KaEnd", Name = "Fill Is Done At" },
				Input7 = InstanceInput { SourceOp = "KaCtrl", Source = "KaStep", Name = "Fill One Character At A Time" },
				Input8 = InstanceInput { SourceOp = "KaText", Source = "Font", Name = "Font", ControlGroup = 2 },
				Input9 = InstanceInput { SourceOp = "KaText", Source = "Style", ControlGroup = 2 },
				Input10 = InstanceInput { SourceOp = "KaCtrl", Source = "KaSize", Name = "Size" },
				Input11 = InstanceInput { SourceOp = "KaCtrl", Source = "KaPos", Name = "Position" },
				Input12 = InstanceInput { SourceOp = "KaCtrl", Source = "KaEdge", Name = "Outline" },
				Input13 = InstanceInput { SourceOp = "KaCtrl", Source = "KaOuter", Name = "Outer Outline" },
				Input14 = InstanceInput { SourceOp = "KaCtrl", Source = "KaIn", Name = "Pop Frames" },
				Input15 = InstanceInput { SourceOp = "KaCtrl", Source = "KaOut", Name = "Fade Out Frames" },
				Input16 = InstanceInput { SourceOp = "ColKa", Source = "TopLeftRed", Name = "Colour", ControlGroup = 3 },
				Input17 = InstanceInput { SourceOp = "ColKa", Source = "TopLeftGreen", ControlGroup = 3 },
				Input18 = InstanceInput { SourceOp = "ColKa", Source = "TopLeftBlue", ControlGroup = 3 },
				Input19 = InstanceInput { SourceOp = "ColKaFill", Source = "TopLeftRed", Name = "Fill Colour", ControlGroup = 4 },
				Input20 = InstanceInput { SourceOp = "ColKaFill", Source = "TopLeftGreen", ControlGroup = 4 },
				Input21 = InstanceInput { SourceOp = "ColKaFill", Source = "TopLeftBlue", ControlGroup = 4 },
				Input22 = InstanceInput { SourceOp = "ColKaEdge", Source = "TopLeftRed", Name = "Outline Colour", ControlGroup = 5 },
				Input23 = InstanceInput { SourceOp = "ColKaEdge", Source = "TopLeftGreen", ControlGroup = 5 },
				Input24 = InstanceInput { SourceOp = "ColKaEdge", Source = "TopLeftBlue", ControlGroup = 5 },
				Input25 = InstanceInput { SourceOp = "ColKaFillEdge", Source = "TopLeftRed", Name = "Outline Colour Of The Filled Part", ControlGroup = 6 },
				Input26 = InstanceInput { SourceOp = "ColKaFillEdge", Source = "TopLeftGreen", ControlGroup = 6 },
				Input27 = InstanceInput { SourceOp = "ColKaFillEdge", Source = "TopLeftBlue", ControlGroup = 6 },
				Input28 = InstanceInput { SourceOp = "ColKaOuter", Source = "TopLeftRed", Name = "Outer Outline Colour", ControlGroup = 7 },
				Input29 = InstanceInput { SourceOp = "ColKaOuter", Source = "TopLeftGreen", ControlGroup = 7 },
				Input30 = InstanceInput { SourceOp = "ColKaOuter", Source = "TopLeftBlue", ControlGroup = 7 },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "KaFinal", Source = "Output" }
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				KaCtrl = Background {
					CtrlWZoom = false,
					Inputs = {
						Idx = Input {
							Value = 3,
							Expression = "(function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(KaCtrl:GetValue(\"KaCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(KaCtrl:GetValue(\"KaCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(KaCtrl.KaList.Value, KaCtrl.KaTimed, KaCtrl.KaCue, iif(KaCtrl.FpsOverride > 0, KaCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 1)"
						},
						KaPos = Input { Value = { 0.5, 0.14 } },
						GlobalOut = Input { Value = 3534 },
						Width = Input { Value = 1920 },
						TopLeftAlpha = Input { Value = 0 },
						GlobalIn = Input { Value = -480 },
						Until = Input {
							Value = 36,
							Expression = "min((function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(KaCtrl:GetValue(\"KaCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(KaCtrl:GetValue(\"KaCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(KaCtrl.KaList.Value, KaCtrl.KaTimed, KaCtrl.KaCue, iif(KaCtrl.FpsOverride > 0, KaCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 3), comp.RenderEnd - time + 1)"
						},
						Since = Input {
							Value = 47,
							Expression = "(function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(KaCtrl:GetValue(\"KaCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(KaCtrl:GetValue(\"KaCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(KaCtrl.KaList.Value, KaCtrl.KaTimed, KaCtrl.KaCue, iif(KaCtrl.FpsOverride > 0, KaCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 2)"
						},
						UseFrameFormatSettings = Input { Value = 1 },
						Cur = Input {
							Value = "in time with the voice",
							Expression = "Text((function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(KaCtrl:GetValue(\"KaCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(KaCtrl:GetValue(\"KaCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(KaCtrl.KaList.Value, KaCtrl.KaTimed, KaCtrl.KaCue, iif(KaCtrl.FpsOverride > 0, KaCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 4))"
						},
						Chars = Input {
							Value = 18,
							Expression = "(function(s) s = s:gsub(\"%s\", \"\") local _, n = s:gsub(\"[^\\128-\\191]\", \"\") return n end)(Cur.Value)"
						},
						Fill = Input {
							Value = 0.680368532955351,
							Expression = "(function(since, untl, n, speed, done, step, fps)\n  if n < 1 then return 0 end\n  local frames = (speed > 0) and n/speed*fps or done*(since + untl)\n  local f = math.min(math.max((since + 1)/math.max(frames, 1), 0), 1)\n  if step == 1 then f = math.floor(f*n + 0.0001)/n end\n  return f\nend)(Since, Until, Chars, KaSpeed, KaEnd, KaStep, iif(FpsOverride > 0, FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24))"
						},
						Fade = Input {
							Value = 1,
							Expression = "iif(Idx < 1, 0, min((Since + 1)/max(KaIn, 1)*2, 1) * iif(KaOut <= 0, 1, min(max(Until/KaOut, 0), 1)))"
						},
						Box = Input {
							Value = { 0.285416666666667, 0.430208333333333 },
							Expression = "(function()\n  if KaText.StyledText.Value == \"\" then return Point(0.5, 0) end\n  local d = KaText.Output.DataWindow\n  if not d then return Point(0.5, 0) end\n  return Point(d.left / KaText.Output.Width, math.max(d.right - d.left, 0) / KaText.Output.Width)\nend)()"
						},
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Height = Input { Value = 1080 }
					},
					ViewInfo = OperatorInfo { Pos = { -495, -82.5 } },
					UserControls = {
						KaIn = {
							INP_MaxScale = 40,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,

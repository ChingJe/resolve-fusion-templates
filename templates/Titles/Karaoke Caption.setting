							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Characters Per Second (0 = fit the line's time)",
							INP_Default = 0,
							INP_MinScale = 0
						},
						KaEnd = {
							INP_MaxScale = 1,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Fill Is Done At",
							INP_Default = 0.85,
							INP_MinScale = 0.1
						},
						KaStep = {
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "CheckboxControl",
							LINKS_Name = "Fill One Character At A Time",
							INP_Default = 0,
							INP_Integer = true
						},
						KaSize = {
							INP_MaxScale = 0.3,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Size",
							INP_Default = 0.07,
							INP_MinScale = 0.02
						},
						KaPos = {
							LINKID_DataType = "Point",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "OffsetControl",
							LINKS_Name = "Position",

				},
				KaFilled = Custom {
					Inputs = {
						NumberIn5 = Input {
							Value = 0.08,
							Expression = "ColKaFillEdge.TopLeftGreen"
						},
						NumberIn6 = Input {
							Value = 0.05,
							Expression = "ColKaFillEdge.TopLeftBlue"
						},
						Image1 = Input {
							Source = "Output",
							SourceOp = "KaText"
						},
						Image2 = Input {
							Source = "Output",
							SourceOp = "KaFilledGrowA"
						},
						Image3 = Input {
							Source = "Output",
							SourceOp = "KaFilledGrowB"
						},
						PointIn1 = Input {
							Value = { 1, 1 },
							Expression = "Point(ColKaOuter.TopLeftRed, ColKaOuter.TopLeftGreen)"
						},
						AlphaExpression = Input { Value = "a1 + (1 - a1)*(i1 + (1 - i1)*i2)" },
						PointIn2 = Input {
							Value = { 1, 0 },

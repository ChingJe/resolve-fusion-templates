						Fade = Input { Expression = "iif(BdgEnter == 0, min(T*4, 1), T) * iif(BdgOut <= 0, 1, min(max((comp.RenderEnd - time + 1)/(BdgOut*iif(FpsOverride > 0, FpsOverride, comp:GetPrefs('Comp.FrameFormat.Rate') or 24)), 0), 1))" },
						Late = Input { Expression = "min(max(T*2.5 - 1.5, 0), 1)" },
						Scale = Input { Expression = "iif(BdgEnter == 0, (function(t) t = t - 1 return 1 + 2.70158*t*t*t + 1.70158*t*t end)(T), 1)" },

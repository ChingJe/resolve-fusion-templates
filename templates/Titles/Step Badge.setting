						UseFrameFormatSettings = Input { Value = 1 },
						Width = Input { Value = 1920 },
						StyledText = Input { Expression = "Text(BdgCtrl.BdgLabel.Value)" },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Red1 = Input { Expression = "ColBdgLabel.TopLeftRed" },
						Green1 = Input { Expression = "ColBdgLabel.TopLeftGreen" },
						Blue1 = Input { Expression = "ColBdgLabel.TopLeftBlue" },
						Size = Input { Expression = "BdgCtrl.BdgLabelSize" },
						HorizontalLeftCenterRight = Input { Expression = "iif(BdgCtrl.BdgSide == 0, -1, 1)" },
						GlobalIn = Input { Value = -480 },
						Center = Input { Expression = "Point(BdgCtrl.BdgPos.X + iif(BdgCtrl.BdgSide == 0, 1, -1)*(BdgCtrl.BdgSize/2 + BdgCtrl.BdgBorder + BdgCtrl.BdgGap)*(comp:GetPrefs('Comp.FrameFormat.Height')/comp:GetPrefs('Comp.FrameFormat.Width')), BdgCtrl.BdgPos.Y)" },
						Style = Input { Value = "Bold" },
						Wrap = Input { Value = 1 },
						LayoutRotation = Input { Value = 1 },
						TransformRotation = Input { Value = 1 },
						Softness1 = Input { Value = 1 },
						VerticalJustificationNew = Input { Value = 3 },
						HorizontalJustificationNew = Input { Value = 3 },
						GlobalOut = Input { Value = 3534 },
						Height = Input { Value = 1080 }
					}
				},
				BdgTag = Custom {
					ViewInfo = OperatorInfo { Pos = { -165, 181.5 } },
					Inputs = {
						Intermediate3 = Input { Value = "a2*i2" },
						RedExpression = Input { Value = "r2*i2 + p2x*p3y*i2*(1 - i3)" },
						GreenExpression = Input { Value = "g2*i2 + p2y*p3y*i2*(1 - i3)" },
						BlueExpression = Input { Value = "b2*i2 + p3x*p3y*i2*(1 - i3)" },
						AlphaExpression = Input { Value = "i3 + p3y*i2*(1 - i3)" },
						LUTIn1 = Input {
							SourceOp = "CustomTool1LUTIn12",
							Source = "Value"
						},
						LUTIn2 = Input {
							SourceOp = "CustomTool1LUTIn22",
							Source = "Value"
						},
						LUTIn3 = Input {
							SourceOp = "CustomTool1LUTIn32",
							Source = "Value"
						},
						LUTIn4 = Input {
							SourceOp = "CustomTool1LUTIn42",
							Source = "Value"
						},
						Image1 = Input {
							SourceOp = "BdgCtrl",
							Source = "Output"
						},
						PointIn1 = Input { Expression = "BdgCtrl.BdgPos" },
						Image2 = Input {
							SourceOp = "BdgLabelText",
							Source = "Output"
						},
						PointIn2 = Input { Expression = "Point(ColBdgTag.TopLeftRed, ColBdgTag.TopLeftGreen)" },
						PointIn3 = Input { Expression = "Point(ColBdgTag.TopLeftBlue, BdgCtrl.BdgTagOp)" },
						NumberIn2 = Input { Expression = "(function(late)\n  local d = BdgLabelText.StyledText.Value ~= \"\" and BdgLabelText.Output.DataWindow\n  if not d then return 0 end\n  local wide = (d.right - d.left)/BdgLabelText.Output.Width/(comp:GetPrefs('Comp.FrameFormat.Height')/comp:GetPrefs('Comp.FrameFormat.Width'))\n  return late*(BdgCtrl.BdgSize/2 + BdgCtrl.BdgBorder + BdgCtrl.BdgGap + wide - BdgCtrl.BdgSize/2*BdgCtrl.BdgTagH*0.35)\nend)(BdgCtrl.Late)" },
						NumberIn1 = Input { Expression = "BdgCtrl.BdgSize/2*BdgCtrl.BdgTagH" },
						Intermediate1 = Input { Value = "(x - p1x)*w/h*n3" },
						NumberIn3 = Input { Expression = "iif(BdgCtrl.BdgSide == 0, 1, -1)" },
						Intermediate2 = Input { Value = "if(n2 <= 0, 0, min(max((n1 - sqrt((i1 - min(max(i1, 0), n2))^2 + (y - p1y)^2))*h + 0.5, 0), 1))" }
					}
				},
				CustomTool1LUTIn12 = LUTBezier {
					CtrlWZoom = false,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					},
					SplineColor = { Red = 0, Blue = 0, Green = 0 },
					NameSet = true
				},
				CustomTool1LUTIn22 = LUTBezier {
					CtrlWZoom = false,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					},
					SplineColor = { Red = 0, Blue = 0, Green = 0 },
					NameSet = true
				},
				CustomTool1LUTIn32 = LUTBezier {
					CtrlWZoom = false,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					},
					SplineColor = { Red = 0, Blue = 0, Green = 0 },
					NameSet = true
				},
				CustomTool1LUTIn42 = LUTBezier {
					CtrlWZoom = false,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					},
					SplineColor = { Red = 0, Blue = 0, Green = 0 },
					NameSet = true
				},
				BdgOverTag = Merge {
					ViewInfo = OperatorInfo { Pos = { 55, 16.5 } },
					Inputs = {
						PerformDepthMerge = Input { Value = 0 },
						Background = Input {
							SourceOp = "BdgTag",
							Source = "Output"

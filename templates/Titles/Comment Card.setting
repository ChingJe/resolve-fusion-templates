				CcNameT = TextPlus {
					Version = 1,
					ViewInfo = OperatorInfo { Pos = { -275, 16.5 } },
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1 },
						HorizontalLeftCenterRight = Input { Value = -1 },
						Font = Input {
							Value = "Open Sans",
							Expression = "CcBodyT.Font"
						},
						Width = Input { Value = 1920 },
						Style = Input { Value = "Bold" },
						Height = Input { Value = 1080 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						StyledText = Input { Expression = "Text(CcCtrl.CcName.Value)" },
						Red1 = Input { Expression = "iif(CcCtrl.CcPreset == 0, ColCcText.TopLeftRed, ({{1,1,1,0.08,0.08,0.1,0.45,0.47,0.5,0.93,0.2,0.3},{0.13,0.14,0.17,0.95,0.95,0.96,0.6,0.62,0.66,1,0.35,0.45}})[max(CcCtrl.CcPreset, 1)][4])" },
						Green1 = Input { Expression = "iif(CcCtrl.CcPreset == 0, ColCcText.TopLeftGreen, ({{1,1,1,0.08,0.08,0.1,0.45,0.47,0.5,0.93,0.2,0.3},{0.13,0.14,0.17,0.95,0.95,0.96,0.6,0.62,0.66,1,0.35,0.45}})[max(CcCtrl.CcPreset, 1)][5])" },
						Blue1 = Input { Expression = "iif(CcCtrl.CcPreset == 0, ColCcText.TopLeftBlue, ({{1,1,1,0.08,0.08,0.1,0.45,0.47,0.5,0.93,0.2,0.3},{0.13,0.14,0.17,0.95,0.95,0.96,0.6,0.62,0.66,1,0.35,0.45}})[max(CcCtrl.CcPreset, 1)][6])" },
						Wrap = Input { Value = 1 },
						LayoutRotation = Input { Value = 1 },
						TransformRotation = Input { Value = 1 },
						Softness1 = Input { Value = 1 },
						VerticalJustificationNew = Input { Value = 3 },
						HorizontalJustificationNew = Input { Value = 3 },
						Size = Input { Expression = "CcCtrl.CcSize * 0.8" },
						GlobalIn = Input { Value = -480 }
					}
				},

{
	Tools = ordered() {
		CommentCard = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "CcCtrl", Source = "CcStyle", Name = "Kind" },
				Input2 = InstanceInput { SourceOp = "CcCtrl", Source = "CcName", Name = "Name" },
				Input3 = InstanceInput { SourceOp = "CcCtrl", Source = "CcMeta", Name = "When" },
				Input4 = InstanceInput { SourceOp = "CcCtrl", Source = "CcBody", Name = "Words" },
				Input5 = InstanceInput { SourceOp = "CcCtrl", Source = "CcLikesOn", Name = "Heart And Number" },
				Input6 = InstanceInput { SourceOp = "CcCtrl", Source = "CcLikes", Name = "Likes" },
				Input7 = InstanceInput { SourceOp = "CcCtrl", Source = "CcLikesEnd", Name = "Likes Grow To (0: they stay)" },
				Input8 = InstanceInput { SourceOp = "CcCtrl", Source = "CcFoot", Name = "After The Number" },
				Input9 = InstanceInput { SourceOp = "CcCtrl", Source = "CcPos", Name = "Position" },
				Input10 = InstanceInput { SourceOp = "CcBodyT", Source = "Font", Name = "Font" },
				Input11 = InstanceInput { SourceOp = "CcCtrl", Source = "CcSize", Name = "Size" },
				Input12 = InstanceInput { SourceOp = "CcCtrl", Source = "CcMinW", Name = "Narrowest Card" },
				Input13 = InstanceInput { SourceOp = "CcCtrl", Source = "CcPad", Name = "Padding" },
				Input14 = InstanceInput { SourceOp = "CcCtrl", Source = "CcRound", Name = "Roundness" },
				Input15 = InstanceInput { SourceOp = "CcCtrl", Source = "CcShadow", Name = "Shadow" },
				Input16 = InstanceInput { SourceOp = "CcCtrl", Source = "CcEnter", Name = "Entrance" },
				Input17 = InstanceInput { SourceOp = "CcCtrl", Source = "CcIn", Name = "Entrance Frames" },
				Input18 = InstanceInput { SourceOp = "CcCtrl", Source = "CcLeave", Name = "Leave The Same Way At The End" },
				Input19 = InstanceInput { SourceOp = "CcCtrl", Source = "CcOut", Name = "Leave Frames" },
				Input20 = InstanceInput { SourceOp = "CcCtrl", Source = "CcPreset", Name = "Colours" },
				Input21 = InstanceInput { SourceOp = "ColCcAvatar", Source = "TopLeftRed", Name = "Picture Colour", ControlGroup = 3 },
				Input22 = InstanceInput { SourceOp = "ColCcAvatar", Source = "TopLeftGreen", ControlGroup = 3 },
				Input23 = InstanceInput { SourceOp = "ColCcAvatar", Source = "TopLeftBlue", ControlGroup = 3 },
				Input24 = InstanceInput { SourceOp = "ColCcCard", Source = "TopLeftRed", Name = "Custom Card Colour", ControlGroup = 4 },
				Input25 = InstanceInput { SourceOp = "ColCcCard", Source = "TopLeftGreen", ControlGroup = 4 },
				Input26 = InstanceInput { SourceOp = "ColCcCard", Source = "TopLeftBlue", ControlGroup = 4 },
				Input27 = InstanceInput { SourceOp = "ColCcText", Source = "TopLeftRed", Name = "Custom Words Colour", ControlGroup = 5 },
				Input28 = InstanceInput { SourceOp = "ColCcText", Source = "TopLeftGreen", ControlGroup = 5 },
				Input29 = InstanceInput { SourceOp = "ColCcText", Source = "TopLeftBlue", ControlGroup = 5 },
				Input30 = InstanceInput { SourceOp = "ColCcDim", Source = "TopLeftRed", Name = "Custom Colour Of The Small Words", ControlGroup = 6 },
				Input31 = InstanceInput { SourceOp = "ColCcDim", Source = "TopLeftGreen", ControlGroup = 6 },
				Input32 = InstanceInput { SourceOp = "ColCcDim", Source = "TopLeftBlue", ControlGroup = 6 },
				Input33 = InstanceInput { SourceOp = "ColCcHeart", Source = "TopLeftRed", Name = "Custom Heart Colour", ControlGroup = 7 },
				Input34 = InstanceInput { SourceOp = "ColCcHeart", Source = "TopLeftGreen", ControlGroup = 7 },
				Input35 = InstanceInput { SourceOp = "ColCcHeart", Source = "TopLeftBlue", ControlGroup = 7 },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "CcFinal", Source = "Output" }
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				CcCtrl = Background {
					ViewInfo = OperatorInfo { Pos = { -495, -82.5 } },
					Inputs = {
						MetaA = Input { Expression = "(function() local d = CcMetaT.Output.DataWindow if not d or CcMetaT.StyledText.Value == '' then return Point(0.5, 0.5) end return Point(d.left/CcMetaT.Output.Width, d.top/CcMetaT.Output.Height) end)()" },
						MetaS = Input { Expression = "(function() local d = CcMetaT.Output.DataWindow if not d or CcMetaT.StyledText.Value == '' then return Point(0, 0) end local w = CcMetaT.Output.Width return Point(max(d.right - d.left, 0)/w, max(d.top - d.bottom, 0)/w) end)()" },
						BodyA = Input { Expression = "(function() local d = CcBodyT.Output.DataWindow if not d or CcBodyT.StyledText.Value == '' then return Point(0.5, 0.5) end return Point(d.left/CcBodyT.Output.Width, d.top/CcBodyT.Output.Height) end)()" },
						BodyS = Input { Expression = "(function() local d = CcBodyT.Output.DataWindow if not d or CcBodyT.StyledText.Value == '' then return Point(0, 0) end local w = CcBodyT.Output.Width return Point(max(d.right - d.left, 0)/w, max(d.top - d.bottom, 0)/w) end)()" },
						FootA = Input { Expression = "(function() local d = CcFootT.Output.DataWindow if not d or CcFootT.StyledText.Value == '' then return Point(0.5, 0.5) end return Point(d.left/CcFootT.Output.Width, d.top/CcFootT.Output.Height) end)()" },
						FootS = Input { Expression = "(function() local d = CcFootT.Output.DataWindow if not d or CcFootT.StyledText.Value == '' then return Point(0, 0) end local w = CcFootT.Output.Width return Point(max(d.right - d.left, 0)/w, max(d.top - d.bottom, 0)/w) end)()" },
						InitA = Input { Expression = "(function() local d = CcInitT.Output.DataWindow if not d or CcInitT.StyledText.Value == '' then return Point(0.5, 0.5) end return Point(d.left/CcInitT.Output.Width, d.top/CcInitT.Output.Height) end)()" },
						Show = Input { Expression = "min(min(max((time - comp.RenderStart + 1)/max(CcIn, 1), 0), 1),\n  iif(CcLeave > 0, min(max((comp.RenderEnd - time + 1)/max(CcOut, 1), 0), 1), 1))" },
						UseFrameFormatSettings = Input { Value = 1 },
						KFoot = Input { Expression = "iif(CcLikesOn > 0 and CcStyle == 0, 1, 0)" },
						KNameH = Input { Expression = "max(NameS.Y, MetaS.Y)" },
						Width = Input { Value = 1920 },
						GlobalIn = Input { Value = -480 },
						Height = Input { Value = 1080 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						KRowY = Input { Expression = "CcPad*CcSize + KNameH + iif(BodyS.Y > 0, 0.45*CcSize + BodyS.Y, 0) + 0.6*CcSize" },
						InitS = Input { Expression = "(function() local d = CcInitT.Output.DataWindow if not d or CcInitT.StyledText.Value == '' then return Point(0, 0) end local w = CcInitT.Output.Width return Point(max(d.right - d.left, 0)/w, max(d.top - d.bottom, 0)/w) end)()" },
						KText = Input { Expression = "max(max(NameS.X + iif(MetaS.X > 0, 0.6*CcSize + MetaS.X, 0), BodyS.X), KFoot*(1.1*CcSize + FootS.X))" },
						TopLeftAlpha = Input { Value = 0 },
						Move = Input { Expression = "(function(e, asp)\n  local u = (1 - Show)^3\n  if e == 1 then return Point(-0.2*u, 0) elseif e == 2 then return Point(0.2*u, 0)\n  elseif e == 3 then return Point(0, -u*(CcPos.Y + KCard.Y*asp/2 + 0.05))\n  elseif e == 4 then return Point(0, u*(1 - CcPos.Y + KCard.Y*asp/2 + 0.05)) end\n  return Point(0, 0)\nend)(CcEnter, (comp:GetPrefs('Comp.FrameFormat.Width')/comp:GetPrefs('Comp.FrameFormat.Height')))" },
						Scale = Input { Expression = "iif(CcEnter == 0, (function(t) t = t - 1 return max(1 + 2.70158*t*t*t + 1.70158*t*t, 0) end)(Show), 1)" },
						KCol = Input { Expression = "KLeft + CcPad*CcSize + 2.5*CcSize" },
						KTop = Input { Expression = "CcPos.Y + KCard.Y/2*(comp:GetPrefs('Comp.FrameFormat.Width')/comp:GetPrefs('Comp.FrameFormat.Height'))" },
						KLeft = Input { Expression = "CcPos.X - KCard.X/2" },
						KCard = Input { Expression = "Point(max(CcPad*CcSize*2 + 2.5*CcSize + KText, CcMinW), CcPad*CcSize*2 + max(2*CcSize, KRowY - CcPad*CcSize - 0.6*CcSize + KFoot*(0.6*CcSize + max(FootS.Y, 0.75*CcSize))))" },
						Fade = Input { Expression = "iif(CcEnter == 6 or CcEnter == 3 or CcEnter == 4, iif(Show > 0, 1, 0), iif(CcEnter == 5, Show, min(Show*3, 1)))" },
						NameA = Input { Expression = "(function() local d = CcNameT.Output.DataWindow if not d or CcNameT.StyledText.Value == '' then return Point(0.5, 0.5) end return Point(d.left/CcNameT.Output.Width, d.top/CcNameT.Output.Height) end)()" },
						NameS = Input { Expression = "(function() local d = CcNameT.Output.DataWindow if not d or CcNameT.StyledText.Value == '' then return Point(0, 0) end local w = CcNameT.Output.Width return Point(max(d.right - d.left, 0)/w, max(d.top - d.bottom, 0)/w) end)()" }
					},
					CtrlWZoom = false,
					UserControls = {
						CcStyle = {
							{
								CCS_AddString = "Comment"
							},
							{
								CCS_AddString = "Notification"
							},

							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Leave Frames",
							INP_Default = 8,
							INP_MinScale = 1,
							INP_MaxScale = 60
						},
						LblPadX = {
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Frame Padding X",
							INP_Default = 0.45,
							INP_MinScale = 0,
							INP_MaxScale = 2
						},
						Half = {
							LINKID_DataType = "Point",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "OffsetControl",
							LINKS_Name = "Half"
						},
						LblPadY = {
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Frame Padding Y",
							INP_Default = 0.3,
							INP_MinScale = 0,
							INP_MaxScale = 2
						},
						Wipe = {
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Wipe",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 1
						}
					},
					CtrlWZoom = false,
					ViewInfo = OperatorInfo { Pos = { -605, -82.5 } },
					Inputs = {
						Show = Input { Expression = "min(min(max((time - comp.RenderStart + 1)/max(LblIn, 1), 0), 1),\n  iif(LblLeave > 0, min(max((comp.RenderEnd - time + 1)/max(LblOut, 1), 0), 1), 1))" },
						Move = Input { Expression = "(function(e, d)\n  local u = 1 - Show\n  u = u*u*u*d\n  if e == 2 then return Point(-u, 0) elseif e == 3 then return Point(u, 0)\n  elseif e == 4 then return Point(0, -u) elseif e == 5 then return Point(0, u) end\n  return Point(0, 0)\nend)(LblEnter, LblDist)" },
						Scale = Input { Expression = "iif(LblEnter == 1, (function(t) t = t - 1 return 1 + 2.70158*t*t*t + 1.70158*t*t end)(Show), 1)" },
						TopLeftAlpha = Input { Value = 0 },
						Fade = Input { Expression = "iif(LblEnter >= 1 and LblEnter <= 5, min(Show*3, 1), 1)" },
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						UseFrameFormatSettings = Input { Value = 1 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Half = Input { Expression = "(function()\n  local asp = (comp:GetPrefs('Comp.FrameFormat.Width')/comp:GetPrefs('Comp.FrameFormat.Height'))\n  local tw, th = 0, 0\n  local d = LblWords.StyledText.Value ~= \"\" and LblWords.Output.DataWindow\n  if d then tw, th = (d.right - d.left)/LblWords.Output.Height, (d.top - d.bottom)/LblWords.Output.Height end\n  th = math.max(th, LblSize*asp*0.6)\n  return Point(tw/2 + LblPadX*LblSize*asp, th/2 + LblPadY*LblSize*asp)\nend)()" },
						Wipe = Input { Expression = "iif(LblEnter == 6, (function(t) return t*t*(3 - 2*t) end)(Show), 1)" },
						Ctr = Input { Expression = "Point(LblPos.X - (LblAnchor - 1)*Half.X/(comp:GetPrefs('Comp.FrameFormat.Width')/comp:GetPrefs('Comp.FrameFormat.Height')), LblPos.Y)" },
						GlobalIn = Input { Value = -480 }
					}
				},
				LblDraw = Custom {
					ViewInfo = OperatorInfo { Pos = { -165, 115.5 } },
					Inputs = {
						BlueExpression = Input { Value = "p4x*min(max((n3/2*n8 - i8)*h + 0.5, 0), 1)" },
						LUTIn1 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn11"
						},
						AlphaExpression = Input { Value = "1" },
						NumberIn2 = Input { Expression = "iif(LblCtrl.LblShape == 3, LblCtrl.LblSlant, 0)" },
						LUTIn2 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn21"
						},
						LUTIn3 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn31"
						},
						LUTIn4 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn41"
						},
						NumberIn4 = Input { Expression = "iif(LblCtrl.LblShape == 4, 0.7*LblCtrl.Half.Y, 0)" },
						Intermediate3 = Input { Value = "abs(i1) - p2x + n1" },
						NumberIn5 = Input { Expression = "iif(LblCtrl.LblShape == 6, LblCtrl.Half.Y, 0)" },
						Intermediate4 = Input { Value = "abs(i2) - p2y + n1" },
						NumberIn6 = Input { Expression = "iif(LblCtrl.LblShape == 7, 0.9*LblCtrl.Half.Y, 0)" },
						Intermediate5 = Input { Value = "min(max((sqrt(max(i3, 0)*max(i3, 0) + max(i4, 0)*max(i4, 0)) + min(max(i3, i4), 0) - n1), (abs(i1) - p2x + n4*(1 - abs(i2)/p2y))), if(n6 <= 0, 1, max((abs(i1 + p2x*0.4) - n6*0.5*(1 + (i2 + p2y)/n6))*0.8, i2 + p2y - n1 - 0.002)))" },
						NumberIn7 = Input { Expression = "iif(LblCtrl.LblShape == 6 or LblCtrl.LblShape == 8, 0, 1)" },
						NumberIn8 = Input { Expression = "iif(LblCtrl.LblShape == 5 or LblCtrl.LblShape == 8 or LblCtrl.LblBorder <= 0, 0, 1)" },
						PointIn1 = Input { Expression = "iif(LblCtrl.LblShape == 5, Point(LblCtrl.Ctr.X, LblCtrl.Ctr.Y - LblCtrl.Half.Y), LblCtrl.Ctr)" },
						PointIn2 = Input { Expression = "iif(LblCtrl.LblShape == 5, Point(LblCtrl.Half.X, 0.07*LblCtrl.LblSize*(comp:GetPrefs('Comp.FrameFormat.Width')/comp:GetPrefs('Comp.FrameFormat.Height'))), iif(LblCtrl.LblShape == 4, Point(LblCtrl.Half.X + 0.7*LblCtrl.Half.Y, LblCtrl.Half.Y), LblCtrl.Half))" },
						Image1 = Input {
							Source = "Output",
							SourceOp = "LblCtrl"
						},
						PointIn3 = Input { Expression = "Point(LblCtrl.LblShadowX, LblCtrl.LblShadowY)" },
						NumberIn1 = Input { Expression = "iif(LblCtrl.LblShape == 1 or LblCtrl.LblShape == 7, LblCtrl.LblRound*LblCtrl.Half.Y, iif(LblCtrl.LblShape == 2, LblCtrl.Half.Y, 0))" },
						PointIn4 = Input { Expression = "Point(iif(LblCtrl.LblShape == 6 or LblCtrl.LblShape == 8, 0, 1), 0)" },
						Intermediate2 = Input { Value = "y - p1y" },
						Intermediate8 = Input { Value = "min(max((sqrt(max(i6, 0)*max(i6, 0) + max(i7, 0)*max(i7, 0)) + min(max(i6, i7), 0) - n1), (abs((i1 - p3x + n2*p3y)) - p2x + n4*(1 - abs((i2 - p3y))/p2y))), if(n6 <= 0, 1, max((abs((i1 - p3x + n2*p3y) + p2x*0.4) - n6*0.5*(1 + ((i2 - p3y) + p2y)/n6))*0.8, (i2 - p3y) + p2y - n1 - 0.002)))" },
						Intermediate7 = Input { Value = "abs(i2 - p3y) - p2y + n1" },
						Intermediate6 = Input { Value = "abs(i1 - p3x + n2*p3y) - p2x + n1" },
						RedExpression = Input { Value = "n7*min(max(-i5*h + 0.5, 0), 1)" },
						Intermediate1 = Input { Value = "(x - p1x)*w/h - n2*(y - p1y)" },
						GreenExpression = Input { Value = "n8*min(max((n3/2 - abs(i5))*h + 0.5, 0), 1)*if(n5 <= 0, 1, if((i1 < n5 - p2x && i2 > p2y - n5) || (i1 > p2x - n5 && i2 < n5 - p2y), 1, 0))" },
						NumberIn3 = Input { Expression = "LblCtrl.LblBorder" }
					}
				},
				CustomTool1LUTIn11 = LUTBezier {
					SplineColor = { Red = 0, Green = 0, Blue = 0 },
					CtrlWZoom = false,
					NameSet = true,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					}
				},
				CustomTool1LUTIn21 = LUTBezier {
					SplineColor = { Red = 0, Green = 0, Blue = 0 },
					CtrlWZoom = false,
					NameSet = true,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					}
				},
				CustomTool1LUTIn31 = LUTBezier {
					SplineColor = { Red = 0, Green = 0, Blue = 0 },
					CtrlWZoom = false,
					NameSet = true,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					}
				},
				CustomTool1LUTIn41 = LUTBezier {
					SplineColor = { Red = 0, Green = 0, Blue = 0 },
					CtrlWZoom = false,
					NameSet = true,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					}
				},
				LblPaint = Custom {

							INP_MaxScale = 0.03,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Outline",
							INP_Default = 0.005
						},
						Total = {
							INP_MinScale = 0,
							INP_MaxScale = 10000,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Total",
							INP_Default = 0
						},
						WbIn = {
							INP_MinScale = 1,
							INP_MaxScale = 40,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Pop Frames",
							INP_Default = 5
						},
						Until = {
							INP_MinScale = 0,
							INP_MaxScale = 100000,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Until",
							INP_Default = 0
						},
						WbOut = {
							INP_MinScale = 0,
							INP_MaxScale = 40,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Fade Out Frames",
							INP_Default = 3

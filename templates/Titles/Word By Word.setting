							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Shadow Softness",
							INP_Default = 0
						},
						WbSay = {
							TEC_Lines = 1,
							LINKID_DataType = "Text",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "TextEditControl",
							LINKS_Name = "Text",
							INPS_DefaultText = "One character after another"
						},
						Part = {
							INP_MinScale = 0,
							INP_MaxScale = 1,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Part",
							INP_Default = 0
						},
						Rule = {
							INPID_InputControl = "OffsetControl",
							LINKS_Name = "Rule",
							LINKID_DataType = "Point",
							ICS_ControlPage = "Driver"
						},
						RuleY = {
							INPID_InputControl = "OffsetControl",
							LINKS_Name = "RuleY",
							LINKID_DataType = "Point",
							ICS_ControlPage = "Driver"
						},
						LineX = {
							INP_MinScale = -4,
							INP_MaxScale = 4,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "LineX",
							INP_Default = 0
						},
						WbStep = {
							INP_Integer = true,
							ICS_ControlPage = "Controls",
							INPID_InputControl = "CheckboxControl",
							LINKID_DataType = "Number",
							LINKS_Name = "Fill One Character At A Time",
							INP_Default = 0
						},
						WbEnd = {
							INP_MinScale = 0.1,
							INP_MaxScale = 1,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Done At",
							INP_Default = 0.75
						}
					},
					Inputs = {
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						Since = Input { Expression = "time - comp.RenderStart" },
						Until = Input { Expression = "comp.RenderEnd - time + 1" },
						Cur = Input { Expression = "Text(WbCtrl.WbSay.Value)" },
						Total = Input { Expression = "(function(s) local n = 0 for ch in s:gmatch(\"[^\" .. string.char(128) .. \"-\" .. string.char(191) .. \"][\" .. string.char(128) .. \"-\" .. string.char(191) .. \"]*\") do n = n + 1 end return n end)(WbCtrl.Cur.Value)" },
						Prog = Input { Expression = "iif(WbCtrl.Total < 1, 0, iif(WbCtrl.WbHand == 1, min(max(WbCtrl.WbDone/WbCtrl.Total, 0), 1), min(max((WbCtrl.Since + 1)/max(WbCtrl.WbEnd*(WbCtrl.Since + WbCtrl.Until), 1), 0), 1)))" },
						UseFrameFormatSettings = Input { Value = 1 },
						Typed = Input { Expression = "Text((function(s, n) local out, k = {}, 0 for ch in s:gmatch(\"[^\" .. string.char(128) .. \"-\" .. string.char(191) .. \"][\" .. string.char(128) .. \"-\" .. string.char(191) .. \"]*\") do if k >= n then break end k = k + 1 out[k] = ch end return table.concat(out) end)(WbCtrl.Cur.Value, WbCtrl.Count.X))" },
						Ahead = Input { Expression = "Text((function(s, n) local out, k = {}, 0 for ch in s:gmatch(\"[^\" .. string.char(128) .. \"-\" .. string.char(191) .. \"][\" .. string.char(128) .. \"-\" .. string.char(191) .. \"]*\") do if k >= n then break end k = k + 1 out[k] = ch end return table.concat(out) end)(WbCtrl.Cur.Value, WbCtrl.Count.X + 1))" },
						Part = Input { Expression = "max(min(max(iif(WbCtrl.WbHand == 1, WbCtrl.WbDone, WbCtrl.Total*WbCtrl.Prog), 0), WbCtrl.Total) - WbCtrl.Count.X, 0)" },
						WidN = Input { Expression = "max((function() local d = WbAhead.Output.DataWindow if not d then return 0 end local w, h = WbAhead.Output.Width, WbAhead.Output.Height return d.right/w end)() - WbCtrl.Rule.Y, 0)" },
						Rule = Input { Expression = "(function() local d = WbRuler.Output.DataWindow if not d then return Point(0, 0) end local w, h = WbRuler.Output.Width, WbRuler.Output.Height return Point(d.left/w, d.right/w) end)()" },
						RuleY = Input { Expression = "(function() local d = WbRuler.Output.DataWindow if not d then return Point(0, 0) end local w, h = WbRuler.Output.Width, WbRuler.Output.Height return Point(d.bottom/h, d.top/h) end)()" },
						Wid = Input { Expression = "max((function() local d = WbMeasure.Output.DataWindow if not d then return 0 end local w, h = WbMeasure.Output.Width, WbMeasure.Output.Height return d.right/w end)() - WbCtrl.Rule.Y, 0)" },
						FullW = Input { Expression = "max((function() local d = WbFull.Output.DataWindow if not d then return 0 end local w, h = WbFull.Output.Width, WbFull.Output.Height return d.right/w end)() - WbCtrl.Rule.Y, 0)" },
						GlobalIn = Input { Value = -480 },
						Curs = Input { Expression = "Point(WbCtrl.LineX + WbCtrl.Wid + WbCtrl.Rule.X - 0.05 + WbCtrl.LkSize*0.03, iif(WbCtrl.WbCursor == 0, WbCtrl.LkSize*0.07, iif(WbCtrl.WbCursor == 3, 0, WbCtrl.LkSize*0.5)))" },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Pop = Input { Expression = "iif(WbCtrl.WbMode == 0, 1, 1 + 0.25*max(1 - (WbCtrl.Since + 1)/max(WbCtrl.WbIn, 1), 0)^2)" },
						LineX = Input { Expression = "iif(WbCtrl.WbAlign == 0, WbCtrl.WbPos.X, WbCtrl.WbPos.X - iif(WbCtrl.WbAlign == 2 and WbCtrl.WbMode == 0, WbCtrl.Wid, WbCtrl.FullW)/2)" },
						Fade = Input { Expression = "iif(WbCtrl.WbMode == 0, 1, min((WbCtrl.Since + 1)/max(WbCtrl.WbIn, 1)*2, 1)) * iif(WbCtrl.WbOut <= 0, 1, min(max(WbCtrl.Until/WbCtrl.WbOut, 0), 1))" },
						WbPos = Input { Value = { 0.5, 0.14 } },
						Show = Input { Expression = "iif(WbCtrl.WbMode ~= 0 or WbCtrl.WbCursor == 3, 0, iif(WbCtrl.Count.Y > 0 or WbCtrl.WbBlink <= 0, 1, iif((WbCtrl.Since/(comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24)*WbCtrl.WbBlink) % 1 < 0.5, 1, 0)))" },
						TopLeftAlpha = Input { Value = 0 },
						Count = Input { Expression = "(function(mode, since, untl, n, prog, exit, del, hand, done, before)\n  if n < 1 then return Point(0, 0) end\n  if hand == 1 then return Point(math.floor(math.min(math.max(done, 0), n) + 0.0001), (done ~= before) and 1 or 0) end\n  local c, busy = math.floor(n*prog + 0.0001), 0\n  if prog < 1 then busy = 1 end\n  if mode == 0 and exit == 1 then\n    local span = math.max((1 - del)*(since + untl), 1)\n    if untl - 1 <= span then busy = 1 end\n    c = math.min(c, math.floor(n*math.min((untl - 1)/span, 1) + 0.0001))\n  end\n  return Point(c, busy)\nend)(WbCtrl.WbMode, WbCtrl.Since, WbCtrl.Until, WbCtrl.Total, WbCtrl.Prog, WbCtrl.WbExit, WbCtrl.WbDel, WbCtrl.WbHand, WbCtrl.WbDone, WbCtrl:GetValue(\"WbDone\", time - 1))" }
					}

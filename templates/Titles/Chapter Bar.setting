{
	Tools = ordered() {
		ChapterBar = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "BarCtrl", Source = "ChapterList", Name = "Chapters (0:00 Name)" },
				Input2 = InstanceInput { SourceOp = "BarCtrl", Source = "FpsOverride", Name = "Frame Rate Override" },
				Input3 = InstanceInput { SourceOp = "Fill", Source = "TopLeftRed", Name = "Bar Color", ControlGroup = 2 },
				Input4 = InstanceInput { SourceOp = "Fill", Source = "TopLeftGreen", ControlGroup = 2 },
				Input5 = InstanceInput { SourceOp = "Fill", Source = "TopLeftBlue", ControlGroup = 2 },
				Input6 = InstanceInput { SourceOp = "Track", Source = "TopLeftRed", Name = "Track Color", ControlGroup = 3 },
				Input7 = InstanceInput { SourceOp = "Track", Source = "TopLeftGreen", ControlGroup = 3 },
				Input8 = InstanceInput { SourceOp = "Track", Source = "TopLeftBlue", ControlGroup = 3 },
				Input9 = InstanceInput { SourceOp = "BarCtrl", Source = "TrackOpacity", Name = "Track Opacity" },
				Input10 = InstanceInput { SourceOp = "BarCtrl", Source = "BarY", Name = "Bar Position" },
				Input11 = InstanceInput { SourceOp = "BarCtrl", Source = "BarH", Name = "Bar Height" },
				Input12 = InstanceInput { SourceOp = "BarCtrl", Source = "BarMargin", Name = "Side Margin" },
				Input13 = InstanceInput { SourceOp = "BarCtrl", Source = "BarGap", Name = "Chapter Gap" },
				Input14 = InstanceInput { SourceOp = "BarCtrl", Source = "Knob", Name = "Knob Size" },
				Input15 = InstanceInput { SourceOp = "BarCtrl", Source = "ShowLabel", Name = "Show Chapter Name" },
				Input16 = InstanceInput { SourceOp = "BarCtrl", Source = "LabelSize", Name = "Name Size" },
				Input17 = InstanceInput { SourceOp = "Label", Source = "Font", Name = "Name Font", ControlGroup = 4 },
				Input18 = InstanceInput { SourceOp = "Label", Source = "Style", ControlGroup = 4 },
				Input19 = InstanceInput { SourceOp = "Label", Source = "Red1", Name = "Name Color", ControlGroup = 5 },
				Input20 = InstanceInput { SourceOp = "Label", Source = "Green1", ControlGroup = 5 },
				Input21 = InstanceInput { SourceOp = "Label", Source = "Blue1", ControlGroup = 5 },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "BarOut", Source = "Output" }
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				BarCtrl = Background {
					ViewInfo = OperatorInfo { Pos = { -495, -82.5 } },
					Inputs = {
						S17 = Input { Expression = "(function(c)\n  local n = 0\n  for i = 1, #c do\n    if c[i][1] > 0.0001 then n = n + 1; if n == 17 then return c[i][1] end end\n  end\n  return 2\nend)((function(txt, fps, len)\n  local out = {}\n  for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n    local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n    if stamp then\n      local f\n      local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n      if pct then f = tonumber(pct) / 100 * len\n      elseif fr then f = tonumber(fr)\n      elseif stamp:match(\"^[%d:%.]+$\") then\n        local sec = 0\n        for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n        if sec then f = math.floor(sec * fps + 0.5) end\n      end\n      if f then out[#out + 1] = {f / len, name} end\n    end\n  end\n  table.sort(out, function(a, b) return a[1] < b[1] end)\n  return out\nend)(BarCtrl.ChapterList.Value, iif(BarCtrl.FpsOverride > 0, BarCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), max(comp.RenderEnd - comp.RenderStart, 1)))" },
						P = Input { Expression = "min(max((time - comp.RenderStart) / max(comp.RenderEnd - comp.RenderStart, 1), 0), 1)" },

				Input4 = InstanceInput { SourceOp = "MarkCtrl", Source = "MarkAngle", Name = "Angle" },
				Input5 = InstanceInput { SourceOp = "MarkCtrl", Source = "MarkIn", Name = "Pop Frames" },

				Input7 = InstanceInput { SourceOp = "MarkCtrl", Source = "MarkOut", Name = "Fade Out Frames" },
				Input8 = InstanceInput { SourceOp = "MarkCtrl", Source = "MarkEdge", Name = "Outline" },
				Input9 = InstanceInput { SourceOp = "MarkCtrl", Source = "MarkEdgeB", Name = "Outer Outline" },
				Input10 = InstanceInput { SourceOp = "MarkCtrl", Source = "MarkCustom", Name = "Use My Colours" },
				Input11 = InstanceInput { SourceOp = "ColMark", Source = "TopLeftRed", Name = "My Color", ControlGroup = 3 },
				Input12 = InstanceInput { SourceOp = "ColMark", Source = "TopLeftGreen", ControlGroup = 3 },
				Input13 = InstanceInput { SourceOp = "ColMark", Source = "TopLeftBlue", ControlGroup = 3 },
				Input14 = InstanceInput { SourceOp = "ColMarkEdge", Source = "TopLeftRed", Name = "My Outline Color", ControlGroup = 4 },
				Input15 = InstanceInput { SourceOp = "ColMarkEdge", Source = "TopLeftGreen", ControlGroup = 4 },
				Input16 = InstanceInput { SourceOp = "ColMarkEdge", Source = "TopLeftBlue", ControlGroup = 4 },
				Input17 = InstanceInput { SourceOp = "MarkCtrl", Source = "MarkCount", Name = "Focus Lines: Count" },
				Input18 = InstanceInput { SourceOp = "MarkCtrl", Source = "MarkHole", Name = "Focus Lines: Clear Area" },
				Input19 = InstanceInput { SourceOp = "MarkCtrl", Source = "MarkWidth", Name = "Focus Lines: Thickness" },
				Input20 = InstanceInput { SourceOp = "MarkCtrl", Source = "MarkFlick", Name = "Focus Lines: Frames Per Change" },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "MarkOut", Source = "Output" }
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				MarkCtrl = Background {
					CtrlWZoom = false,
					Inputs = {
						MarkPos = Input { Value = { 0.68, 0.72 } },
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						Fade = Input { Expression = "min(T*4, 1) * iif(MarkOut <= 0, 1, min(max((comp.RenderEnd - time + 1)/MarkOut, 0), 1))" },
						TopLeftAlpha = Input { Value = 0 },
						UseFrameFormatSettings = Input { Value = 1 },
						GlobalIn = Input { Value = -480 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Scale = Input { Expression = "iif(MarkType == 4, 1, (function(t) t = t - 1 return 1 + 2.70158*t*t*t + 1.70158*t*t end)(T) * (1 + 0.07*MarkPulse*sin(time*0.9)))" },
						T = Input { Expression = "min(max((time - comp.RenderStart + 1)/max(MarkIn, 1), 0), 1)" }
					},
					UserControls = {
						MarkWidth = {
							LINKID_DataType = "Number",
							LINKS_Name = "Focus Lines: Thickness",
							INP_Default = 0.55,
							INP_MinScale = 0.05,
							INP_MaxScale = 1,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl"
						},
						MarkPos = {
							LINKS_Name = "Position",
							ICS_ControlPage = "Controls",
							LINKID_DataType = "Point",
							INPID_PreviewControl = "CrosshairControl",
							INPID_InputControl = "OffsetControl"
						},
						T = {

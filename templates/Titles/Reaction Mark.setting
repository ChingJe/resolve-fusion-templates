					ViewInfo = OperatorInfo { Pos = { -55, 16.5 } }
				},
				MarkPaintGrowB = ErodeDilate {
					Inputs = {
						Input = Input {
							SourceOp = "MarkMatte",
							Source = "Output"
						},
						Filter = Input { Value = 3 },
						XAmount = Input { Expression = "(iif(MarkCtrl.MarkType == 4, 0, MarkCtrl.MarkEdge)) + (iif(MarkCtrl.MarkType == 4, 0, MarkCtrl.MarkEdgeB))" }
					},
					ViewInfo = OperatorInfo { Pos = { 55, 82.5 } }
				},
				MarkPaintGrowA = ErodeDilate {
					Inputs = {
						Input = Input {
							SourceOp = "MarkMatte",
							Source = "Output"
						},
						Filter = Input { Value = 3 },
						XAmount = Input { Expression = "iif(MarkCtrl.MarkType == 4, 0, MarkCtrl.MarkEdge)" }
					},
					ViewInfo = OperatorInfo { Pos = { 55, 49.5 } }
				},
				MarkPaint = Custom {
					Inputs = {
						AlphaExpression = Input { Value = "a1 + (1 - a1)*(i1 + (1 - i1)*i2)" },
						NumberIn7 = Input { Expression = "iif((iif(MarkCtrl.MarkType == 4, 0, MarkCtrl.MarkEdge)) > 0, 1, 0)" },
						NumberIn8 = Input { Expression = "iif((iif(MarkCtrl.MarkType == 4, 0, MarkCtrl.MarkEdgeB)) > 0, 1, 0)" },
						Intermediate1 = Input { Value = "a2*n7" },
						LUTIn3 = Input {
							SourceOp = "CustomTool1LUTIn31",
							Source = "Value"
						},
						Intermediate2 = Input { Value = "a3*n8" },
						BlueExpression = Input { Value = "n3*a1 + (1 - a1)*(n6*i1 + (1 - i1)*p2x*i2)" },
						Image2 = Input {
							SourceOp = "MarkPaintGrowA",
							Source = "Output"
						},
						Image1 = Input {
							SourceOp = "MarkMatte",
							Source = "Output"
						},
						Image3 = Input {
							SourceOp = "MarkPaintGrowB",
							Source = "Output"
						},
						PointIn1 = Input { Expression = "Point(({{0.95,0.1,0.1,1,1,1,0.3,0,0},{0.55,0.85,1,1,1,1,0.05,0.25,0.5},{1,0.88,0.15,1,1,1,0.1,0.08,0.02},{1,0.25,0.15,1,1,1,0.1,0.02,0.02},{0,0,0,1,1,1,0,0,0}})[MarkCtrl.MarkType + 1][7], ({{0.95,0.1,0.1,1,1,1,0.3,0,0},{0.55,0.85,1,1,1,1,0.05,0.25,0.5},{1,0.88,0.15,1,1,1,0.1,0.08,0.02},{1,0.25,0.15,1,1,1,0.1,0.02,0.02},{0,0,0,1,1,1,0,0,0}})[MarkCtrl.MarkType + 1][8])" },
						LUTIn1 = Input {
							SourceOp = "CustomTool1LUTIn11",
							Source = "Value"
						},
						NumberIn1 = Input { Expression = "iif(MarkCtrl.MarkCustom > 0, ColMark.TopLeftRed, ({{0.95,0.1,0.1,1,1,1,0.3,0,0},{0.55,0.85,1,1,1,1,0.05,0.25,0.5},{1,0.88,0.15,1,1,1,0.1,0.08,0.02},{1,0.25,0.15,1,1,1,0.1,0.02,0.02},{0,0,0,1,1,1,0,0,0}})[MarkCtrl.MarkType + 1][1])" },
						PointIn2 = Input { Expression = "Point(({{0.95,0.1,0.1,1,1,1,0.3,0,0},{0.55,0.85,1,1,1,1,0.05,0.25,0.5},{1,0.88,0.15,1,1,1,0.1,0.08,0.02},{1,0.25,0.15,1,1,1,0.1,0.02,0.02},{0,0,0,1,1,1,0,0,0}})[MarkCtrl.MarkType + 1][9], 0)" },
						NumberIn2 = Input { Expression = "iif(MarkCtrl.MarkCustom > 0, ColMark.TopLeftGreen, ({{0.95,0.1,0.1,1,1,1,0.3,0,0},{0.55,0.85,1,1,1,1,0.05,0.25,0.5},{1,0.88,0.15,1,1,1,0.1,0.08,0.02},{1,0.25,0.15,1,1,1,0.1,0.02,0.02},{0,0,0,1,1,1,0,0,0}})[MarkCtrl.MarkType + 1][2])" },
						LUTIn2 = Input {
							SourceOp = "CustomTool1LUTIn21",
							Source = "Value"
						},
						NumberIn3 = Input { Expression = "iif(MarkCtrl.MarkCustom > 0, ColMark.TopLeftBlue, ({{0.95,0.1,0.1,1,1,1,0.3,0,0},{0.55,0.85,1,1,1,1,0.05,0.25,0.5},{1,0.88,0.15,1,1,1,0.1,0.08,0.02},{1,0.25,0.15,1,1,1,0.1,0.02,0.02},{0,0,0,1,1,1,0,0,0}})[MarkCtrl.MarkType + 1][3])" },
						RedExpression = Input { Value = "n1*a1 + (1 - a1)*(n4*i1 + (1 - i1)*p1x*i2)" },
						NumberIn4 = Input { Expression = "iif(MarkCtrl.MarkCustom > 0, ColMarkEdge.TopLeftRed, ({{0.95,0.1,0.1,1,1,1,0.3,0,0},{0.55,0.85,1,1,1,1,0.05,0.25,0.5},{1,0.88,0.15,1,1,1,0.1,0.08,0.02},{1,0.25,0.15,1,1,1,0.1,0.02,0.02},{0,0,0,1,1,1,0,0,0}})[MarkCtrl.MarkType + 1][4])" },
						LUTIn4 = Input {
							SourceOp = "CustomTool1LUTIn41",

{
	Tools = ordered() {
		ReactionMark = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "MarkCtrl", Source = "MarkType", Name = "Mark" },
				Input2 = InstanceInput { SourceOp = "MarkCtrl", Source = "MarkPos", Name = "Position" },

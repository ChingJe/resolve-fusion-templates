					SplineColor = { Green = 0, Blue = 0, Red = 0 },
					NameSet = true,
					CtrlWZoom = false
				},
				MarkGlyph = TextPlus {
					Version = 1,
					Inputs = {
						Font = Input { Value = "Arial" },
						Size = Input { Expression = "3.6*MarkCtrl.MarkSize*MarkCtrl.Scale*comp:GetPrefs('Comp.FrameFormat.Height')/comp:GetPrefs('Comp.FrameFormat.Width')" },
						StyledText = Input { Expression = "Text(iif(MarkCtrl.MarkType == 2, '?', iif(MarkCtrl.MarkType == 3, '!', '')))" },
						UseFrameFormatSettings = Input { Value = 1 },
						GlobalIn = Input { Value = -480 },
						Center = Input { Expression = "MarkCtrl.MarkPos" },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Wrap = Input { Value = 1 },
						LayoutRotation = Input { Value = 1 },
						TransformRotation = Input { Value = 1 },

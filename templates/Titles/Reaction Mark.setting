						AngleZ = Input { Expression = "-MarkCtrl.MarkAngle" },
						Style = Input { Value = "Bold" }
					},
					ViewInfo = OperatorInfo { Pos = { -275, 49.5 } }
				},
				MarkMatte = Merge {
					Inputs = {
						Background = Input {
							SourceOp = "MarkShape",
							Source = "Output"
						},
						Foreground = Input {
							SourceOp = "MarkGlyph",
							Source = "Output"
						},
						PerformDepthMerge = Input { Value = 0 }

							INP_Default = 3,
							INP_MinScale = 1,
							INP_MaxScale = 30,
							INP_Integer = true,
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl"
						},
						MarkHole = {
							LINKID_DataType = "Number",
							LINKS_Name = "Focus Lines: Clear Area",
							INP_Default = 1.6,
							INP_MinScale = 0.2,
							INP_MaxScale = 6,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl"
						},
						MarkType = {
							{
								CCS_AddString = "Anger"
							},
							{
								CCS_AddString = "Sweat Drop"
							},
							{
								CCS_AddString = "Question"
							},
							{
								CCS_AddString = "Exclamation"
							},
							{
								CCS_AddString = "Focus Lines"
							},
							LINKS_Name = "Mark",
							INP_Default = 0,
							LINKID_DataType = "Number",
							INP_Integer = true,
							ICS_ControlPage = "Controls",
							INPID_InputControl = "ComboControl"
						}
					},
					ViewInfo = OperatorInfo { Pos = { -605, -82.5 } }
				},
				MarkShape = Custom {
					Inputs = {
						AlphaExpression = Input { Value = "if(n1 == 0, if(abs(i1) < 0.9 && abs(i2) < 0.9, min(max((0.08 - abs(i3 - 0.8))*i8 + 0.5, 0), 1), 0), if(n1 == 1, if(i4 < 0, min(max((0.55 - sqrt(i1*i1 + (i2 + 0.3)*(i2 + 0.3)))*i8 + 0.5, 0), 1), if(i4 <= 1, min(max((0.55*(1 - i4*i4) - abs(i1))*i8 + 0.5, 0), 1), 0)), if(n1 == 4, if(frac(i6*7.13) > 0.25 && i7 > n5*(1 + 0.6*i6), min(max((0.5*n6*min((i7 - n5*(1 + 0.6*i6))/2, 1) - abs(frac(i5) - 0.5))*30 + 0.5, 0), 1), 0), 0)))" },
						NumberIn7 = Input { Expression = "iif(MarkCtrl.MarkType == 4, 0, MarkCtrl.MarkAngle)" },
						NumberIn8 = Input { Expression = "max(MarkCtrl.Scale, 0.001)" },
						Intermediate1 = Input { Value = "((x - p1x)*w/h*cos(n7) + (y - p1y)*sin(n7))/(n2*n8)" },
						LUTIn3 = Input {
							SourceOp = "CustomTool1LUTIn3",
							Source = "Value"
						},
						Intermediate2 = Input { Value = "((y - p1y)*cos(n7) - (x - p1x)*w/h*sin(n7))/(n2*n8)" },
						Intermediate3 = Input { Value = "sqrt((abs(i1) - 1)*(abs(i1) - 1) + (abs(i2) - 1)*(abs(i2) - 1))" },
						Intermediate4 = Input { Value = "(i2 + 0.3)/1.3" },
						Intermediate5 = Input { Value = "atan2(i2, i1)/360*n4 + n4" },
						Intermediate6 = Input { Value = "abs(frac(sin(floor(i5)*744.3 + n3*91.7)*43758.5453))" },
						Image1 = Input {
							SourceOp = "MarkCtrl",
							Source = "Output"
						},
						Intermediate7 = Input { Value = "sqrt(i1*i1 + i2*i2)" },
						BlueExpression = Input { Value = "if(n1 == 0, if(abs(i1) < 0.9 && abs(i2) < 0.9, min(max((0.08 - abs(i3 - 0.8))*i8 + 0.5, 0), 1), 0), if(n1 == 1, if(i4 < 0, min(max((0.55 - sqrt(i1*i1 + (i2 + 0.3)*(i2 + 0.3)))*i8 + 0.5, 0), 1), if(i4 <= 1, min(max((0.55*(1 - i4*i4) - abs(i1))*i8 + 0.5, 0), 1), 0)), if(n1 == 4, if(frac(i6*7.13) > 0.25 && i7 > n5*(1 + 0.6*i6), min(max((0.5*n6*min((i7 - n5*(1 + 0.6*i6))/2, 1) - abs(frac(i5) - 0.5))*30 + 0.5, 0), 1), 0), 0)))" },
						PointIn1 = Input { Expression = "MarkCtrl.MarkPos" },
						LUTIn1 = Input {
							SourceOp = "CustomTool1LUTIn1",
							Source = "Value"
						},
						NumberIn1 = Input { Expression = "MarkCtrl.MarkType" },
						LUTIn2 = Input {
							SourceOp = "CustomTool1LUTIn2",
							Source = "Value"
						},
						NumberIn2 = Input { Expression = "MarkCtrl.MarkSize" },
						RedExpression = Input { Value = "if(n1 == 0, if(abs(i1) < 0.9 && abs(i2) < 0.9, min(max((0.08 - abs(i3 - 0.8))*i8 + 0.5, 0), 1), 0), if(n1 == 1, if(i4 < 0, min(max((0.55 - sqrt(i1*i1 + (i2 + 0.3)*(i2 + 0.3)))*i8 + 0.5, 0), 1), if(i4 <= 1, min(max((0.55*(1 - i4*i4) - abs(i1))*i8 + 0.5, 0), 1), 0)), if(n1 == 4, if(frac(i6*7.13) > 0.25 && i7 > n5*(1 + 0.6*i6), min(max((0.5*n6*min((i7 - n5*(1 + 0.6*i6))/2, 1) - abs(frac(i5) - 0.5))*30 + 0.5, 0), 1), 0), 0)))" },
						NumberIn3 = Input { Expression = "floor(time/max(MarkCtrl.MarkFlick, 1))" },
						Intermediate8 = Input { Value = "n2*n8*h" },
						NumberIn4 = Input { Expression = "MarkCtrl.MarkCount" },
						LUTIn4 = Input {
							SourceOp = "CustomTool1LUTIn4",
							Source = "Value"
						},
						NumberIn5 = Input { Expression = "MarkCtrl.MarkHole" },
						GreenExpression = Input { Value = "if(n1 == 0, if(abs(i1) < 0.9 && abs(i2) < 0.9, min(max((0.08 - abs(i3 - 0.8))*i8 + 0.5, 0), 1), 0), if(n1 == 1, if(i4 < 0, min(max((0.55 - sqrt(i1*i1 + (i2 + 0.3)*(i2 + 0.3)))*i8 + 0.5, 0), 1), if(i4 <= 1, min(max((0.55*(1 - i4*i4) - abs(i1))*i8 + 0.5, 0), 1), 0)), if(n1 == 4, if(frac(i6*7.13) > 0.25 && i7 > n5*(1 + 0.6*i6), min(max((0.5*n6*min((i7 - n5*(1 + 0.6*i6))/2, 1) - abs(frac(i5) - 0.5))*30 + 0.5, 0), 1), 0), 0)))" },
						NumberIn6 = Input { Expression = "MarkCtrl.MarkWidth" }
					},
					ViewInfo = OperatorInfo { Pos = { -275, 16.5 } }
				},
				CustomTool1LUTIn1 = LUTBezier {
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },

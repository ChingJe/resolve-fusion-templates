{
	Tools = ordered() {
		PenMark = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "PenCtrl", Source = "PenShape", Name = "Shape" },
				Input2 = InstanceInput { SourceOp = "PenCtrl", Source = "PenPos", Name = "Position" },
				Input3 = InstanceInput { SourceOp = "PenCtrl", Source = "PenW", Name = "Width" },
				Input4 = InstanceInput { SourceOp = "PenCtrl", Source = "PenH", Name = "Height" },
				Input5 = InstanceInput { SourceOp = "PenCtrl", Source = "PenAngle", Name = "Angle" },
				Input6 = InstanceInput { SourceOp = "PenCtrl", Source = "PenFrom", Name = "Arrow: From" },
				Input7 = InstanceInput { SourceOp = "PenCtrl", Source = "PenTo", Name = "Arrow: To" },
				Input8 = InstanceInput { SourceOp = "PenCtrl", Source = "PenBend", Name = "Arrow: Bend" },
				Input9 = InstanceInput { SourceOp = "PenCtrl", Source = "PenHead", Name = "Arrow: Head Size" },
				Input10 = InstanceInput { SourceOp = "PenCtrl", Source = "PenThick", Name = "Thickness" },
				Input11 = InstanceInput { SourceOp = "PenCtrl", Source = "PenTaper", Name = "Thin Ends" },
				Input12 = InstanceInput { SourceOp = "PenCtrl", Source = "PenWobble", Name = "Wobble" },
				Input13 = InstanceInput { SourceOp = "PenCtrl", Source = "PenSeed", Name = "Wobble Seed" },
				Input14 = InstanceInput { SourceOp = "PenCtrl", Source = "PenPasses", Name = "Times Drawn Over" },
				Input15 = InstanceInput { SourceOp = "PenCtrl", Source = "PenBoil", Name = "Redraw Every (frames, 0 = never)" },
				Input16 = InstanceInput { SourceOp = "PenCtrl", Source = "PenOverlap", Name = "Circle: Overlap" },
				Input17 = InstanceInput { SourceOp = "PenCtrl", Source = "PenStart", Name = "Circle: Start Angle" },
				Input18 = InstanceInput { SourceOp = "PenCtrl", Source = "PenCorner", Name = "Corners: Length" },
				Input19 = InstanceInput { SourceOp = "PenCtrl", Source = "PenWaves", Name = "Wavy Line: Waves" },
				Input20 = InstanceInput { SourceOp = "PenCtrl", Source = "PenOpacity", Name = "Opacity" },
				Input21 = InstanceInput { SourceOp = "PenCtrl", Source = "PenEdge", Name = "Outline" },
				Input22 = InstanceInput { SourceOp = "PenCtrl", Source = "PenDraw", Name = "Draw (seconds)" },
				Input23 = InstanceInput { SourceOp = "PenCtrl", Source = "PenExit", Name = "Leaves By" },
				Input24 = InstanceInput { SourceOp = "PenCtrl", Source = "PenOut", Name = "Leave (seconds)" },
				Input25 = InstanceInput { SourceOp = "PenCtrl", Source = "FpsOverride", Name = "Frame Rate Override" },
				Input26 = InstanceInput { SourceOp = "ColPen", Source = "TopLeftRed", Name = "Colour", ControlGroup = 3 },
				Input27 = InstanceInput { SourceOp = "ColPen", Source = "TopLeftGreen", ControlGroup = 3 },
				Input28 = InstanceInput { SourceOp = "ColPen", Source = "TopLeftBlue", ControlGroup = 3 },
				Input29 = InstanceInput { SourceOp = "ColPenEdge", Source = "TopLeftRed", Name = "Outline Colour", ControlGroup = 4 },
				Input30 = InstanceInput { SourceOp = "ColPenEdge", Source = "TopLeftGreen", ControlGroup = 4 },
				Input31 = InstanceInput { SourceOp = "ColPenEdge", Source = "TopLeftBlue", ControlGroup = 4 },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "PenFinal", Source = "Output" }
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				PenCtrl = Background {
					ViewInfo = OperatorInfo { Pos = { -495, -82.5 } },
					Inputs = {
						S3 = Input { Expression = "(function(s, A, B, H, i)\n  local P\n  if s == 6 then P = {{-A, 0}, {A, 0}, {A, 0}, {A - H*0.883, H*0.469}, {A, 0}, {A - H*0.883, -H*0.469}}\n  elseif s == 7 then P = {{-A, 0}, {-0.3*A, -B}, {-0.3*A, -B}, {A, B}}\n  elseif s == 8 then P = {{-A, B}, {A, -B}, {A, B}, {-A, -B}}\n  else P = {{-A, 0}, {A, 0}} end\n  local p = P[i] or {99, 99 + i}\n  return Point(p[1], p[2])\nend)(PenShape, A, B, PenHead, 3)" },
						S4 = Input { Expression = "(function(s, A, B, H, i)\n  local P\n  if s == 6 then P = {{-A, 0}, {A, 0}, {A, 0}, {A - H*0.883, H*0.469}, {A, 0}, {A - H*0.883, -H*0.469}}\n  elseif s == 7 then P = {{-A, 0}, {-0.3*A, -B}, {-0.3*A, -B}, {A, B}}\n  elseif s == 8 then P = {{-A, B}, {A, -B}, {A, B}, {-A, -B}}\n  else P = {{-A, 0}, {A, 0}} end\n  local p = P[i] or {99, 99 + i}\n  return Point(p[1], p[2])\nend)(PenShape, A, B, PenHead, 4)" },
						S5 = Input { Expression = "(function(s, A, B, H, i)\n  local P\n  if s == 6 then P = {{-A, 0}, {A, 0}, {A, 0}, {A - H*0.883, H*0.469}, {A, 0}, {A - H*0.883, -H*0.469}}\n  elseif s == 7 then P = {{-A, 0}, {-0.3*A, -B}, {-0.3*A, -B}, {A, B}}\n  elseif s == 8 then P = {{-A, B}, {A, -B}, {A, B}, {-A, -B}}\n  else P = {{-A, 0}, {A, 0}} end\n  local p = P[i] or {99, 99 + i}\n  return Point(p[1], p[2])\nend)(PenShape, A, B, PenHead, 5)" },
						S6 = Input { Expression = "(function(s, A, B, H, i)\n  local P\n  if s == 6 then P = {{-A, 0}, {A, 0}, {A, 0}, {A - H*0.883, H*0.469}, {A, 0}, {A - H*0.883, -H*0.469}}\n  elseif s == 7 then P = {{-A, 0}, {-0.3*A, -B}, {-0.3*A, -B}, {A, B}}\n  elseif s == 8 then P = {{-A, B}, {A, -B}, {A, B}, {-A, -B}}\n  else P = {{-A, 0}, {A, 0}} end\n  local p = P[i] or {99, 99 + i}\n  return Point(p[1], p[2])\nend)(PenShape, A, B, PenHead, 6)" },
						GlobalIn = Input { Value = -480 },
						Width = Input { Value = 1920 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Height = Input { Value = 1080 },
						PenFrom = Input { Value = { 0.3, 0.3 } },
						TopLeftAlpha = Input { Value = 0 },
						PenTo = Input { Value = { 0.6, 0.6 } },
						B = Input { Expression = "PenH/2" },
						GlobalOut = Input { Value = 3534 },
						Mid = Input { Expression = "iif(PenShape == 6, Point((PenFrom.X + PenTo.X)/2, (PenFrom.Y + PenTo.Y)/2), Point(PenPos.X, PenPos.Y))" },
						UseFrameFormatSettings = Input { Value = 1 },
						A = Input { Expression = "iif(PenShape == 6, math.sqrt(((PenTo.X - PenFrom.X)*(comp:GetPrefs('Comp.FrameFormat.Width')/comp:GetPrefs('Comp.FrameFormat.Height')))^2 + (PenTo.Y - PenFrom.Y)^2)/2, PenW/2)" },
						Ang = Input { Expression = "iif(PenShape == 6, math.deg(math.atan2(PenTo.Y - PenFrom.Y, (PenTo.X - PenFrom.X)*(comp:GetPrefs('Comp.FrameFormat.Width')/comp:GetPrefs('Comp.FrameFormat.Height')))), PenAngle)" },
						D = Input { Expression = "PenPasses * iif(PenDraw <= 0, 1, 1 - (1 - min(max((time - comp.RenderStart + 1)/(PenDraw*iif(FpsOverride > 0, FpsOverride, comp:GetPrefs('Comp.FrameFormat.Rate') or 24)), 0), 1))^1.5)" },
						E = Input { Expression = "iif(PenExit == 1 and PenOut > 0, 1 - min(max((comp.RenderEnd - time)/(PenOut*iif(FpsOverride > 0, FpsOverride, comp:GetPrefs('Comp.FrameFormat.Rate') or 24)), 0), 1), 0)" },
						Fade = Input { Expression = "iif(PenExit == 0 and PenOut > 0, min(max((comp.RenderEnd - time + 1)/(PenOut*iif(FpsOverride > 0, FpsOverride, comp:GetPrefs('Comp.FrameFormat.Rate') or 24)), 0), 1), 1)" },
						Split = Input { Expression = "iif(PenShape == 6, 0.75, iif(PenShape == 7, 0.3, iif(PenShape == 8, 0.5, 1)))" },
						S1 = Input { Expression = "(function(s, A, B, H, i)\n  local P\n  if s == 6 then P = {{-A, 0}, {A, 0}, {A, 0}, {A - H*0.883, H*0.469}, {A, 0}, {A - H*0.883, -H*0.469}}\n  elseif s == 7 then P = {{-A, 0}, {-0.3*A, -B}, {-0.3*A, -B}, {A, B}}\n  elseif s == 8 then P = {{-A, B}, {A, -B}, {A, B}, {-A, -B}}\n  else P = {{-A, 0}, {A, 0}} end\n  local p = P[i] or {99, 99 + i}\n  return Point(p[1], p[2])\nend)(PenShape, A, B, PenHead, 1)" },
						S2 = Input { Expression = "(function(s, A, B, H, i)\n  local P\n  if s == 6 then P = {{-A, 0}, {A, 0}, {A, 0}, {A - H*0.883, H*0.469}, {A, 0}, {A - H*0.883, -H*0.469}}\n  elseif s == 7 then P = {{-A, 0}, {-0.3*A, -B}, {-0.3*A, -B}, {A, B}}\n  elseif s == 8 then P = {{-A, B}, {A, -B}, {A, B}, {-A, -B}}\n  else P = {{-A, 0}, {A, 0}} end\n  local p = P[i] or {99, 99 + i}\n  return Point(p[1], p[2])\nend)(PenShape, A, B, PenHead, 2)" }
					},
					UserControls = {
						PenStart = {

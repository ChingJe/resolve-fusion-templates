				},
				PenFloat = Background {
					ViewInfo = OperatorInfo { Pos = { -605, -16.5 } },
					Inputs = {
						Height = Input {
							Value = 1080,
							Expression = "comp:GetPrefs('Comp.FrameFormat.Height')/2"
						},
						TopLeftAlpha = Input { Value = 0 },
						Width = Input {
							Value = 1920,
							Expression = "comp:GetPrefs('Comp.FrameFormat.Width')/2"
						},
						GlobalIn = Input { Value = -480 },

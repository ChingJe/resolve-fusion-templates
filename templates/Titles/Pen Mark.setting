					}
				},
				PenWarp2 = Custom {
					ViewInfo = OperatorInfo { Pos = { -495, 115.5 } },
					Inputs = {
						Intermediate3 = Input { Value = "min(max((i1 + n6)/(2*n6), 0), 1)" },
						RedExpression = Input { Value = "i1 + n2*n4*(sin(i1/n4*190 + i2/n4*110 + n3*97) + 0.5*sin(i1/n4*430 - i2/n4*310 + n3*211))" },
						GreenExpression = Input { Value = "i2 + n2*n4*(sin(i2/n4*170 - i1/n4*130 + n3*133) + 0.5*sin(i2/n4*390 + i1/n4*290 + n3*57)) - n5*8*n6*i3*(1 - i3) - n7*sin(i3*360*n8)" },
						BlueExpression = Input { Value = "0" },
						Image1 = Input {
							SourceOp = "PenFloat",
							Source = "Output"
						},
						AlphaExpression = Input { Value = "0" },
						PointIn1 = Input { Expression = "PenCtrl.Mid" },
						NumberIn1 = Input { Expression = "PenCtrl.Ang" },
						LUTIn1 = Input {
							SourceOp = "CustomTool1LUTIn14",
							Source = "Value"
						},
						LUTIn2 = Input {
							SourceOp = "CustomTool1LUTIn24",
							Source = "Value"
						},

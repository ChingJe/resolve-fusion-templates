							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					},
					SplineColor = { Blue = 0, Red = 0, Green = 0 }
				},
				CntDrop = Shadow {
					Inputs = {
						ShadowOffset = Input { Expression = "Point(0.5 + CountCtrl.LkDist, 0.5 - CountCtrl.LkDist*(comp:GetPrefs('Comp.FrameFormat.Width')/comp:GetPrefs('Comp.FrameFormat.Height')))" },
						Softness = Input { Expression = "CountCtrl.LkSoft" },
						Alpha = Input { Expression = "CountCtrl.LkShadow" },
						Input = Input {
							Source = "Output",
							SourceOp = "CntInk"
						}
					},
					ViewInfo = OperatorInfo { Pos = { 275, 16.5 } }

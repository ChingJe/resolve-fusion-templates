{
	Tools = ordered() {
		NumberCounter = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "CountCtrl", Source = "CntNow", Name = "Number (keyframe this)" },
				Input2 = InstanceInput { SourceOp = "CountCtrl", Source = "CntDecimals", Name = "Decimals" },
				Input3 = InstanceInput { SourceOp = "CountCtrl", Source = "CntSep", Name = "Thousands Separator" },
				Input4 = InstanceInput { SourceOp = "CountCtrl", Source = "CntPrefix", Name = "Prefix" },
				Input5 = InstanceInput { SourceOp = "CountCtrl", Source = "CntSuffix", Name = "Suffix" },
				Input6 = InstanceInput { SourceOp = "CountCtrl", Source = "CntPop", Name = "Pop" },
				Input7 = InstanceInput { SourceOp = "CountCtrl", Source = "CntPopFr", Name = "Pop Frames" },
				Input8 = InstanceInput { SourceOp = "CountCtrl", Source = "CntPos", Name = "Position" },
				Input9 = InstanceInput { SourceOp = "LkFont", Source = "Font", Name = "Font", ControlGroup = 30 },
				Input10 = InstanceInput { SourceOp = "LkFont", Source = "Style", ControlGroup = 30 },
				Input11 = InstanceInput { SourceOp = "CountCtrl", Source = "LkSize", Name = "Size" },
				Input12 = InstanceInput { SourceOp = "CountCtrl", Source = "LkTrack", Name = "Letter Spacing" },
				Input13 = InstanceInput { SourceOp = "LkCol", Source = "TopLeftRed", Name = "Colour", ControlGroup = 31 },
				Input14 = InstanceInput { SourceOp = "LkCol", Source = "TopLeftGreen", ControlGroup = 31 },
				Input15 = InstanceInput { SourceOp = "LkCol", Source = "TopLeftBlue", ControlGroup = 31 },
				Input16 = InstanceInput { SourceOp = "CountCtrl", Source = "LkEdge", Name = "Outline" },
				Input17 = InstanceInput { SourceOp = "LkColEdge", Source = "TopLeftRed", Name = "Outline Colour", ControlGroup = 32 },
				Input18 = InstanceInput { SourceOp = "LkColEdge", Source = "TopLeftGreen", ControlGroup = 32 },
				Input19 = InstanceInput { SourceOp = "LkColEdge", Source = "TopLeftBlue", ControlGroup = 32 },
				Input20 = InstanceInput { SourceOp = "CountCtrl", Source = "LkOuter", Name = "Outer Outline" },
				Input21 = InstanceInput { SourceOp = "LkColOuter", Source = "TopLeftRed", Name = "Outer Outline Colour", ControlGroup = 33 },
				Input22 = InstanceInput { SourceOp = "LkColOuter", Source = "TopLeftGreen", ControlGroup = 33 },
				Input23 = InstanceInput { SourceOp = "LkColOuter", Source = "TopLeftBlue", ControlGroup = 33 },
				Input24 = InstanceInput { SourceOp = "CountCtrl", Source = "LkShadow", Name = "Shadow" },
				Input25 = InstanceInput { SourceOp = "CountCtrl", Source = "LkDist", Name = "Shadow Distance" },
				Input26 = InstanceInput { SourceOp = "CountCtrl", Source = "LkSoft", Name = "Shadow Softness" },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "CntFinal", Source = "Output" }
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				CountCtrl = Background {
					CtrlWZoom = false,
					Inputs = {
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						UseFrameFormatSettings = Input { Value = 1 },
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						Bump = Input { Expression = "(function(now, t0, d, pop, fr)\n  local function shown(t) return math.floor(CountCtrl:GetValue(\"CntNow\", t) * 10^d + 0.5) end\n  local cur, since = shown(now), fr\n  for k = 1, fr do\n    if now - k < t0 then break end\n    if shown(now - k) ~= cur then since = k - 1 break end\n  end\n  local t = since / fr\n  if t >= 1 then return 0 end\n  return pop * ((t < 0.2) and t/0.2 or ((1 - t)/0.8)^2)\nend)(time, comp.RenderStart, CntDecimals, CntPop, max(floor(CntPopFr), 2))" },
						GlobalIn = Input { Value = -480 },
						TopLeftAlpha = Input { Value = 0 }
					},
					UserControls = {
						CntNow = {
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Number (keyframe this)",
							INP_Default = 100,
							INP_MinScale = 0,
							INP_MaxScale = 1000
						},
						LkSize = {

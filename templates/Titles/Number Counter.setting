							INP_MinScale = 0,
							INP_MaxScale = 3
						},
						Bump = {
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Bump",
							INP_Default = 0,

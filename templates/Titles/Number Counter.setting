{
	Tools = ordered() {
		NumberCounter = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "CountCtrl", Source = "CntMode", Name = "Counts" },
				Input2 = InstanceInput { SourceOp = "CountCtrl", Source = "CntStart", Name = "Start Value" },
				Input3 = InstanceInput { SourceOp = "CountCtrl", Source = "CntEnd", Name = "End Value" },
				Input4 = InstanceInput { SourceOp = "CountCtrl", Source = "CntDecimals", Name = "Decimals" },
				Input5 = InstanceInput { SourceOp = "CountCtrl", Source = "CntSep", Name = "Thousands Separator" },
				Input6 = InstanceInput { SourceOp = "CountCtrl", Source = "CntPrefix", Name = "Prefix" },
				Input7 = InstanceInput { SourceOp = "CountCtrl", Source = "CntSuffix", Name = "Suffix" },
				Input8 = InstanceInput { SourceOp = "CountCtrl", Source = "CntFinish", Name = "Count Finishes At" },
				Input9 = InstanceInput { SourceOp = "CountCtrl", Source = "CntTimes", Name = "Step Times (0:02, one per line)" },
				Input10 = InstanceInput { SourceOp = "CountCtrl", Source = "CntStep", Name = "Each Step Adds" },
				Input11 = InstanceInput { SourceOp = "CountCtrl", Source = "CntPopTime", Name = "Step Pop (seconds)" },
				Input12 = InstanceInput { SourceOp = "CountCtrl", Source = "CntPop", Name = "Pop" },
				Input13 = InstanceInput { SourceOp = "CountCtrl", Source = "CntSize", Name = "Size" },
				Input14 = InstanceInput { SourceOp = "Number", Source = "Font", Name = "Font", ControlGroup = 2 },
				Input15 = InstanceInput { SourceOp = "Number", Source = "Style", ControlGroup = 2 },
				Input16 = InstanceInput { SourceOp = "Number", Source = "Red1", Name = "Color", ControlGroup = 3 },
				Input17 = InstanceInput { SourceOp = "Number", Source = "Green1", ControlGroup = 3 },
				Input18 = InstanceInput { SourceOp = "Number", Source = "Blue1", ControlGroup = 3 },
				Input19 = InstanceInput { SourceOp = "Number", Source = "Center", Name = "Position" },
				Input20 = InstanceInput { SourceOp = "CountCtrl", Source = "FpsOverride", Name = "Frame Rate Override" },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Number", Source = "Output" }
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				CountCtrl = Background {
					Inputs = {
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Bump = Input { Expression = "iif(CntMode == 1, CntPop * (1 - min(Tal.Y/max(CntPopTime, 0.01), 1))^2, CntPop * sin(3.14159265 * min(max((P - CntFinish)/0.06, 0), 1)))" },
						Tal = Input { Expression = "(function(txt, fps, len, ts)\n  local n, last = 0, -1\n  for stamp in txt:gmatch(\"[^%s,]+\") do\n    local sec\n    local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n    if pct then sec = tonumber(pct) / 100 * len / fps\n    elseif fr then sec = tonumber(fr) / fps\n    elseif stamp:match(\"^[%d:%.]+$\") then\n      sec = 0\n      for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n    end\n    if sec and sec <= ts + 0.0001 then n = n + 1 if sec > last then last = sec end end\n  end\n  return Point(n, last < 0 and 999 or ts - last)\nend)(CntTimes.Value, iif(FpsOverride > 0, FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24),\n  max(comp.RenderEnd - comp.RenderStart, 1),\n  (time - comp.RenderStart) / iif(FpsOverride > 0, FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24))" },
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						UseFrameFormatSettings = Input { Value = 1 },
						P = Input { Expression = "min(max((time - comp.RenderStart) / max(comp.RenderEnd - comp.RenderStart, 1), 0), 1)" },
						V = Input { Expression = "iif(CntMode == 1, CntStart + CntStep*Tal.X, CntStart + (CntEnd - CntStart) * (1 - (1 - min(P/CntFinish, 1))^3))" },
						TopLeftAlpha = Input { Value = 0 },
						GlobalIn = Input { Value = -480 },
						GlobalOut = Input { Value = 3534 }
					},
					ViewInfo = OperatorInfo { Pos = { -495, -82.5 } },
					UserControls = {
						CntMode = {
							{
								CCS_AddString = "Smoothly To The End Value"
							},
							{
								CCS_AddString = "One Step At Each Listed Time"
							},
							INP_Integer = true,
							LINKID_DataType = "Number",
							INPID_InputControl = "ComboControl",
							LINKS_Name = "Counts",
							INP_Default = 0,
							ICS_ControlPage = "Controls"
						},
						Bump = {
							INP_MaxScale = 1,
							INP_Integer = false,
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							ICS_ControlPage = "Driver",
							LINKS_Name = "Bump",
							INP_Default = 0,
							INP_MinScale = 0
						},
						Tal = {
							LINKID_DataType = "Point",
							LINKS_Name = "Tal",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "OffsetControl"
						},
						CntStart = {
							INP_MaxScale = 1000,
							INP_Integer = false,
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							ICS_ControlPage = "Controls",
							LINKS_Name = "Start Value",
							INP_Default = 0,
							INP_MinScale = 0
						},
						CntEnd = {
							INP_MaxScale = 100000,
							INP_Integer = false,
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							ICS_ControlPage = "Controls",
							LINKS_Name = "End Value",
							INP_Default = 12500,
							INP_MinScale = 0
						},
						CntDecimals = {
							INP_MaxScale = 3,
							INP_Integer = true,
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							ICS_ControlPage = "Controls",
							LINKS_Name = "Decimals",
							INP_Default = 0,
							INP_MinScale = 0
						},
						P = {
							INP_MaxScale = 1,
							INP_Integer = false,
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							ICS_ControlPage = "Driver",
							LINKS_Name = "P",
							INP_Default = 0,
							INP_MinScale = 0
						},
						CntSep = {
							INP_Integer = true,
							LINKID_DataType = "Number",
							INPID_InputControl = "CheckboxControl",
							LINKS_Name = "Thousands Separator",
							INP_Default = 1,
							ICS_ControlPage = "Controls"
						},
						V = {
							INP_MaxScale = 100000,
							INP_Integer = false,
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							ICS_ControlPage = "Driver",
							LINKS_Name = "V",
							INP_Default = 0,
							INP_MinScale = 0
						},
						CntPrefix = {
							TEC_Lines = 1,
							LINKID_DataType = "Text",
							INPID_InputControl = "TextEditControl",
							LINKS_Name = "Prefix",
							ICS_ControlPage = "Controls",
							INPS_DefaultText = ""
						},
						CntSuffix = {
							TEC_Lines = 1,
							LINKID_DataType = "Text",
							INPID_InputControl = "TextEditControl",
							LINKS_Name = "Suffix",
							ICS_ControlPage = "Controls",
							INPS_DefaultText = ""
						},
						CntFinish = {
							INP_MaxScale = 1,
							INP_Integer = false,
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							ICS_ControlPage = "Controls",
							LINKS_Name = "Count Finishes At",
							INP_Default = 0.7,
							INP_MinScale = 0.05
						},
						CntTimes = {
							TEC_Lines = 6,
							LINKID_DataType = "Text",
							INPID_InputControl = "TextEditControl",
							LINKS_Name = "Step Times (0:02, one per line)",
							ICS_ControlPage = "Controls",
							INPS_DefaultText = "20%\n40%\n60%\n80%"
						},
						CntStep = {
							INP_MaxScale = 10,
							INP_Integer = false,
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							ICS_ControlPage = "Controls",
							LINKS_Name = "Each Step Adds",
							INP_Default = 1,
							INP_MinScale = -10
						},
						CntPopTime = {
							INP_MaxScale = 1,
							INP_Integer = false,
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							ICS_ControlPage = "Controls",
							LINKS_Name = "Step Pop (seconds)",
							INP_Default = 0.25,
							INP_MinScale = 0.02
						},
						FpsOverride = {
							INP_MaxScale = 120,
							INP_Integer = false,
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							ICS_ControlPage = "Controls",
							LINKS_Name = "Frame Rate Override",
							INP_Default = 0,
							INP_MinScale = 0
						},
						CntPop = {
							INP_MaxScale = 0.5,
							INP_Integer = false,
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							ICS_ControlPage = "Controls",
							LINKS_Name = "Pop",
							INP_Default = 0.12,
							INP_MinScale = 0
						},
						CntSize = {
							INP_MaxScale = 0.5,
							INP_Integer = false,
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							ICS_ControlPage = "Controls",
							LINKS_Name = "Size",
							INP_Default = 0.18,
							INP_MinScale = 0.02
						}
					}
				},
				Number = TextPlus {
					Inputs = {
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Style = Input { Value = "Bold" },
						Font = Input { Value = "Open Sans" },
						StyledText = Input { Expression = "Text(CountCtrl.CntPrefix.Value .. (function(v, d, sep)\n  local s = string.format(\"%.\" .. d .. \"f\", v)\n  local whole, rest = s:match(\"^(-?%d+)(.*)$\")\n  if sep == 1 then whole = whole:reverse():gsub(\"(%d%d%d)\", \"%1,\"):reverse():gsub(\"^(-?),\", \"%1\") end\n  return whole .. rest\nend)(CountCtrl.V, CountCtrl.CntDecimals, CountCtrl.CntSep) .. CountCtrl.CntSuffix.Value)" },
						Size = Input { Expression = "CountCtrl.CntSize * (1 + CountCtrl.Bump)" },
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						Wrap = Input { Value = 1 },
						UseFrameFormatSettings = Input { Value = 1 },
						TransformRotation = Input { Value = 1 },
						Softness1 = Input { Value = 1 },
						VerticalJustificationNew = Input { Value = 3 },
						HorizontalJustificationNew = Input { Value = 3 },
						GlobalIn = Input { Value = -480 },
						LayoutRotation = Input { Value = 1 },
						GlobalOut = Input { Value = 3534 }
					},
					Version = 1,
					ViewInfo = OperatorInfo { Pos = { -275, 16.5 } }
				}
			
			}
		}
	},
	ActiveTool = "NumberCounter"
}

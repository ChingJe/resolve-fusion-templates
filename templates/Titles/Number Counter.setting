						TopLeftGreen = Input { Value = 1 }
					},
					ViewInfo = OperatorInfo { Pos = { -385, -181.5 } }
				},
				CntText = TextPlus {
					Inputs = {
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Font = Input {
							Expression = "LkFont.Font",
							Value = "Microsoft JhengHei"
						},
						Wrap = Input { Value = 1 },
						Style = Input {
							Expression = "LkFont.Style",
							Value = "Bold"
						},
						TransformRotation = Input { Value = 1 },
						Softness1 = Input { Value = 1 },
						VerticalJustificationNew = Input { Value = 3 },
						HorizontalJustificationNew = Input { Value = 3 },
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						CharacterSpacing = Input { Expression = "CountCtrl.LkTrack" },
						UseFrameFormatSettings = Input { Value = 1 },
						Center = Input { Expression = "CountCtrl.CntPos" },
						StyledText = Input { Expression = "Text(CountCtrl.CntPrefix.Value .. (function(v, d, sep)\n  local s = string.format(\"%.\" .. d .. \"f\", v)\n  local whole, rest = s:match(\"^(-?%d+)(.*)$\")\n  if sep == 1 then whole = whole:reverse():gsub(\"(%d%d%d)\", \"%1,\"):reverse():gsub(\"^(-?),\", \"%1\") end\n  return whole .. rest\nend)(CountCtrl.CntNow, CountCtrl.CntDecimals, CountCtrl.CntSep) .. CountCtrl.CntSuffix.Value)" },
						GlobalIn = Input { Value = -480 },
						Size = Input { Expression = "CountCtrl.LkSize * (1 + CountCtrl.Bump)" },
						LayoutRotation = Input { Value = 1 }
					},
					Version = 1,
					ViewInfo = OperatorInfo { Pos = { -275, 16.5 } }
				},
				CntInkRoom = SetDomain {
					Inputs = {
						Mode = Input { Value = FuID { "Set" } },
						Input = Input {
							Source = "Output",
							SourceOp = "CntText"
						}
					},
					ViewInfo = OperatorInfo { Pos = { -55, 16.5 } }
				},
				CntInkGrowB = ErodeDilate {
					Inputs = {
						XAmount = Input { Expression = "(CountCtrl.LkEdge) + (CountCtrl.LkOuter)" },
						Input = Input {
							Source = "Output",
							SourceOp = "CntInkRoom"
						},
						Filter = Input { Value = 3 }
					},
					ViewInfo = OperatorInfo { Pos = { 55, 82.5 } }
				},
				CntInkGrowA = ErodeDilate {
					Inputs = {
						XAmount = Input { Expression = "CountCtrl.LkEdge" },
						Input = Input {
							Source = "Output",
							SourceOp = "CntInkRoom"
						},
						Filter = Input { Value = 3 }
					},
					ViewInfo = OperatorInfo { Pos = { 55, 49.5 } }
				},
				CntInk = Custom {
					Inputs = {
						Intermediate2 = Input { Value = "a3*n8" },
						RedExpression = Input { Value = "n1*a1 + (1 - a1)*(n4*i1 + (1 - i1)*p1x*i2)" },
						NumberIn1 = Input { Expression = "LkCol.TopLeftRed" },
						GreenExpression = Input { Value = "n2*a1 + (1 - a1)*(n5*i1 + (1 - i1)*p1y*i2)" },
						NumberIn2 = Input { Expression = "LkCol.TopLeftGreen" },
						BlueExpression = Input { Value = "n3*a1 + (1 - a1)*(n6*i1 + (1 - i1)*p2x*i2)" },
						NumberIn3 = Input { Expression = "LkCol.TopLeftBlue" },
						AlphaExpression = Input { Value = "a1 + (1 - a1)*(i1 + (1 - i1)*i2)" },
						NumberIn4 = Input { Expression = "LkColEdge.TopLeftRed" },
						NumberIn5 = Input { Expression = "LkColEdge.TopLeftGreen" },
						NumberIn6 = Input { Expression = "LkColEdge.TopLeftBlue" },
						LUTIn1 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn1"
						},
						LUTIn2 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn2"
						},
						LUTIn3 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn3"
						},
						LUTIn4 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn4"
						},
						Image3 = Input {
							Source = "Output",
							SourceOp = "CntInkGrowB"
						},
						PointIn1 = Input { Expression = "Point(LkColOuter.TopLeftRed, LkColOuter.TopLeftGreen)" },
						PointIn2 = Input { Expression = "Point(LkColOuter.TopLeftBlue, 0)" },
						NumberIn7 = Input { Expression = "iif((CountCtrl.LkEdge) > 0, 1, 0)" },
						Image2 = Input {
							Source = "Output",
							SourceOp = "CntInkGrowA"
						},
						Image1 = Input {
							Source = "Output",
							SourceOp = "CntInkRoom"
						},
						NumberIn8 = Input { Expression = "iif((CountCtrl.LkOuter) > 0, 1, 0)" },
						Intermediate1 = Input { Value = "a2*n7" }
					},
					ViewInfo = OperatorInfo { Pos = { 165, 16.5 } }
				},
				CustomTool1LUTIn1 = LUTBezier {
					NameSet = true,
					CtrlWZoom = false,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					},
					SplineColor = { Blue = 0, Red = 0, Green = 0 }
				},
				CustomTool1LUTIn2 = LUTBezier {

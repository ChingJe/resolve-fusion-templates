							LINKID_DataType = "Number",
							LINKS_Name = "Draw",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Integer = false,
							ICS_ControlPage = "Driver"
						},
						From = {
							INPID_InputControl = "OffsetControl",
							LINKID_DataType = "Point",
							LINKS_Name = "From",
							ICS_ControlPage = "Driver"
						},
						To = {
							INPID_InputControl = "OffsetControl",
							LINKID_DataType = "Point",
							LINKS_Name = "To",
							ICS_ControlPage = "Driver"
						},
						HeadA = {
							INPID_InputControl = "OffsetControl",
							LINKID_DataType = "Point",
							LINKS_Name = "HeadA",
							ICS_ControlPage = "Driver"
						},
						HeadB = {
							INPID_InputControl = "OffsetControl",
							LINKID_DataType = "Point",
							LINKS_Name = "HeadB",
							ICS_ControlPage = "Driver"
						},
						NoteTarget = {
							INPID_InputControl = "OffsetControl",
							INPID_PreviewControl = "CrosshairControl",
							LINKS_Name = "Arrow Points At",
							LINKID_DataType = "Point",
							ICS_ControlPage = "Controls"
						},
						Back = {
							INPID_InputControl = "SliderControl",
							LINKID_DataType = "Number",
							LINKS_Name = "Back",
							INP_Default = 0,
							INP_MinScale = 0,

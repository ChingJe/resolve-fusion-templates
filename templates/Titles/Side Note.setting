							INP_Default = 0.05,
							INP_MinScale = 0.01,
							INP_MaxScale = 0.2,
							INP_Integer = false,
							ICS_ControlPage = "Controls"
						},
						Fade = {
							INPID_InputControl = "SliderControl",
							LINKID_DataType = "Number",
							LINKS_Name = "Fade",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Integer = false,

							LINKID_DataType = "Number",
							LINKS_Name = "Since",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 100,
							INP_Integer = false,
							ICS_ControlPage = "Driver"
						},
						FpsOverride = {

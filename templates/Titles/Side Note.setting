{
	Tools = ordered() {
		SideNote = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "NoteCtrl", Source = "NoteList", Name = "Remarks" },
				Input2 = InstanceInput { SourceOp = "NoteCtrl", Source = "NoteCue", Name = "Line Number (keyframe 1, 2, 3)" },
				Input3 = InstanceInput { SourceOp = "NoteCtrl", Source = "NoteTimed", Name = "Lines Start With A Time (0:02 Text)" },
				Input4 = InstanceInput { SourceOp = "NoteCtrl", Source = "FpsOverride", Name = "Frame Rate Override" },
				Input5 = InstanceInput { SourceOp = "NoteText", Source = "Font", Name = "Font", ControlGroup = 2 },
				Input6 = InstanceInput { SourceOp = "NoteText", Source = "Style", ControlGroup = 2 },
				Input7 = InstanceInput { SourceOp = "NoteCtrl", Source = "NoteSize", Name = "Size" },
				Input8 = InstanceInput { SourceOp = "NoteCtrl", Source = "NoteTilt", Name = "Tilt" },
				Input9 = InstanceInput { SourceOp = "NoteCtrl", Source = "NotePos", Name = "Text Position" },
				Input10 = InstanceInput { SourceOp = "NoteCtrl", Source = "NoteTarget", Name = "Arrow Points At" },
				Input11 = InstanceInput { SourceOp = "NoteCtrl", Source = "NoteArrow", Name = "Arrow" },
				Input12 = InstanceInput { SourceOp = "NoteCtrl", Source = "NoteBend", Name = "Arrow Bend" },
				Input13 = InstanceInput { SourceOp = "NoteCtrl", Source = "NoteThick", Name = "Arrow Thickness" },
				Input14 = InstanceInput { SourceOp = "NoteCtrl", Source = "NoteHead", Name = "Arrow Head" },
				Input15 = InstanceInput { SourceOp = "NoteCtrl", Source = "NoteShort", Name = "Arrow Stops Short" },
				Input16 = InstanceInput { SourceOp = "ColInk", Source = "TopLeftRed", Name = "Color", ControlGroup = 3 },
				Input17 = InstanceInput { SourceOp = "ColInk", Source = "TopLeftGreen", ControlGroup = 3 },
				Input18 = InstanceInput { SourceOp = "ColInk", Source = "TopLeftBlue", ControlGroup = 3 },
				Input19 = InstanceInput { SourceOp = "ColEdge", Source = "TopLeftRed", Name = "Outline Color", ControlGroup = 4 },
				Input20 = InstanceInput { SourceOp = "ColEdge", Source = "TopLeftGreen", ControlGroup = 4 },
				Input21 = InstanceInput { SourceOp = "ColEdge", Source = "TopLeftBlue", ControlGroup = 4 },
				Input22 = InstanceInput { SourceOp = "NoteCtrl", Source = "NoteEdge", Name = "Outline" },
				Input23 = InstanceInput { SourceOp = "NoteCtrl", Source = "NoteIn", Name = "Pop Frames" },
				Input24 = InstanceInput { SourceOp = "NoteCtrl", Source = "NoteDraw", Name = "Arrow Draw Frames" },
				Input25 = InstanceInput { SourceOp = "NoteCtrl", Source = "NoteOut", Name = "Fade Out Frames" },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "NoteOut", Source = "Output" }
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				NoteCtrl = Background {
					Inputs = {
						TopLeftAlpha = Input { Value = 0 },
						Height = Input { Value = 1080 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Idx = Input { Expression = "(function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(NoteCtrl:GetValue(\"NoteCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(NoteCtrl:GetValue(\"NoteCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(NoteCtrl.NoteList.Value, NoteCtrl.NoteTimed, NoteCtrl.NoteCue, iif(NoteCtrl.FpsOverride > 0, NoteCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 1)" },
						Since = Input { Expression = "(function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(NoteCtrl:GetValue(\"NoteCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(NoteCtrl:GetValue(\"NoteCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(NoteCtrl.NoteList.Value, NoteCtrl.NoteTimed, NoteCtrl.NoteCue, iif(NoteCtrl.FpsOverride > 0, NoteCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 2)" },
						Until = Input { Expression = "(function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(NoteCtrl:GetValue(\"NoteCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(NoteCtrl:GetValue(\"NoteCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(NoteCtrl.NoteList.Value, NoteCtrl.NoteTimed, NoteCtrl.NoteCue, iif(NoteCtrl.FpsOverride > 0, NoteCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 3)" },
						T = Input { Expression = "iif(Idx < 1, 0, min(max((Since + 1)/max(NoteIn, 1), 0), 1))" },
						Back = Input { Expression = "(function(t) t = t - 1 return 1 + 2.70158*t*t*t + 1.70158*t*t end)(T)" },
						Fade = Input { Expression = "iif(Idx < 1, 0, min(T*3, 1) * iif(NoteOut <= 0, 1, min(max(Until/NoteOut, 0), 1)))" },
						Draw = Input { Expression = "iif(Idx < 1, 0, min(max((Since + 1 - NoteIn)/max(NoteDraw, 1), 0), 1))" },
						From = Input { Expression = "(function(pick)\n  local asp = NoteText.Output.Width / NoteText.Output.Height\n  local px, py, tx, ty = NoteCtrl.NotePos.X, NoteCtrl.NotePos.Y, NoteCtrl.NoteTarget.X, NoteCtrl.NoteTarget.Y\n  local hw, hh = 0, 0\n  local d = NoteText.StyledText.Value ~= \"\" and NoteText.Output.DataWindow\n  if d then hw, hh = (d.right - d.left)/NoteText.Output.Width/2*asp, (d.top - d.bottom)/NoteText.Output.Height/2 end\n  local dx, dy = (tx - px)*asp, ty - py\n  local len = math.max(math.sqrt(dx*dx + dy*dy), 0.0001)\n  local pad = NoteCtrl.NoteSize*0.5\n  local k = math.min((hw + pad)/math.max(math.abs(dx), 0.0001), (hh + pad)/math.max(math.abs(dy), 0.0001), 0.8)\n  local ax, ay = px + dx*k/asp, py + dy*k\n  local bx, by = tx - dx/len*NoteCtrl.NoteShort/asp, ty - dy/len*NoteCtrl.NoteShort\n  if pick == 1 then return Point(ax, ay) elseif pick == 2 then return Point(bx, by) end\n  -- direction the arrow arrives from, then turned 28 degrees either way for the two strokes of the head\n  local ex, ey = (bx - ax)*asp, by - ay\n  local el = math.max(math.sqrt(ex*ex + ey*ey), 0.0001)\n  ex, ey = ex/el, ey/el\n  local s = NoteCtrl.NoteBend*math.pi\n  local vx, vy = -(ex - s*ey), -(ey + s*ex)\n  local vl = math.sqrt(vx*vx + vy*vy)\n  vx, vy = vx/vl, vy/vl\n  local a = math.rad(pick == 3 and 28 or -28)\n  return Point(vx*math.cos(a) - vy*math.sin(a), vx*math.sin(a) + vy*math.cos(a))\nend)(1)" },
						NotePos = Input { Value = { 0.74, 0.72 } },
						HeadA = Input { Expression = "(function(pick)\n  local asp = NoteText.Output.Width / NoteText.Output.Height\n  local px, py, tx, ty = NoteCtrl.NotePos.X, NoteCtrl.NotePos.Y, NoteCtrl.NoteTarget.X, NoteCtrl.NoteTarget.Y\n  local hw, hh = 0, 0\n  local d = NoteText.StyledText.Value ~= \"\" and NoteText.Output.DataWindow\n  if d then hw, hh = (d.right - d.left)/NoteText.Output.Width/2*asp, (d.top - d.bottom)/NoteText.Output.Height/2 end\n  local dx, dy = (tx - px)*asp, ty - py\n  local len = math.max(math.sqrt(dx*dx + dy*dy), 0.0001)\n  local pad = NoteCtrl.NoteSize*0.5\n  local k = math.min((hw + pad)/math.max(math.abs(dx), 0.0001), (hh + pad)/math.max(math.abs(dy), 0.0001), 0.8)\n  local ax, ay = px + dx*k/asp, py + dy*k\n  local bx, by = tx - dx/len*NoteCtrl.NoteShort/asp, ty - dy/len*NoteCtrl.NoteShort\n  if pick == 1 then return Point(ax, ay) elseif pick == 2 then return Point(bx, by) end\n  -- direction the arrow arrives from, then turned 28 degrees either way for the two strokes of the head\n  local ex, ey = (bx - ax)*asp, by - ay\n  local el = math.max(math.sqrt(ex*ex + ey*ey), 0.0001)\n  ex, ey = ex/el, ey/el\n  local s = NoteCtrl.NoteBend*math.pi\n  local vx, vy = -(ex - s*ey), -(ey + s*ex)\n  local vl = math.sqrt(vx*vx + vy*vy)\n  vx, vy = vx/vl, vy/vl\n  local a = math.rad(pick == 3 and 28 or -28)\n  return Point(vx*math.cos(a) - vy*math.sin(a), vx*math.sin(a) + vy*math.cos(a))\nend)(3)" },
						HeadB = Input { Expression = "(function(pick)\n  local asp = NoteText.Output.Width / NoteText.Output.Height\n  local px, py, tx, ty = NoteCtrl.NotePos.X, NoteCtrl.NotePos.Y, NoteCtrl.NoteTarget.X, NoteCtrl.NoteTarget.Y\n  local hw, hh = 0, 0\n  local d = NoteText.StyledText.Value ~= \"\" and NoteText.Output.DataWindow\n  if d then hw, hh = (d.right - d.left)/NoteText.Output.Width/2*asp, (d.top - d.bottom)/NoteText.Output.Height/2 end\n  local dx, dy = (tx - px)*asp, ty - py\n  local len = math.max(math.sqrt(dx*dx + dy*dy), 0.0001)\n  local pad = NoteCtrl.NoteSize*0.5\n  local k = math.min((hw + pad)/math.max(math.abs(dx), 0.0001), (hh + pad)/math.max(math.abs(dy), 0.0001), 0.8)\n  local ax, ay = px + dx*k/asp, py + dy*k\n  local bx, by = tx - dx/len*NoteCtrl.NoteShort/asp, ty - dy/len*NoteCtrl.NoteShort\n  if pick == 1 then return Point(ax, ay) elseif pick == 2 then return Point(bx, by) end\n  -- direction the arrow arrives from, then turned 28 degrees either way for the two strokes of the head\n  local ex, ey = (bx - ax)*asp, by - ay\n  local el = math.max(math.sqrt(ex*ex + ey*ey), 0.0001)\n  ex, ey = ex/el, ey/el\n  local s = NoteCtrl.NoteBend*math.pi\n  local vx, vy = -(ex - s*ey), -(ey + s*ex)\n  local vl = math.sqrt(vx*vx + vy*vy)\n  vx, vy = vx/vl, vy/vl\n  local a = math.rad(pick == 3 and 28 or -28)\n  return Point(vx*math.cos(a) - vy*math.sin(a), vx*math.sin(a) + vy*math.cos(a))\nend)(4)" },
						UseFrameFormatSettings = Input { Value = 1 },
						Width = Input { Value = 1920 },
						GlobalIn = Input { Value = -480 },
						To = Input { Expression = "(function(pick)\n  local asp = NoteText.Output.Width / NoteText.Output.Height\n  local px, py, tx, ty = NoteCtrl.NotePos.X, NoteCtrl.NotePos.Y, NoteCtrl.NoteTarget.X, NoteCtrl.NoteTarget.Y\n  local hw, hh = 0, 0\n  local d = NoteText.StyledText.Value ~= \"\" and NoteText.Output.DataWindow\n  if d then hw, hh = (d.right - d.left)/NoteText.Output.Width/2*asp, (d.top - d.bottom)/NoteText.Output.Height/2 end\n  local dx, dy = (tx - px)*asp, ty - py\n  local len = math.max(math.sqrt(dx*dx + dy*dy), 0.0001)\n  local pad = NoteCtrl.NoteSize*0.5\n  local k = math.min((hw + pad)/math.max(math.abs(dx), 0.0001), (hh + pad)/math.max(math.abs(dy), 0.0001), 0.8)\n  local ax, ay = px + dx*k/asp, py + dy*k\n  local bx, by = tx - dx/len*NoteCtrl.NoteShort/asp, ty - dy/len*NoteCtrl.NoteShort\n  if pick == 1 then return Point(ax, ay) elseif pick == 2 then return Point(bx, by) end\n  -- direction the arrow arrives from, then turned 28 degrees either way for the two strokes of the head\n  local ex, ey = (bx - ax)*asp, by - ay\n  local el = math.max(math.sqrt(ex*ex + ey*ey), 0.0001)\n  ex, ey = ex/el, ey/el\n  local s = NoteCtrl.NoteBend*math.pi\n  local vx, vy = -(ex - s*ey), -(ey + s*ex)\n  local vl = math.sqrt(vx*vx + vy*vy)\n  vx, vy = vx/vl, vy/vl\n  local a = math.rad(pick == 3 and 28 or -28)\n  return Point(vx*math.cos(a) - vy*math.sin(a), vx*math.sin(a) + vy*math.cos(a))\nend)(2)" }
					},
					UserControls = {
						NoteHead = {
							INPID_InputControl = "SliderControl",
							LINKID_DataType = "Number",
							LINKS_Name = "Arrow Head",
							INP_Default = 0.035,
							INP_MinScale = 0,
							INP_MaxScale = 0.15,
							INP_Integer = false,
							ICS_ControlPage = "Controls"
						},
						NoteShort = {
							INPID_InputControl = "SliderControl",
							LINKID_DataType = "Number",
							LINKS_Name = "Arrow Stops Short",
							INP_Default = 0.02,
							INP_MinScale = 0,
							INP_MaxScale = 0.2,
							INP_Integer = false,
							ICS_ControlPage = "Controls"
						},
						NoteList = {
							INPID_InputControl = "TextEditControl",
							LINKS_Name = "Remarks",
							INPS_DefaultText = "其實超怕的\n根本沒在聽",
							TEC_Lines = 6,
							LINKID_DataType = "Text",
							ICS_ControlPage = "Controls"
						},
						NoteTimed = {
							INPID_InputControl = "CheckboxControl",
							LINKS_Name = "Lines Start With A Time (0:02 Text)",
							INP_Default = 0,
							LINKID_DataType = "Number",
							INP_Integer = true,
							ICS_ControlPage = "Controls"
						},
						NoteCue = {
							INPID_InputControl = "SliderControl",
							LINKID_DataType = "Number",
							LINKS_Name = "Line Number (keyframe 1, 2, 3)",
							INP_Default = 1,
							INP_MinScale = 0,
							INP_MaxScale = 20,
							INP_Integer = false,
							ICS_ControlPage = "Controls"
						},
						NoteIn = {
							INPID_InputControl = "SliderControl",
							LINKID_DataType = "Number",
							LINKS_Name = "Pop Frames",
							INP_Default = 6,
							INP_MinScale = 1,
							INP_MaxScale = 40,
							INP_Integer = false,
							ICS_ControlPage = "Controls"
						},
						NoteDraw = {
							INPID_InputControl = "SliderControl",
							LINKID_DataType = "Number",
							LINKS_Name = "Arrow Draw Frames",
							INP_Default = 8,
							INP_MinScale = 1,
							INP_MaxScale = 60,
							INP_Integer = false,

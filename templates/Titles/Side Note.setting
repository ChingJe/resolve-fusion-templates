						},
						NoteThick = {
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Arrow Thickness",
							INP_Default = 0.007,
							INP_MinScale = 0.001,
							INP_MaxScale = 0.03
						},
						NoteHead = {
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Arrow Head",
							INP_Default = 0.035,
							INP_MinScale = 0,
							INP_MaxScale = 0.15
						},
						NoteShort = {
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Arrow Stops Short",
							INP_Default = 0.02,
							INP_MinScale = 0,
							INP_MaxScale = 0.2
						},
						NoteIn = {
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Pop Frames",
							INP_Default = 6,
							INP_MinScale = 1,
							INP_MaxScale = 40
						},
						NoteDraw = {
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Arrow Draw Frames",
							INP_Default = 8,
							INP_MinScale = 1,
							INP_MaxScale = 60
						},
						FpsOverride = {
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Frame Rate Override",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 120
						}
					},
					Inputs = {
						Idx = Input {
							Value = 1,
							Expression = "(function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(NoteCtrl:GetValue(\"NoteCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(NoteCtrl:GetValue(\"NoteCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(NoteCtrl.NoteList.Value, NoteCtrl.NoteTimed, NoteCtrl.NoteCue, iif(NoteCtrl.FpsOverride > 0, NoteCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 1)"
						},
						Since = Input {
							Value = 90,
							Expression = "(function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(NoteCtrl:GetValue(\"NoteCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(NoteCtrl:GetValue(\"NoteCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(NoteCtrl.NoteList.Value, NoteCtrl.NoteTimed, NoteCtrl.NoteCue, iif(NoteCtrl.FpsOverride > 0, NoteCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 2)"
						},
						Until = Input {
							Value = 9999,
							Expression = "(function(txt, timed, cue, fps, t0, t1, now, pick)\n  local idx, since, untl, text = 0, 0, 9999, \"\"\n  if timed == 0 then\n    idx = math.floor(cue + 0.0001)\n    for d = 1, 90 do\n      if now - d < t0 or math.floor(NoteCtrl:GetValue(\"NoteCue\", now - d) + 0.0001) ~= idx then break end\n      since = d\n    end\n    for d = 1, 60 do\n      if now + d > t1 then break end\n      if math.floor(NoteCtrl:GetValue(\"NoteCue\", now + d) + 0.0001) ~= idx then untl = d break end\n    end\n    local n = 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      if n == idx then text = line end\n    end\n  else\n    local rel, len, best, nxt, n = now - t0, math.max(t1 - t0, 1), -1, 1e9, 0\n    for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n      n = n + 1\n      local stamp, name = line:match(\"^%s*(%S+)%s*(.-)%s*$\")\n      local f\n      if stamp then\n        local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n        if pct then f = tonumber(pct) / 100 * len\n        elseif fr then f = tonumber(fr)\n        elseif stamp:match(\"^[%d:%.]+$\") then\n          local sec = 0\n          for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n          if sec then f = math.floor(sec * fps + 0.5) end\n        end\n      end\n      if f then\n        if f <= rel + 0.001 then\n          if f >= best then best, idx, text = f, n, name end\n        elseif f < nxt then nxt = f end\n      end\n    end\n    if best < 0 then idx, text = 0, \"\" else since, untl = rel - best, nxt - rel end\n  end\n  if pick == 1 then return idx elseif pick == 2 then return since elseif pick == 3 then return untl end\n  return text\nend)(NoteCtrl.NoteList.Value, NoteCtrl.NoteTimed, NoteCtrl.NoteCue, iif(NoteCtrl.FpsOverride > 0, NoteCtrl.FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), comp.RenderStart, comp.RenderEnd, time, 3)"
						},
						T = Input {
							Value = 1,
							Expression = "iif(Idx < 1, 0, min(max((Since + 1)/max(NoteIn, 1), 0), 1))"
						},
						Width = Input { Value = 1920 },
						Fade = Input {
							Value = 1,
							Expression = "iif(Idx < 1, 0, min(T*3, 1) * iif(NoteOut <= 0, 1, min(max(Until/NoteOut, 0), 1)))"
						},
						Draw = Input {
							Value = 1,
							Expression = "iif(Idx < 1, 0, min(max((Since + 1 - NoteIn)/max(NoteDraw, 1), 0), 1))"
						},
						From = Input {
							Value = { 0.670808080808081, 0.656574074074074 },
							Expression = "(function(pick)\n  local asp = NoteText.Output.Width / NoteText.Output.Height\n  local px, py, tx, ty = NoteCtrl.NotePos.X, NoteCtrl.NotePos.Y, NoteCtrl.NoteTarget.X, NoteCtrl.NoteTarget.Y\n  local hw, hh = 0, 0\n  local d = NoteText.StyledText.Value ~= \"\" and NoteText.Output.DataWindow\n  if d then hw, hh = (d.right - d.left)/NoteText.Output.Width/2*asp, (d.top - d.bottom)/NoteText.Output.Height/2 end\n  local dx, dy = (tx - px)*asp, ty - py\n  local len = math.max(math.sqrt(dx*dx + dy*dy), 0.0001)\n  local pad = NoteCtrl.LkSize*0.5\n  local k = math.min((hw + pad)/math.max(math.abs(dx), 0.0001), (hh + pad)/math.max(math.abs(dy), 0.0001), 0.8)\n  local ax, ay = px + dx*k/asp, py + dy*k\n  local bx, by = tx - dx/len*NoteCtrl.NoteShort/asp, ty - dy/len*NoteCtrl.NoteShort\n  if pick == 1 then return Point(ax, ay) elseif pick == 2 then return Point(bx, by) end\n  -- direction the arrow arrives from, then turned 28 degrees either way for the two strokes of the head\n  local ex, ey = (bx - ax)*asp, by - ay\n  local el = math.max(math.sqrt(ex*ex + ey*ey), 0.0001)\n  ex, ey = ex/el, ey/el\n  local s = NoteCtrl.NoteBend*math.pi\n  local vx, vy = -(ex - s*ey), -(ey + s*ex)\n  local vl = math.sqrt(vx*vx + vy*vy)\n  vx, vy = vx/vl, vy/vl\n  local a = math.rad(pick == 3 and 28 or -28)\n  return Point(vx*math.cos(a) - vy*math.sin(a), vx*math.sin(a) + vy*math.cos(a))\nend)(1)"
						},
						To = Input {
							Value = { 0.509999035633346, 0.5091657826639 },
							Expression = "(function(pick)\n  local asp = NoteText.Output.Width / NoteText.Output.Height\n  local px, py, tx, ty = NoteCtrl.NotePos.X, NoteCtrl.NotePos.Y, NoteCtrl.NoteTarget.X, NoteCtrl.NoteTarget.Y\n  local hw, hh = 0, 0\n  local d = NoteText.StyledText.Value ~= \"\" and NoteText.Output.DataWindow\n  if d then hw, hh = (d.right - d.left)/NoteText.Output.Width/2*asp, (d.top - d.bottom)/NoteText.Output.Height/2 end\n  local dx, dy = (tx - px)*asp, ty - py\n  local len = math.max(math.sqrt(dx*dx + dy*dy), 0.0001)\n  local pad = NoteCtrl.LkSize*0.5\n  local k = math.min((hw + pad)/math.max(math.abs(dx), 0.0001), (hh + pad)/math.max(math.abs(dy), 0.0001), 0.8)\n  local ax, ay = px + dx*k/asp, py + dy*k\n  local bx, by = tx - dx/len*NoteCtrl.NoteShort/asp, ty - dy/len*NoteCtrl.NoteShort\n  if pick == 1 then return Point(ax, ay) elseif pick == 2 then return Point(bx, by) end\n  -- direction the arrow arrives from, then turned 28 degrees either way for the two strokes of the head\n  local ex, ey = (bx - ax)*asp, by - ay\n  local el = math.max(math.sqrt(ex*ex + ey*ey), 0.0001)\n  ex, ey = ex/el, ey/el\n  local s = NoteCtrl.NoteBend*math.pi\n  local vx, vy = -(ex - s*ey), -(ey + s*ex)\n  local vl = math.sqrt(vx*vx + vy*vy)\n  vx, vy = vx/vl, vy/vl\n  local a = math.rad(pick == 3 and 28 or -28)\n  return Point(vx*math.cos(a) - vy*math.sin(a), vx*math.sin(a) + vy*math.cos(a))\nend)(2)"
						},
						HeadA = Input {
							Value = { 0.0912523100869087, 0.995827804343604 },
							Expression = "(function(pick)\n  local asp = NoteText.Output.Width / NoteText.Output.Height\n  local px, py, tx, ty = NoteCtrl.NotePos.X, NoteCtrl.NotePos.Y, NoteCtrl.NoteTarget.X, NoteCtrl.NoteTarget.Y\n  local hw, hh = 0, 0\n  local d = NoteText.StyledText.Value ~= \"\" and NoteText.Output.DataWindow\n  if d then hw, hh = (d.right - d.left)/NoteText.Output.Width/2*asp, (d.top - d.bottom)/NoteText.Output.Height/2 end\n  local dx, dy = (tx - px)*asp, ty - py\n  local len = math.max(math.sqrt(dx*dx + dy*dy), 0.0001)\n  local pad = NoteCtrl.LkSize*0.5\n  local k = math.min((hw + pad)/math.max(math.abs(dx), 0.0001), (hh + pad)/math.max(math.abs(dy), 0.0001), 0.8)\n  local ax, ay = px + dx*k/asp, py + dy*k\n  local bx, by = tx - dx/len*NoteCtrl.NoteShort/asp, ty - dy/len*NoteCtrl.NoteShort\n  if pick == 1 then return Point(ax, ay) elseif pick == 2 then return Point(bx, by) end\n  -- direction the arrow arrives from, then turned 28 degrees either way for the two strokes of the head\n  local ex, ey = (bx - ax)*asp, by - ay\n  local el = math.max(math.sqrt(ex*ex + ey*ey), 0.0001)\n  ex, ey = ex/el, ey/el\n  local s = NoteCtrl.NoteBend*math.pi\n  local vx, vy = -(ex - s*ey), -(ey + s*ex)\n  local vl = math.sqrt(vx*vx + vy*vy)\n  vx, vy = vx/vl, vy/vl\n  local a = math.rad(pick == 3 and 28 or -28)\n  return Point(vx*math.cos(a) - vy*math.sin(a), vx*math.sin(a) + vy*math.cos(a))\nend)(3)"

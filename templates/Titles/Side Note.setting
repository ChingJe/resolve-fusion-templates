							ICS_ControlPage = "Driver"
						},
						NoteEdge = {
							INPID_InputControl = "SliderControl",
							LINKID_DataType = "Number",
							LINKS_Name = "Outline",
							INP_Default = 0.003,
							INP_MinScale = 0,
							INP_MaxScale = 0.02,
							INP_Integer = false,
							ICS_ControlPage = "Controls"
						},
						Since = {

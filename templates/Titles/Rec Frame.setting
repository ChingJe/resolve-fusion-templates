					NameSet = true
				},
				CustomTool1LUTIn4 = LUTBezier {
					CtrlWZoom = false,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					},
					SplineColor = { Red = 0, Green = 0, Blue = 0 },
					NameSet = true
				},
				ColRec = Background {
					ViewInfo = OperatorInfo { Pos = { -275, -148.5 } },
					Inputs = {
						TopLeftBlue = Input { Value = 1 },
						TopLeftGreen = Input { Value = 1 },
						Height = Input { Value = 16 },
						Width = Input { Value = 16 },
						GlobalIn = Input { Value = -480 },
						TopLeftRed = Input { Value = 1 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } }
					}
				},
				ColRecDot = Background {
					ViewInfo = OperatorInfo { Pos = { -165, -148.5 } },
					Inputs = {
						TopLeftBlue = Input { Value = 0.1 },
						TopLeftGreen = Input { Value = 0.12 },
						Height = Input { Value = 16 },
						Width = Input { Value = 16 },
						GlobalIn = Input { Value = -480 },
						TopLeftRed = Input { Value = 1 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } }
					}
				},
				RecDraw = Custom {
					ViewInfo = OperatorInfo { Pos = { -55, 16.5 } },
					Inputs = {
						LUTIn3 = Input {
							SourceOp = "CustomTool1LUTIn31",
							Source = "Value"
						},
						LUTIn4 = Input {
							SourceOp = "CustomTool1LUTIn41",
							Source = "Value"
						},
						Intermediate2 = Input { Value = "y - 0.5" },
						NumberIn6 = Input { Expression = "iif(RecCtrl.RecBattery == 1, RecCtrl.RecLevel, -1)" },
						Intermediate3 = Input { Value = "0.5*w/h - n1" },
						NumberIn7 = Input { Expression = "iif(RecCtrl.RecDot == 1 and (RecCtrl.RecBlink <= 0 or (RecCtrl.Sec/RecCtrl.RecBlink) % 1 < 0.6), 1, 0)" },
						Intermediate4 = Input { Value = "0.5 - n1" },
						RedExpression = Input { Value = "getr2b(0.5, 0.5)*max(max(a1, i5), max(i6, i7))*(1 - i8) + getr3b(0.5, 0.5)*i8" },
						Image1 = Input {
							SourceOp = "RecMarks",
							Source = "Output"
						},
						GreenExpression = Input { Value = "getg2b(0.5, 0.5)*max(max(a1, i5), max(i6, i7))*(1 - i8) + getg3b(0.5, 0.5)*i8" },
						BlueExpression = Input { Value = "getb2b(0.5, 0.5)*max(max(a1, i5), max(i6, i7))*(1 - i8) + getb3b(0.5, 0.5)*i8" },
						Intermediate5 = Input { Value = "if(n6 < 0, 0, min(max((n2 - abs(max(abs((i1 - (i3 - 0.035 - n8*1.1))) - n8*1.1, abs((i2 - (i4 - 0.05))) - n8*0.55)))*h + 0.5, 0), 1))" },
						Intermediate6 = Input { Value = "if(n6 >= 0 && (i1 - (i3 - 0.035 - n8*1.1)) + n8*0.85 < n8*1.7*n6, min(max((n8*0.85 - abs((i1 - (i3 - 0.035 - n8*1.1))))*h + 0.5, 0), 1)*min(max((n8*0.3 - abs((i2 - (i4 - 0.05))))*h + 0.5, 0), 1), 0)" },
						Image3 = Input {
							SourceOp = "ColRecDot",
							Source = "Output"
						},
						Intermediate7 = Input { Value = "if(n6 < 0, 0, min(max((n8*0.12 - abs((i1 - (i3 - 0.035 - n8*1.1)) - n8*1.25))*h + 0.5, 0), 1)*min(max((n8*0.25 - abs((i2 - (i4 - 0.05))))*h + 0.5, 0), 1))" },
						Image2 = Input {
							SourceOp = "ColRec",
							Source = "Output"
						},
						NumberIn8 = Input { Expression = "RecCtrl.RecSize" },
						AlphaExpression = Input { Value = "max(max(a1, i5), max(i6, i7))*(1 - i8) + i8" },
						Intermediate8 = Input { Value = "n7*min(max((n8*0.42 - sqrt((i1 + i3 - 0.035 - n8*0.42)^2 + (i2 - (i4 - 0.05))^2))*h + 0.5, 0), 1)" },
						NumberIn1 = Input { Expression = "RecCtrl.RecMargin" },
						Intermediate1 = Input { Value = "(x - 0.5)*w/h" },
						NumberIn2 = Input { Expression = "RecCtrl.RecThick/2" },
						LUTIn1 = Input {
							SourceOp = "CustomTool1LUTIn11",
							Source = "Value"
						},
						LUTIn2 = Input {
							SourceOp = "CustomTool1LUTIn21",
							Source = "Value"
						}
					}
				},
				CustomTool1LUTIn11 = LUTBezier {
					CtrlWZoom = false,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					},
					SplineColor = { Red = 0, Green = 0, Blue = 0 },
					NameSet = true
				},
				CustomTool1LUTIn21 = LUTBezier {
					CtrlWZoom = false,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					},
					SplineColor = { Red = 0, Green = 0, Blue = 0 },
					NameSet = true
				},
				CustomTool1LUTIn31 = LUTBezier {
					CtrlWZoom = false,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					},
					SplineColor = { Red = 0, Green = 0, Blue = 0 },
					NameSet = true
				},
				CustomTool1LUTIn41 = LUTBezier {
					CtrlWZoom = false,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					},
					SplineColor = { Red = 0, Green = 0, Blue = 0 },
					NameSet = true
				},
				RecWordText = TextPlus {
					Version = 1,
					ViewInfo = OperatorInfo { Pos = { -275, 82.5 } },
					Inputs = {
						Wrap = Input { Value = 1 },
						LayoutRotation = Input { Value = 1 },
						TransformRotation = Input { Value = 1 },
						Softness1 = Input { Value = 1 },
						VerticalJustificationNew = Input { Value = 3 },
						HorizontalJustificationNew = Input { Value = 3 },
						Red1 = Input { Expression = "ColRec.TopLeftRed" },
						Font = Input { Value = "Consolas" },
						Green1 = Input { Expression = "ColRec.TopLeftGreen" },
						UseFrameFormatSettings = Input { Value = 1 },
						Width = Input { Value = 1920 },
						GlobalIn = Input { Value = -480 },
						Size = Input { Expression = "RecCtrl.RecSize" },
						GlobalOut = Input { Value = 3534 },
						Center = Input { Expression = "Point(0.5 + (-(0.5*(comp:GetPrefs('Comp.FrameFormat.Width')/comp:GetPrefs('Comp.FrameFormat.Height')) - RecCtrl.RecMargin - 0.035) + iif(RecCtrl.RecDot == 1, RecCtrl.RecSize*1.15, 0))/(comp:GetPrefs('Comp.FrameFormat.Width')/comp:GetPrefs('Comp.FrameFormat.Height')), 0.5 + (1)*(0.5 - RecCtrl.RecMargin - 0.05))" },
						HorizontalLeftCenterRight = Input { Value = -1 },
						Style = Input { Value = "Bold" },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Height = Input { Value = 1080 },
						Blue1 = Input { Expression = "ColRec.TopLeftBlue" },
						StyledText = Input { Expression = "Text(RecCtrl.RecWord.Value)" }
					}
				},
				RecOver1 = Merge {
					ViewInfo = OperatorInfo { Pos = { 165, 16.5 } },
					Inputs = {
						PerformDepthMerge = Input { Value = 0 },
						Foreground = Input {
							SourceOp = "RecWordText",

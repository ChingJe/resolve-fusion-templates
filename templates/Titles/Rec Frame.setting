{
	Tools = ordered() {
		RecFrame = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "RecCtrl", Source = "RecMargin", Name = "Distance From The Edge" },

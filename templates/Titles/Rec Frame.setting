						Red1 = Input { Expression = "ColRec.TopLeftRed" },
						Font = Input {
							Value = "Consolas",
							Expression = "RecWordText.Font"
						},
						Green1 = Input { Expression = "ColRec.TopLeftGreen" },
						UseFrameFormatSettings = Input { Value = 1 },
						Width = Input { Value = 1920 },
						GlobalIn = Input { Value = -480 },
						Size = Input { Expression = "RecCtrl.RecSize" },
						GlobalOut = Input { Value = 3534 },
						Center = Input { Expression = "Point(0.5 + (-(-(0.5*(comp:GetPrefs('Comp.FrameFormat.Width')/comp:GetPrefs('Comp.FrameFormat.Height')) - RecCtrl.RecMargin - 0.035)))/(comp:GetPrefs('Comp.FrameFormat.Width')/comp:GetPrefs('Comp.FrameFormat.Height')), 0.5 + (-1)*(0.5 - RecCtrl.RecMargin - 0.05))" },
						HorizontalLeftCenterRight = Input { Value = 1 },
						Style = Input {
							Value = "Bold",
							Expression = "RecWordText.Style"
						},
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Height = Input { Value = 1080 },
						Blue1 = Input { Expression = "ColRec.TopLeftBlue" },
						StyledText = Input { Expression = "Text((function(on, s, fps)\n  if on ~= 1 then return \"\" end\n  local f = math.floor((s % 1)*fps + 0.001)\n  s = math.floor(s)\n  return string.format(\"%02d:%02d:%02d:%02d\", math.floor(s/3600), math.floor(s/60) % 60, s % 60, f)\nend)(RecCtrl.RecTime, RecCtrl.Sec + RecCtrl.RecStart, iif(RecCtrl.FpsOverride > 0, RecCtrl.FpsOverride, comp:GetPrefs('Comp.FrameFormat.Rate') or 24)))" }
					}
				},
				RecOver3 = Merge {
					ViewInfo = OperatorInfo { Pos = { 385, 16.5 } },
					Inputs = {
						PerformDepthMerge = Input { Value = 0 },
						Foreground = Input {
							SourceOp = "RecTimeText",
							Source = "Output"
						},
						Background = Input {
							SourceOp = "RecOver2",
							Source = "Output"
						}
					}
				},
				RecFinal = Merge {
					ViewInfo = OperatorInfo { Pos = { 605, 16.5 } },
					Inputs = {
						Blend = Input { Expression = "RecCtrl.RecOpacity" },
						PerformDepthMerge = Input { Value = 0 },
						Foreground = Input {
							SourceOp = "RecOver3",
							Source = "Output"
						},
						Background = Input {
							SourceOp = "RecCtrl",
							Source = "Output"
						}
					}
				}
			
			}
		}
	},
	ActiveTool = "RecFrame"
}

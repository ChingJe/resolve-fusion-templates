							INP_MaxScale = 0.12,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Text Size",
							INP_Default = 0.035
						},
						RecCross = {
							INP_Integer = true,
							ICS_ControlPage = "Controls",
							INPID_InputControl = "CheckboxControl",
							LINKID_DataType = "Number",
							LINKS_Name = "Centre Cross",
							INP_Default = 1
						},
						RecOpacity = {
							INP_MinScale = 0,
							INP_MaxScale = 1,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Opacity",
							INP_Default = 0.9
						}
					},
					CtrlWZoom = false
				},
				RecMarks = Custom {
					ViewInfo = OperatorInfo { Pos = { -165, 16.5 } },
					Inputs = {
						Intermediate1 = Input { Value = "(x - 0.5)*w/h" },
						LUTIn4 = Input {
							SourceOp = "CustomTool1LUTIn4",
							Source = "Value"
						},
						Intermediate2 = Input { Value = "y - 0.5" },
						Intermediate3 = Input { Value = "0.5*w/h - n1" },
						Intermediate4 = Input { Value = "0.5 - n1" },
						RedExpression = Input { Value = "max(max(i5, i6), i7)" },
						Image1 = Input {
							SourceOp = "RecCtrl",
							Source = "Output"
						},
						GreenExpression = Input { Value = "max(max(i5, i6), i7)" },
						NumberIn3 = Input { Expression = "RecCtrl.RecCorners" },
						BlueExpression = Input { Value = "max(max(i5, i6), i7)" },
						NumberIn4 = Input { Expression = "RecCtrl.RecCross" },
						NumberIn5 = Input { Expression = "RecCtrl.RecGrid" },
						Intermediate5 = Input { Value = "if(n3 > 0 && i3 - abs(i1) < n3 && i4 - abs(i2) < n3, min(max((n2 - abs(max(abs(i1) - i3, abs(i2) - i4)))*h + 0.5, 0), 1), 0)" },
						Intermediate6 = Input { Value = "if(n4 > 0, max(min(max((n2 - abs(i1))*h + 0.5, 0), 1)*min(max((0.03 - abs(i2))*h + 0.5, 0), 1), min(max((n2 - abs(i2))*h + 0.5, 0), 1)*min(max((0.03 - abs(i1))*h + 0.5, 0), 1)), 0)" },
						Intermediate7 = Input { Value = "n5*if(abs(i1) < i3 && abs(i2) < i4, min(max((n2*0.6 - min(abs(abs(i1) - i3/3), abs(abs(i2) - i4/3)))*h + 0.5, 0), 1), 0)" },
						AlphaExpression = Input { Value = "max(max(i5, i6), i7)" },
						NumberIn1 = Input { Expression = "RecCtrl.RecMargin" },
						LUTIn3 = Input {
							SourceOp = "CustomTool1LUTIn3",
							Source = "Value"
						},
						NumberIn2 = Input { Expression = "RecCtrl.RecThick/2" },
						LUTIn1 = Input {
							SourceOp = "CustomTool1LUTIn1",
							Source = "Value"
						},
						LUTIn2 = Input {
							SourceOp = "CustomTool1LUTIn2",
							Source = "Value"
						}
					}
				},
				CustomTool1LUTIn1 = LUTBezier {
					CtrlWZoom = false,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					},
					SplineColor = { Red = 0, Green = 0, Blue = 0 },
					NameSet = true
				},
				CustomTool1LUTIn2 = LUTBezier {
					CtrlWZoom = false,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					},
					SplineColor = { Red = 0, Green = 0, Blue = 0 },
					NameSet = true
				},
				CustomTool1LUTIn3 = LUTBezier {

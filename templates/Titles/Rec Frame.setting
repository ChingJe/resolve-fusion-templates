							ICS_ControlPage = "Controls",
							INPID_InputControl = "CheckboxControl",
							LINKID_DataType = "Number",
							LINKS_Name = "REC Dot",
							INP_Default = 1
						},
						RecBlink = {
							INP_MinScale = 0,
							INP_MaxScale = 5,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "REC Dot: Seconds Per Blink (0 = steady)",
							INP_Default = 1
						},
						RecWord = {
							INPS_DefaultText = "REC",
							TEC_Lines = 1,
							LINKID_DataType = "Text",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "TextEditControl",
							LINKS_Name = "REC Text"
						},
						RecTime = {
							INP_Integer = true,

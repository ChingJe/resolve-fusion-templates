						Wrap = Input { Value = 1 },
						LayoutRotation = Input { Value = 1 },
						TransformRotation = Input { Value = 1 },
						Softness1 = Input { Value = 1 },
						VerticalJustificationNew = Input { Value = 3 },
						HorizontalJustificationNew = Input { Value = 3 },
						Red1 = Input { Expression = "ColRec.TopLeftRed" },
						Font = Input {
							Value = "Consolas",
							Expression = "RecWordText.Font"
						},
						Green1 = Input { Expression = "ColRec.TopLeftGreen" },
						UseFrameFormatSettings = Input { Value = 1 },
						Width = Input { Value = 1920 },
						GlobalIn = Input { Value = -480 },
						Size = Input { Expression = "RecCtrl.RecSize" },
						GlobalOut = Input { Value = 3534 },
						Center = Input { Expression = "Point(0.5 + (-(0.5*(comp:GetPrefs('Comp.FrameFormat.Width')/comp:GetPrefs('Comp.FrameFormat.Height')) - RecCtrl.RecMargin - 0.035))/(comp:GetPrefs('Comp.FrameFormat.Width')/comp:GetPrefs('Comp.FrameFormat.Height')), 0.5 + (-1)*(0.5 - RecCtrl.RecMargin - 0.05))" },
						HorizontalLeftCenterRight = Input { Value = -1 },
						Style = Input {
							Value = "Bold",
							Expression = "RecWordText.Style"
						},
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Height = Input { Value = 1080 },
						Blue1 = Input { Expression = "ColRec.TopLeftBlue" },
						StyledText = Input { Expression = "Text(RecCtrl.RecInfo.Value)" }
					}
				},
				RecOver2 = Merge {
					ViewInfo = OperatorInfo { Pos = { 275, 16.5 } },
					Inputs = {
						PerformDepthMerge = Input { Value = 0 },
						Foreground = Input {
							SourceOp = "RecInfoText",
							Source = "Output"
						},
						Background = Input {
							SourceOp = "RecOver1",
							Source = "Output"
						}
					}
				},
				RecTimeText = TextPlus {
					Version = 1,
					ViewInfo = OperatorInfo { Pos = { -275, 148.5 } },
					Inputs = {
						Wrap = Input { Value = 1 },
						LayoutRotation = Input { Value = 1 },
						TransformRotation = Input { Value = 1 },
						Softness1 = Input { Value = 1 },
						VerticalJustificationNew = Input { Value = 3 },

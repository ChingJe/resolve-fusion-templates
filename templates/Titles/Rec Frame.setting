				Input15 = InstanceInput { SourceOp = "RecCtrl", Source = "RecOpacity", Name = "Opacity" },
				Input16 = InstanceInput { SourceOp = "RecCtrl", Source = "FpsOverride", Name = "Frame Rate Override" },
				Input17 = InstanceInput { SourceOp = "RecWordText", Source = "Font", Name = "Font", ControlGroup = 2 },
				Input18 = InstanceInput { SourceOp = "RecWordText", Source = "Style", ControlGroup = 2 },
				Input19 = InstanceInput { SourceOp = "ColRec", Source = "TopLeftRed", Name = "Colour", ControlGroup = 3 },
				Input20 = InstanceInput { SourceOp = "ColRec", Source = "TopLeftGreen", ControlGroup = 3 },
				Input21 = InstanceInput { SourceOp = "ColRec", Source = "TopLeftBlue", ControlGroup = 3 },
				Input22 = InstanceInput { SourceOp = "ColRecDot", Source = "TopLeftRed", Name = "REC Dot Colour", ControlGroup = 4 },
				Input23 = InstanceInput { SourceOp = "ColRecDot", Source = "TopLeftGreen", ControlGroup = 4 },
				Input24 = InstanceInput { SourceOp = "ColRecDot", Source = "TopLeftBlue", ControlGroup = 4 },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "RecFinal", Source = "Output" }
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				RecCtrl = Background {
					ViewInfo = OperatorInfo { Pos = { -495, -82.5 } },
					Inputs = {
						Sec = Input { Expression = "(time - comp.RenderStart)/iif(FpsOverride > 0, FpsOverride, comp:GetPrefs('Comp.FrameFormat.Rate') or 24)" },
						Height = Input { Value = 1080 },
						UseFrameFormatSettings = Input { Value = 1 },
						Width = Input { Value = 1920 },
						GlobalIn = Input { Value = -480 },
						TopLeftAlpha = Input { Value = 0 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } }
					},
					UserControls = {
						FpsOverride = {
							INP_MinScale = 0,
							INP_MaxScale = 120,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Frame Rate Override",
							INP_Default = 0
						},
						Sec = {
							INP_MinScale = 0,
							INP_MaxScale = 1000000,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Sec",
							INP_Default = 0
						},
						RecMargin = {
							INP_MinScale = 0,
							INP_MaxScale = 0.3,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Distance From The Edge",
							INP_Default = 0.06
						},
						RecThick = {
							INP_MinScale = 0.001,
							INP_MaxScale = 0.02,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Line Thickness",
							INP_Default = 0.004
						},
						RecCorners = {
							INP_MinScale = 0,
							INP_MaxScale = 0.5,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Corner Marks: Length (0 = none)",
							INP_Default = 0.09
						},
						RecDot = {

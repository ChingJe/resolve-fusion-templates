				DimLabel = TextPlus {
					Inputs = {
						Height = Input { Value = 1080 },
						GlobalIn = Input { Value = -480 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						UseFrameFormatSettings = Input { Value = 1 },
						Font = Input { Value = "Microsoft JhengHei" },
						Style = Input { Value = "Bold" },
						StyledText = Input { Expression = "Text(DimCtrl.DimText.Value)" },
						Size = Input { Expression = "DimCtrl.DimSize" },
						Wrap = Input { Value = 1 },
						LayoutRotation = Input { Value = 1 },
						TransformRotation = Input { Value = 1 },
						Center = Input { Expression = "Point((DimCtrl.DimA.X + DimCtrl.DimB.X)/2 - iif(math.cos(math.rad(DimCtrl.Ang)) < 0, -1, 1)*math.sin(math.rad(DimCtrl.Ang))*DimCtrl.DimOffset/(comp:GetPrefs('Comp.FrameFormat.Width')/comp:GetPrefs('Comp.FrameFormat.Height')), (DimCtrl.DimA.Y + DimCtrl.DimB.Y)/2 + iif(math.cos(math.rad(DimCtrl.Ang)) < 0, -1, 1)*math.cos(math.rad(DimCtrl.Ang))*DimCtrl.DimOffset)" },
						VerticalJustificationNew = Input { Value = 3 },
						HorizontalJustificationNew = Input { Value = 3 },
						Softness1 = Input { Value = 1 },
						AngleZ = Input { Expression = "iif(DimCtrl.DimTurn == 1, DimCtrl.Ang + iif(math.cos(math.rad(DimCtrl.Ang)) < 0, 180, 0), 0)" },
						Width = Input { Value = 1920 }
					},
					Version = 1,
					ViewInfo = OperatorInfo { Pos = { -275, 115.5 } }
				},
				DimMatte = Merge {
					Inputs = {
						Blend = Input { Expression = "min(max(DimCtrl.G*2 - 1, 0), 1)" },
						PerformDepthMerge = Input { Value = 0 },
						Background = Input {
							Source = "Output",
							SourceOp = "DimDraw"
						},
						Foreground = Input {
							Source = "Output",
							SourceOp = "DimLabel"
						}
					},
					ViewInfo = OperatorInfo { Pos = { -55, 16.5 } }
				},
				DimPaintGrowB = ErodeDilate {

				},
				DimDraw = Custom {
					Inputs = {
						Intermediate7 = Input { Value = "max(i5, i6)" },
						Image1 = Input {
							Source = "Output",
							SourceOp = "DimCtrl"
						},
						PointIn1 = Input { Expression = "DimCtrl.DimA" },
						PointIn2 = Input { Expression = "DimCtrl.DimB" },
						NumberIn1 = Input { Expression = "DimCtrl.DimThick/2" },
						NumberIn2 = Input { Expression = "DimCtrl.DimEnds" },
						NumberIn3 = Input { Expression = "DimCtrl.DimEndSize" },
						LUTIn2 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn2"
						},
						LUTIn3 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn3"
						},
						LUTIn4 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn4"
						},
						Intermediate1 = Input { Value = "max(sqrt(((p2x - p1x)*w/h)^2 + (p2y - p1y)^2)/2, 0.0001)*n4" },
						Intermediate2 = Input { Value = "(x - (p1x + p2x)/2)*w/h*cos(n5) + (y - (p1y + p2y)/2)*sin(n5)" },
						AlphaExpression = Input { Value = "i7" },
						Intermediate3 = Input { Value = "(y - (p1y + p2y)/2)*cos(n5) - (x - (p1x + p2x)/2)*w/h*sin(n5)" },
						BlueExpression = Input { Value = "i7" },
						Intermediate4 = Input { Value = "i1 - abs(i2)" },
						GreenExpression = Input { Value = "i7" },
						Intermediate5 = Input { Value = "min(max((n1 - abs(i3))*h + 0.5, 0), 1)*min(max((i4 - if(n2 == 1, n3*0.6, 0))*h + 0.5, 0), 1)" },
						RedExpression = Input { Value = "i7" },
						Intermediate6 = Input { Value = "if(n2 == 0, min(max((n1 - abs(i4))*h + 0.5, 0), 1)*min(max((n3/2 - abs(i3))*h + 0.5, 0), 1), if(n2 == 1, min(max(i4*h + 0.5, 0), 1)*min(max((i4*0.45 - abs(i3))*h + 0.5, 0), 1)*min(max((n3 - i4)*h + 0.5, 0), 1), if(n2 == 2, min(max((n3/2 - sqrt(i4^2 + i3^2))*h + 0.5, 0), 1), 0)))" },
						NumberIn5 = Input { Expression = "DimCtrl.Ang" },
						NumberIn4 = Input { Expression = "DimCtrl.G" },
						LUTIn1 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn1"
						}
					},
					ViewInfo = OperatorInfo { Pos = { -275, 16.5 } }
				},
				CustomTool1LUTIn1 = LUTBezier {
					CtrlWZoom = false,
					NameSet = true,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					},
					SplineColor = { Red = 0, Green = 0, Blue = 0 }
				},
				CustomTool1LUTIn2 = LUTBezier {

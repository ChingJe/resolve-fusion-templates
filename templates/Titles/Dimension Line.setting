							LINKS_Name = "Label Distance From The Line",
							INP_Default = 0.06,
							INP_MinScale = -0.4,
							INP_MaxScale = 0.4,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl"
						},
						DimSize = {

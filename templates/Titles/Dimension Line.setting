{
	Tools = ordered() {
		DimensionLine = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "DimCtrl", Source = "DimText", Name = "Label" },
				Input2 = InstanceInput { SourceOp = "DimLabel", Source = "Font", Name = "Font", ControlGroup = 2 },
				Input3 = InstanceInput { SourceOp = "DimLabel", Source = "Style", ControlGroup = 2 },
				Input4 = InstanceInput { SourceOp = "DimCtrl", Source = "DimA", Name = "From" },
				Input5 = InstanceInput { SourceOp = "DimCtrl", Source = "DimB", Name = "To" },
				Input6 = InstanceInput { SourceOp = "DimCtrl", Source = "DimSize", Name = "Label Size" },
				Input7 = InstanceInput { SourceOp = "DimCtrl", Source = "DimOffset", Name = "Label Distance From The Line" },
				Input8 = InstanceInput { SourceOp = "DimCtrl", Source = "DimTurn", Name = "Label Turns With The Line" },
				Input9 = InstanceInput { SourceOp = "DimCtrl", Source = "DimEnds", Name = "Ends" },

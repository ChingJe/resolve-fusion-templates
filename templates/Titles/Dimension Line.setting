						},
						PointIn1 = Input { Expression = "Point(0, 0)" },
						NumberIn6 = Input { Expression = "ColDimEdge.TopLeftBlue" },
						PointIn2 = Input { Expression = "Point(0, 0)" },
						NumberIn7 = Input { Expression = "iif((DimCtrl.DimEdge) > 0, 1, 0)" },
						NumberIn1 = Input { Expression = "ColDim.TopLeftRed" },
						NumberIn2 = Input { Expression = "ColDim.TopLeftGreen" },
						NumberIn3 = Input { Expression = "ColDim.TopLeftBlue" },
						LUTIn2 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn21"
						},
						LUTIn3 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn31"
						},
						LUTIn4 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn41"
						},
						Intermediate1 = Input { Value = "a2*n7" },
						Intermediate2 = Input { Value = "a3*n8" },
						BlueExpression = Input { Value = "n3*a1 + (1 - a1)*(n6*i1 + (1 - i1)*p2x*i2)" },
						AlphaExpression = Input { Value = "a1 + (1 - a1)*(i1 + (1 - i1)*i2)" },
						Image3 = Input {
							Source = "Output",
							SourceOp = "DimPaintGrowB"
						},
						GreenExpression = Input { Value = "n2*a1 + (1 - a1)*(n5*i1 + (1 - i1)*p1y*i2)" },
						RedExpression = Input { Value = "n1*a1 + (1 - a1)*(n4*i1 + (1 - i1)*p1x*i2)" },
						NumberIn5 = Input { Expression = "ColDimEdge.TopLeftGreen" },
						NumberIn4 = Input { Expression = "ColDimEdge.TopLeftRed" },
						LUTIn1 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn11"
						},
						NumberIn8 = Input { Expression = "iif((0) > 0, 1, 0)" }
					},
					ViewInfo = OperatorInfo { Pos = { 165, 16.5 } }
				},
				CustomTool1LUTIn11 = LUTBezier {
					CtrlWZoom = false,
					NameSet = true,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}

						Input = Input {
							Source = "Output",
							SourceOp = "DimMatte"
						},
						Filter = Input { Value = 3 },
						XAmount = Input { Expression = "(DimCtrl.DimEdge) + (0)" }
					},
					ViewInfo = OperatorInfo { Pos = { 55, 82.5 } }
				},
				DimPaintGrowA = ErodeDilate {
					Inputs = {
						Input = Input {
							Source = "Output",
							SourceOp = "DimMatte"
						},
						Filter = Input { Value = 3 },
						XAmount = Input { Expression = "DimCtrl.DimEdge" }
					},
					ViewInfo = OperatorInfo { Pos = { 55, 49.5 } }
				},
				DimPaint = Custom {
					Inputs = {

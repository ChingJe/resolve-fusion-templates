				Input12 = InstanceInput { SourceOp = "DimCtrl", Source = "DimEdge", Name = "Outline" },
				Input13 = InstanceInput { SourceOp = "DimCtrl", Source = "DimIn", Name = "Grow (seconds)" },
				Input14 = InstanceInput { SourceOp = "DimCtrl", Source = "DimOut", Name = "Fade Out (seconds)" },
				Input15 = InstanceInput { SourceOp = "DimCtrl", Source = "FpsOverride", Name = "Frame Rate Override" },
				Input16 = InstanceInput { SourceOp = "ColDim", Source = "TopLeftRed", Name = "Colour", ControlGroup = 3 },
				Input17 = InstanceInput { SourceOp = "ColDim", Source = "TopLeftGreen", ControlGroup = 3 },
				Input18 = InstanceInput { SourceOp = "ColDim", Source = "TopLeftBlue", ControlGroup = 3 },
				Input19 = InstanceInput { SourceOp = "ColDimEdge", Source = "TopLeftRed", Name = "Outline Colour", ControlGroup = 4 },
				Input20 = InstanceInput { SourceOp = "ColDimEdge", Source = "TopLeftGreen", ControlGroup = 4 },
				Input21 = InstanceInput { SourceOp = "ColDimEdge", Source = "TopLeftBlue", ControlGroup = 4 },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "DimFinal", Source = "Output" }
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				DimCtrl = Background {
					ViewInfo = OperatorInfo { Pos = { -495, -82.5 } },
					Inputs = {
						Height = Input { Value = 1080 },
						Ang = Input { Expression = "math.deg(math.atan2(DimB.Y - DimA.Y, (DimB.X - DimA.X)*(comp:GetPrefs('Comp.FrameFormat.Width')/comp:GetPrefs('Comp.FrameFormat.Height'))))" },
						GlobalIn = Input { Value = -480 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						TopLeftAlpha = Input { Value = 0 },
						DimA = Input { Value = { 0.25, 0.4 } },
						G = Input { Expression = "iif(DimIn <= 0, 1, 1 - (1 - min(max((time - comp.RenderStart + 1)/(DimIn*iif(FpsOverride > 0, FpsOverride, comp:GetPrefs('Comp.FrameFormat.Rate') or 24)), 0), 1))^3)" },
						DimB = Input { Value = { 0.75, 0.4 } },
						Fade = Input { Expression = "iif(DimOut <= 0, 1, min(max((comp.RenderEnd - time + 1)/(DimOut*iif(FpsOverride > 0, FpsOverride, comp:GetPrefs('Comp.FrameFormat.Rate') or 24)), 0), 1))" },
						UseFrameFormatSettings = Input { Value = 1 },
						Width = Input { Value = 1920 }
					},
					UserControls = {
						Fade = {
							LINKID_DataType = "Number",
							LINKS_Name = "Fade",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Integer = false,
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl"
						},
						Ang = {
							LINKID_DataType = "Number",
							LINKS_Name = "Ang",
							INP_Default = 0,
							INP_MinScale = -360,
							INP_MaxScale = 360,
							INP_Integer = false,
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl"
						},
						DimEndSize = {
							LINKID_DataType = "Number",
							LINKS_Name = "End Size",
							INP_Default = 0.04,
							INP_MinScale = 0.005,
							INP_MaxScale = 0.2,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl"
						},
						DimOffset = {

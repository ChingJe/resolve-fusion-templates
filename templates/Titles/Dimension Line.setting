							LINKS_Name = "Label Size",
							INP_Default = 0.05,
							INP_MinScale = 0.01,
							INP_MaxScale = 0.3,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl"
						},
						DimThick = {
							LINKID_DataType = "Number",
							LINKS_Name = "Line Thickness",
							INP_Default = 0.005,
							INP_MinScale = 0.001,
							INP_MaxScale = 0.03,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl"
						},
						DimEdge = {
							LINKID_DataType = "Number",
							LINKS_Name = "Outline",
							INP_Default = 0.003,
							INP_MinScale = 0,
							INP_MaxScale = 0.02,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl"
						},
						DimB = {

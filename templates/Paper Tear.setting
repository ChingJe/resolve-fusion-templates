{
	Tools = ordered() {
		PaperTear = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "SrcA", Source = "Input" },
				MainInput2 = InstanceInput { SourceOp = "SrcB", Source = "Input" },
				Input1 = InstanceInput { SourceOp = "TearCtrl", Source = "TearAngle", Name = "Angle" },
				Input2 = InstanceInput { SourceOp = "TearCtrl", Source = "TearRough", Name = "Roughness" },
				Input3 = InstanceInput { SourceOp = "TearCtrl", Source = "TearSeed", Name = "Tear Shape" },
				Input4 = InstanceInput { SourceOp = "TearCtrl", Source = "TearEdge", Name = "Paper Edge Width" },
				Input5 = InstanceInput { SourceOp = "TearCtrl", Source = "TearShadow", Name = "Shadow" },
				Input6 = InstanceInput { SourceOp = "TearCtrl", Source = "TearShadowW", Name = "Shadow Width" },
				Input7 = InstanceInput { SourceOp = "TearCtrl", Source = "TearSteps", Name = "Stop Motion Steps" },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "TearCut", Source = "Output" }
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				TearCtrl = Background {
					Inputs = {
						P = Input {
							SourceOp = "TearProgress",
							Source = "Value"
						},
						GlobalIn = Input { Value = -480 },
						Q = Input { Expression = "(function(p, n) if n >= 1 then p = floor(p*n + 0.5)/n end return p*p*(3 - 2*p) end)(P, TearSteps)" },
						E = Input { Expression = "(function(r) return -r + 2*r*Q end)(0.6 + TearRough + TearEdge + TearShadowW)" },
						Height = Input { Value = 1080 },
						Width = Input { Value = 1920 },
						UseFrameFormatSettings = Input { Value = 1 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						GlobalOut = Input { Value = 3534 }
					},
					ViewInfo = OperatorInfo { Pos = { -495, -82.5 } },
					UserControls = {
						TearShadow = {
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							LINKID_DataType = "Number",
							LINKS_Name = "Shadow",
							INP_Default = 0.6,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Integer = false
						},
						TearShadowW = {
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							LINKID_DataType = "Number",
							LINKS_Name = "Shadow Width",
							INP_Default = 0.03,
							INP_MinScale = 0,
							INP_MaxScale = 0.15,
							INP_Integer = false
						},
						P = {
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							LINKID_DataType = "Number",
							LINKS_Name = "P",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Integer = false
						},
						TearSeed = {
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							LINKID_DataType = "Number",
							LINKS_Name = "Tear Shape",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 20,
							INP_Integer = false
						},
						TearSteps = {
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							LINKID_DataType = "Number",
							LINKS_Name = "Stop Motion Steps",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 24,
							INP_Integer = true
						},
						Q = {
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							LINKID_DataType = "Number",
							LINKS_Name = "Q",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Integer = false
						},
						TearAngle = {
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							LINKID_DataType = "Number",
							LINKS_Name = "Angle",
							INP_Default = 12,
							INP_MinScale = -180,
							INP_MaxScale = 180,
							INP_Integer = false
						},
						TearRough = {
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							LINKID_DataType = "Number",
							LINKS_Name = "Roughness",
							INP_Default = 0.05,
							INP_MinScale = 0,
							INP_MaxScale = 0.2,
							INP_Integer = false
						},
						TearEdge = {
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							LINKID_DataType = "Number",
							LINKS_Name = "Paper Edge Width",
							INP_Default = 0.012,
							INP_MinScale = 0,
							INP_MaxScale = 0.05,
							INP_Integer = false
						},
						E = {
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							LINKID_DataType = "Number",
							LINKS_Name = "E",
							INP_Default = 0,
							INP_MinScale = -2,
							INP_MaxScale = 2,
							INP_Integer = false
						}
					},
					CtrlWZoom = false
				},
				TearProgress = LUTLookup {
					NameSet = true,
					CtrlWZoom = false,
					Inputs = {
						Lookup = Input {
							SourceOp = "AnimCurves1查找表",
							Source = "Value"
						}
					}
				},
				["AnimCurves1查找表"] = LUTBezier {
					NameSet = true,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, LH = { 0.666666666666667, 0.666666666666667 }, Flags = { Linear = true } }
						}
					},
					SplineColor = { Blue = 0, Green = 0, Red = 0 }
				},
				SrcA = BrightnessContrast {
					ViewInfo = OperatorInfo { Pos = { -495, 16.5 } }
				},
				SrcB = BrightnessContrast {
					ViewInfo = OperatorInfo { Pos = { -495, 82.5 } }
				},
				TearNoise = FastNoise {
					Inputs = {
						Seethe = Input { Expression = "TearCtrl.TearSeed" },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						GlobalIn = Input { Value = -480 },
						Width = Input { Value = 1024 },
						GlobalOut = Input { Value = 3534 },
						Height = Input { Value = 1024 },
						Depth = Input { Value = 4 },
						Detail = Input { Value = 8 },
						Contrast = Input { Value = 2.2 },
						XScale = Input { Value = 6 }
					},
					ViewInfo = OperatorInfo { Pos = { -275, 148.5 } }
				},
				TearCut = Custom {
					Inputs = {
						Intermediate1 = Input { Value = "(x - 0.5)*cos(n2) + (y - 0.5)*(h/w)*sin(n2)" },
						Intermediate2 = Input { Value = "0.5 + 0.75*((y - 0.5)*(h/w)*cos(n2) - (x - 0.5)*sin(n2))" },
						Intermediate3 = Input { Value = "i1 - n7 - n3*2*(getr3b(0.27, i2) - 0.5)" },
						Intermediate4 = Input { Value = "n4*(0.25 + 1.5*getr3b(0.71, frac(i2*3.7)))" },
						Intermediate5 = Input { Value = "0.9 + 0.1*getr3b(frac(x*5), frac(y*5))" },
						Intermediate6 = Input { Value = "1 - n5*max(0, 1 + i3/max(n6, 0.0001))^2" },
						Image3 = Input {
							SourceOp = "TearNoise",
							Source = "Output"
						},
						RedExpression = Input { Value = "if(n1 <= 0, r1, if(n1 >= 1, r2, if(i3 > i4, r1, if(i3 > 0, i5, r2*i6))))" },
						Image1 = Input {
							SourceOp = "SrcA",
							Source = "Output"
						},
						GreenExpression = Input { Value = "if(n1 <= 0, g1, if(n1 >= 1, g2, if(i3 > i4, g1, if(i3 > 0, i5, g2*i6))))" },
						NumberIn1 = Input { Expression = "TearCtrl.P" },
						LUTIn1 = Input {
							SourceOp = "CustomTool1LUTIn1",
							Source = "Value"
						},
						NumberIn2 = Input { Expression = "TearCtrl.TearAngle" },
						LUTIn3 = Input {
							SourceOp = "CustomTool1LUTIn3",
							Source = "Value"
						},
						NumberIn3 = Input { Expression = "TearCtrl.TearRough" },
						Image2 = Input {
							SourceOp = "SrcB",
							Source = "Output"
						},
						NumberIn4 = Input { Expression = "TearCtrl.TearEdge" },
						AlphaExpression = Input { Value = "1" },
						NumberIn5 = Input { Expression = "TearCtrl.TearShadow" },
						BlueExpression = Input { Value = "if(n1 <= 0, b1, if(n1 >= 1, b2, if(i3 > i4, b1, if(i3 > 0, i5, b2*i6))))" },
						NumberIn6 = Input { Expression = "TearCtrl.TearShadowW" },
						LUTIn2 = Input {
							SourceOp = "CustomTool1LUTIn2",
							Source = "Value"
						},
						NumberIn7 = Input { Expression = "TearCtrl.E" },
						LUTIn4 = Input {
							SourceOp = "CustomTool1LUTIn4",
							Source = "Value"
						}
					},
					ViewInfo = OperatorInfo { Pos = { 275, 49.5 } }
				},
				CustomTool1LUTIn1 = LUTBezier {
					CtrlWZoom = false,
					SplineColor = { Blue = 0, Green = 0, Red = 0 },
					NameSet = true,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, LH = { 0.666666666666667, 0.666666666666667 }, Flags = { Linear = true } }
						}
					}
				},
				CustomTool1LUTIn2 = LUTBezier {
					CtrlWZoom = false,
					SplineColor = { Blue = 0, Green = 0, Red = 0 },
					NameSet = true,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, LH = { 0.666666666666667, 0.666666666666667 }, Flags = { Linear = true } }
						}
					}
				},
				CustomTool1LUTIn3 = LUTBezier {
					CtrlWZoom = false,
					SplineColor = { Blue = 0, Green = 0, Red = 0 },
					NameSet = true,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, LH = { 0.666666666666667, 0.666666666666667 }, Flags = { Linear = true } }
						}
					}
				},
				CustomTool1LUTIn4 = LUTBezier {
					CtrlWZoom = false,
					SplineColor = { Blue = 0, Green = 0, Red = 0 },
					NameSet = true,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, LH = { 0.666666666666667, 0.666666666666667 }, Flags = { Linear = true } }
						}
					}
				}
			
			}
		}
	},
	ActiveTool = "PaperTear"
}

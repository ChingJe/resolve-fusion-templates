{
	Tools = ordered() {
		PaperTear = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "SrcA", Source = "Input" },
				MainInput2 = InstanceInput { SourceOp = "SrcB", Source = "Input" },
				Input1 = InstanceInput { SourceOp = "TearCtrl", Source = "TearAngle", Name = "Angle" },
				Input2 = InstanceInput { SourceOp = "TearCtrl", Source = "TearOffset", Name = "Line Position" },
				Input3 = InstanceInput { SourceOp = "TearCtrl", Source = "TearGap", Name = "Rip Gap" },
				Input4 = InstanceInput { SourceOp = "TearCtrl", Source = "TearRough", Name = "Roughness" },
				Input5 = InstanceInput { SourceOp = "TearCtrl", Source = "TearSeed", Name = "Tear Shape" },
				Input6 = InstanceInput { SourceOp = "TearCtrl", Source = "TearEdge", Name = "Paper Edge Width" },
				Input7 = InstanceInput { SourceOp = "TearCtrl", Source = "TearShadow", Name = "Shadow" },
				Input8 = InstanceInput { SourceOp = "TearCtrl", Source = "TearShadowW", Name = "Shadow Width" },
				Input9 = InstanceInput { SourceOp = "TearCtrl", Source = "TearSteps", Name = "Stop Motion Steps" },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "TearCut", Source = "Output" }
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				TearCtrl = Background {
					UserControls = {
						TearOffset = {
							INP_MinScale = -0.5,
							INP_MaxScale = 0.5,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Line Position",
							INP_Default = 0
						},
						Q = {
							INP_MinScale = 0,
							INP_MaxScale = 1,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Q",
							INP_Default = 0
						},
						F = {
							INP_MinScale = -1,
							INP_MaxScale = 20,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "F",
							INP_Default = 0
						},
						Slide = {
							INP_MinScale = 0,
							INP_MaxScale = 3,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Slide",
							INP_Default = 0
						},
						TearGap = {
							INP_MinScale = 0,
							INP_MaxScale = 0.1,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Rip Gap",
							INP_Default = 0.02
						},
						TearEdge = {
							INP_MinScale = 0,
							INP_MaxScale = 0.05,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Paper Edge Width",
							INP_Default = 0.012
						},
						TearShadow = {
							INP_MinScale = 0,
							INP_MaxScale = 1,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Shadow",
							INP_Default = 0.6
						},
						TearAngle = {
							INP_MinScale = -180,
							INP_MaxScale = 180,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Angle",
							INP_Default = 12
						},
						TearShadowW = {
							INP_MinScale = 0,
							INP_MaxScale = 0.15,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Shadow Width",
							INP_Default = 0.03
						},
						TearSteps = {
							INP_MinScale = 0,
							INP_MaxScale = 24,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = true,
							LINKS_Name = "Stop Motion Steps",
							INP_Default = 0
						},
						TearSeed = {
							INP_MinScale = 0,
							INP_MaxScale = 20,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Tear Shape",
							INP_Default = 0
						},
						TearRough = {
							INP_MinScale = 0,
							INP_MaxScale = 0.2,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Roughness",
							INP_Default = 0.05
						},
						P = {
							INP_MinScale = 0,
							INP_MaxScale = 1,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "P",
							INP_Default = 0
						}
					},
					CtrlWZoom = false,
					ViewInfo = OperatorInfo { Pos = { -495, -82.5 } },
					Inputs = {
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Q = Input { Expression = "iif(TearSteps >= 1, floor(P*TearSteps + 0.5)/max(TearSteps, 1), P)" },
						F = Input { Expression = "Q*2.8" },
						Slide = Input { Expression = "(0.7 + abs(TearOffset) + TearRough) * (function(t) return t*t*(3 - 2*t) end)(min(max((Q - 0.25)/0.75, 0), 1))" },
						UseFrameFormatSettings = Input { Value = 1 },
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						GlobalIn = Input { Value = -480 },
						P = Input {
							SourceOp = "TearProgress",
							Source = "Value"
						}
					}
				},
				TearProgress = LUTLookup {
					CtrlWZoom = false,
					Inputs = {
						Lookup = Input {
							SourceOp = "AnimCurves1查找表",
							Source = "Value"
						}
					},
					NameSet = true
				},
				["AnimCurves1查找表"] = LUTBezier {
					NameSet = true,
					SplineColor = { Blue = 0, Green = 0, Red = 0 },
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					}
				},
				SrcA = BrightnessContrast {
					ViewInfo = OperatorInfo { Pos = { -495, 16.5 } }
				},
				SrcB = BrightnessContrast {
					ViewInfo = OperatorInfo { Pos = { -495, 82.5 } }
				},
				TearNoise = FastNoise {
					Inputs = {
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Seethe = Input { Expression = "TearCtrl.TearSeed" },
						Width = Input { Value = 1024 },
						Height = Input { Value = 1024 },
						Depth = Input { Value = 4 },
						Detail = Input { Value = 8 },
						Contrast = Input { Value = 2.2 },
						GlobalIn = Input { Value = -480 },
						XScale = Input { Value = 6 }
					},
					ViewInfo = OperatorInfo { Pos = { -275, 148.5 } }
				},
				TearCut = Custom {
					Inputs = {
						LUTIn1 = Input {
							SourceOp = "CustomTool1LUTIn1",
							Source = "Value"
						},
						LUTIn2 = Input {
							SourceOp = "CustomTool1LUTIn2",
							Source = "Value"
						},
						LUTIn3 = Input {
							SourceOp = "CustomTool1LUTIn3",
							Source = "Value"
						},
						LUTIn4 = Input {
							SourceOp = "CustomTool1LUTIn4",
							Source = "Value"
						},
						Intermediate7 = Input { Value = "0.9 + 0.1*getr3b(frac(x*5), frac(y*5))" },
						Intermediate8 = Input { Value = "1 - n5*max(0, 1 - max(min(-i4, -i5), 0)/max(n6, 0.0001))^2" },
						NumberIn2 = Input { Expression = "TearCtrl.TearAngle" },
						NumberIn3 = Input { Expression = "TearCtrl.TearRough" },
						NumberIn4 = Input { Expression = "TearCtrl.TearEdge" },
						GreenExpression = Input { Value = "if(n1 <= 0, g1, if(n1 >= 1, g2, if(i4 > 0, if(min(min((x - i2*cos(n2)), 1 - (x - i2*cos(n2))), min((y - i2*sin(n2)*w/h), 1 - (y - i2*sin(n2)*w/h))) < 0, g2, if(i4 > i6, getg1b((x - i2*cos(n2)), (y - i2*sin(n2)*w/h)), i7)), if(i5 > 0, if(min(min((x + i2*cos(n2)), 1 - (x + i2*cos(n2))), min((y + i2*sin(n2)*w/h), 1 - (y + i2*sin(n2)*w/h))) < 0, g2, if(i5 > i6*0.5, getg1b((x + i2*cos(n2)), (y + i2*sin(n2)*w/h)), i7)), g2*i8))))" },
						NumberIn5 = Input { Expression = "TearCtrl.TearShadow" },
						Image2 = Input {
							SourceOp = "SrcB",
							Source = "Output"
						},
						NumberIn6 = Input { Expression = "TearCtrl.TearShadowW" },
						BlueExpression = Input { Value = "if(n1 <= 0, b1, if(n1 >= 1, b2, if(i4 > 0, if(min(min((x - i2*cos(n2)), 1 - (x - i2*cos(n2))), min((y - i2*sin(n2)*w/h), 1 - (y - i2*sin(n2)*w/h))) < 0, b2, if(i4 > i6, getb1b((x - i2*cos(n2)), (y - i2*sin(n2)*w/h)), i7)), if(i5 > 0, if(min(min((x + i2*cos(n2)), 1 - (x + i2*cos(n2))), min((y + i2*sin(n2)*w/h), 1 - (y + i2*sin(n2)*w/h))) < 0, b2, if(i5 > i6*0.5, getb1b((x + i2*cos(n2)), (y + i2*sin(n2)*w/h)), i7)), b2*i8))))" },
						NumberIn7 = Input { Expression = "TearCtrl.F" },
						Intermediate1 = Input { Value = "0.5 + ((y - 0.5)*(h/w)*cos(n2) - (x - 0.5)*sin(n2))/(abs(sin(n2)) + (h/w)*abs(cos(n2)))" },
						NumberIn8 = Input { Expression = "TearCtrl.TearGap" },
						Image1 = Input {
							SourceOp = "SrcA",
							Source = "Output"
						},
						PointIn1 = Input { Expression = "Point(TearCtrl.TearOffset, TearCtrl.Slide)" },
						Image3 = Input {
							SourceOp = "TearNoise",
							Source = "Output"
						},
						NumberIn1 = Input { Expression = "TearCtrl.P" },
						RedExpression = Input { Value = "if(n1 <= 0, r1, if(n1 >= 1, r2, if(i4 > 0, if(min(min((x - i2*cos(n2)), 1 - (x - i2*cos(n2))), min((y - i2*sin(n2)*w/h), 1 - (y - i2*sin(n2)*w/h))) < 0, r2, if(i4 > i6, getr1b((x - i2*cos(n2)), (y - i2*sin(n2)*w/h)), i7)), if(i5 > 0, if(min(min((x + i2*cos(n2)), 1 - (x + i2*cos(n2))), min((y + i2*sin(n2)*w/h), 1 - (y + i2*sin(n2)*w/h))) < 0, r2, if(i5 > i6*0.5, getr1b((x + i2*cos(n2)), (y + i2*sin(n2)*w/h)), i7)), r2*i8))))" },
						Intermediate2 = Input { Value = "n8*min(max((n7 - i1)/0.12, 0), 1) + p1y" },
						Intermediate6 = Input { Value = "n4*(0.25 + 1.5*getr3b(0.71, frac(i1*3.7)))*min(i2/0.004, 1)" },
						Intermediate3 = Input { Value = "(x - 0.5)*cos(n2) + (y - 0.5)*(h/w)*sin(n2) - p1x - n3*2*(getr3b(0.27, 0.5 + 0.75*((y - 0.5)*(h/w)*cos(n2) - (x - 0.5)*sin(n2))) - 0.5)" },
						Intermediate5 = Input { Value = "-i3 - i2" },
						Intermediate4 = Input { Value = "i3 - i2" },
						AlphaExpression = Input { Value = "1" }
					},
					ViewInfo = OperatorInfo { Pos = { 275, 49.5 } }
				},
				CustomTool1LUTIn1 = LUTBezier {
					NameSet = true,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					},
					CtrlWZoom = false,
					SplineColor = { Blue = 0, Green = 0, Red = 0 }
				},
				CustomTool1LUTIn2 = LUTBezier {
					NameSet = true,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					},
					CtrlWZoom = false,
					SplineColor = { Blue = 0, Green = 0, Red = 0 }
				},
				CustomTool1LUTIn3 = LUTBezier {
					NameSet = true,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					},
					CtrlWZoom = false,
					SplineColor = { Blue = 0, Green = 0, Red = 0 }
				},
				CustomTool1LUTIn4 = LUTBezier {
					NameSet = true,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					},
					CtrlWZoom = false,
					SplineColor = { Blue = 0, Green = 0, Red = 0 }
				}
			
			}
		}
	},
	ActiveTool = "PaperTear"
}

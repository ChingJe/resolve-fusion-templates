						Seethe = Input { Expression = "HandCtrl.Step*0.37" },
						GlobalIn = Input { Value = -480 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Width = Input { Value = 960 },
						Height = Input { Value = 540 },
						Depth = Input { Value = 4 }
					}
				},
				HandPaper = FastNoise {
					ViewInfo = OperatorInfo { Pos = { -275, 148.5 } },
					Inputs = {
						Contrast = Input { Value = 1.5 },
						XScale = Input { Value = 60 },
						GlobalIn = Input { Value = -480 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Width = Input { Value = 960 },
						Height = Input { Value = 540 },
						Depth = Input { Value = 4 },
						Detail = Input { Value = 10 }
					}
				},
				HandFinal = Custom {
					ViewInfo = OperatorInfo { Pos = { 165, 49.5 } },
					Inputs = {
						Intermediate1 = Input { Value = "(getr2b(x, y) - 0.5)*2*n1" },
						Intermediate2 = Input { Value = "(getr2b(frac(x + 0.37), frac(y + 0.61)) - 0.5)*2*n1*w/h" },
						Intermediate3 = Input { Value = "0.5 + ((x - 0.5)*cos(n2) - (y - 0.5)*(h/w)*sin(n2))/n7 + p1x + i1" },
						Intermediate4 = Input { Value = "0.5 + ((x - 0.5)*(w/h)*sin(n2) + (y - 0.5)*cos(n2))/n7 + p1y + i2" },
						Intermediate5 = Input { Value = "(1 - n4*0.5 + n4*getr3b(x, y))*n5*(1 - n6*min(((x - 0.5)^2 + (y - 0.5)^2)*2.2, 1))" },
						Image1 = Input {
							SourceOp = "HandHold",
							Source = "Output"
						},
						Image2 = Input {
							SourceOp = "HandBoil",
							Source = "Output"
						},
						Image3 = Input {
							SourceOp = "HandPaper",
							Source = "Output"
						},
						NumberIn1 = Input { Expression = "HandCtrl.HmBoil" },
						NumberIn2 = Input { Expression = "HandCtrl.Twist" },
						BlueExpression = Input { Value = "if(n3 >= 2, floor(getb1d(i3, i4)*n3 + 0.5)/n3, getb1d(i3, i4))*i5" },
						NumberIn3 = Input { Expression = "HandCtrl.HmSteps" },
						GreenExpression = Input { Value = "if(n3 >= 2, floor(getg1d(i3, i4)*n3 + 0.5)/n3, getg1d(i3, i4))*i5" },
						NumberIn4 = Input { Expression = "HandCtrl.HmGrain" },
						LUTIn1 = Input {
							SourceOp = "CustomTool1LUTIn1",
							Source = "Value"
						},
						NumberIn5 = Input { Expression = "HandCtrl.Light" },
						LUTIn3 = Input {
							SourceOp = "CustomTool1LUTIn3",
							Source = "Value"
						},
						NumberIn6 = Input { Expression = "HandCtrl.HmEdge" },
						RedExpression = Input { Value = "if(n3 >= 2, floor(getr1d(i3, i4)*n3 + 0.5)/n3, getr1d(i3, i4))*i5" },
						NumberIn7 = Input { Expression = "1 + 2*HandCtrl.HmShift + 0.02*HandCtrl.HmTurn + 2*HandCtrl.HmBoil" },
						LUTIn2 = Input {
							SourceOp = "CustomTool1LUTIn2",
							Source = "Value"
						},
						PointIn1 = Input { Expression = "HandCtrl.Nudge" },
						LUTIn4 = Input {

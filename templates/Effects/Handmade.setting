							INP_Integer = false,
							LINKS_Name = "Paper Grain",
							INP_Default = 0.25,
							INP_MinScale = 0,
							INP_MaxScale = 1
						},
						HmFlicker = {
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Light Flicker",
							INP_Default = 0.05,
							INP_MinScale = 0,
							INP_MaxScale = 0.5
						},
						HmTurn = {
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Jitter Rotation",
							INP_Default = 0.4,
							INP_MinScale = 0,
							INP_MaxScale = 5
						},
						HmEdge = {
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Dark Corners",
							INP_Default = 0.25,
							INP_MinScale = 0,
							INP_MaxScale = 1
						},
						HmShift = {
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",

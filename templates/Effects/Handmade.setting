							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1000000
						},
						Nudge = {
							LINKID_DataType = "Point",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "OffsetControl",
							LINKS_Name = "Nudge"
						},
						Twist = {
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Twist",
							INP_Default = 0,
							INP_MinScale = -10,
							INP_MaxScale = 10
						}
					},
					ViewInfo = OperatorInfo { Pos = { -495, -82.5 } },
					Inputs = {
						Twist = Input { Expression = "HmTurn*(function(s) local v = math.sin(Step*12.9898 + s)*43758.5453 return (v - math.floor(v))*2 - 1 end)(4.1)" },
						Light = Input { Expression = "1 + HmFlicker*(function(s) local v = math.sin(Step*12.9898 + s)*43758.5453 return (v - math.floor(v))*2 - 1 end)(9.9)" },
						GlobalIn = Input { Value = -480 },
						Step = Input { Expression = "floor((time - comp.RenderStart)/max(HmHold, 1))" },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						UseFrameFormatSettings = Input { Value = 1 },
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						Nudge = Input { Expression = "Point(HmShift*(function(s) local v = math.sin(Step*12.9898 + s)*43758.5453 return (v - math.floor(v))*2 - 1 end)(1.3), HmShift*(function(s) local v = math.sin(Step*12.9898 + s)*43758.5453 return (v - math.floor(v))*2 - 1 end)(7.7))" },

						Inner = Input { Expression = "1 - 2*Border*Aspect" },
						Fit = Input { Expression = "PhotoSize * (6/max(PsCount, 6))^0.4" },
						Z = Input { Expression = "(function(t) return t*t*t*(t*(6*t - 15) + 10) end)(min(max((P - PsDone)/max(0.95 - PsDone, 0.01), 0), 1))" },
						GlobalIn = Input { Value = -480 },
						UseFrameFormatSettings = Input { Value = 1 },
						GlobalOut = Input { Value = 3534 },
						Height = Input { Value = 1080 },

							Expression = "(function(m, rs, re, at, speed)\n  if m == 1 then return rs + floor(at*(re - rs) + 0.5)\n  elseif m == 2 then return rs + (time - rs)*speed end\n  return time\nend)(StackCtrl.TableMode, comp.RenderStart, comp.RenderEnd, StackCtrl.TableAt, StackCtrl.TableSpeed)"
						},
						Input = Input {
							Source = "Output",
							SourceOp = "Src"
						}
					},
					ViewInfo = OperatorInfo { Pos = { -495, 181.5 } }
				},

					},
					CtrlWZoom = false,
					ViewInfo = OperatorInfo { Pos = { -495, -82.5 } },
					Inputs = {
						Land = Input { Expression = "iif(Arrive > 0, Arrive, max(PsDone - 0.01 - PsSlide, 0.02))" },
						Done = Input { Expression = "iif(Arrive > 0, min(Land + PsSlide + 0.01, 0.9), PsDone)" },
						Aspect = Input { Expression = "Width/Height" },
						Inner = Input { Expression = "1 - 2*Border*Aspect" },
						Fit = Input { Expression = "PhotoSize * (6/max(PsCount, 6))^0.4" },
						Gap = Input { Expression = "max(Land - 0.02, 0) / max(PsCount - 1, 1)" },
						GlobalIn = Input { Value = -480 },
						UseFrameFormatSettings = Input { Value = 1 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						Z = Input { Expression = "(function(t) return t*t*t*(t*(6*t - 15) + 10) end)(min(max((P - Done)/max(0.95 - Done, 0.01), 0), 1))" },
						P = Input { Expression = "min(max((time - comp.RenderStart) / max(comp.RenderEnd - comp.RenderStart, 1), 0), 1)" },
						Arrive = Input { Expression = "(function(txt, fps, len)\n  local stamp = txt:match(\"^%s*(%S+)\")\n  if not stamp then return -1 end\n  local f\n  local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^([%d%.]+)[fF]$\")\n  if pct then f = tonumber(pct) / 100 * len\n  elseif fr then f = tonumber(fr)\n  elseif stamp:match(\"^[%d:%.]+$\") then\n    local sec = 0\n    for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n    if sec then f = math.floor(sec * fps + 0.5) end\n  end\n  if not f or f <= 0 then return -1 end\n  return math.min(f / len, 0.6)\nend)(PsStart.Value, iif(FpsOverride > 0, FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24), max(comp.RenderEnd - comp.RenderStart, 1))" }
					}
				},
				Src = BrightnessContrast {
					ViewInfo = OperatorInfo { Pos = { -495, 16.5 } }
				},
				LiveFrame = TimeStretcher {
					Inputs = {
						Input = Input {
							Source = "Output",
							SourceOp = "Src"
						},
						InterpolateBetweenFrames = Input { Value = 0 },
						SourceTime = Input {
							Source = "Value",
							SourceOp = "TimeStretcher1源时间1",
							Expression = "(function(m, rs, re, p, z, land, done)\n  if m == 0 then return time\n  elseif m == 1 then return rs + floor(max(min(p, done) - land, 0)*(re - rs)*(1 - z) + 0.5)\n  elseif m == 2 then return rs end\n  return re\nend)(StackCtrl.PsLive, comp.RenderStart, comp.RenderEnd, StackCtrl.P, StackCtrl.Z, StackCtrl.Land, StackCtrl.Done)"
						},
						SampleSpread = Input { Disabled = true }
					},
					ViewInfo = OperatorInfo { Pos = { -495, 82.5 } }
				},
				["TimeStretcher1源时间1"] = BezierSpline {
					SplineColor = { Green = 217, Red = 233, Blue = 243 },
					NameSet = true,
					KeyFrames = {
						[210] = { 0, Flags = { Linear = true } }
					},
					CtrlWZoom = false
				},
				TableTime = TimeStretcher {
					Inputs = {
						SourceTime = Input {
							Source = "Value",

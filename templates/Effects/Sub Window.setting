						NumberIn5 = Input { Expression = "WinCtrl.WinShadow" },
						Intermediate8 = Input { Value = "if(p2y <= 0.0005, 0, n5*min(max(0.5 - (sqrt(max((abs((i1 - p4x)) - p2x + n2), 0)^2 + max((abs((i2 + p4x)) - p2y + n2), 0)^2) + min(max((abs((i1 - p4x)) - p2x + n2), (abs((i2 + p4x)) - p2y + n2)), 0) - n2)/p4y*0.5, 0), 1))" },

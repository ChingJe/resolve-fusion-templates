							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Size"
						},
						Box = {
							ICS_ControlPage = "Driver",
							INPID_InputControl = "OffsetControl",
							LINKS_Name = "Box",
							LINKID_DataType = "Point"
						},
						WinAspect = {
							INP_Default = 1.5,
							INP_MinScale = 0.3,
							INP_MaxScale = 3,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Width / Height"
						},
						WinFull = {
							{
								CCS_AddString = "Never"
							},
							{
								CCS_AddString = "At The Start, Then Shrinks Into The Window"
							},
							{
								CCS_AddString = "At The End, Growing Out Of The Window"
							},
							INP_Default = 0,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "ComboControl",
							INP_Integer = true,
							LINKS_Name = "Fills The Whole Frame"
						},
						WinRound = {
							INP_Default = 0.25,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Corner Roundness"
						},
						MB = {
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "MB"
						},
						WinTilt = {
							INP_Default = 0,
							INP_MinScale = -45,
							INP_MaxScale = 45,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Tilt (degrees)"
						},
						MS = {
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "MS"
						},
						WinBorder = {
							INP_Default = 0.008,
							INP_MinScale = 0,
							INP_MaxScale = 0.05,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Border"
						},
						Zm = {
							INP_Default = 1,
							INP_MinScale = 1,
							INP_MaxScale = 6,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Zm"
						},
						WinCaption = {
							INPS_DefaultText = "",
							TEC_Lines = 1,
							LINKID_DataType = "Text",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "TextEditControl",
							LINKS_Name = "Caption"
						},
						WinOut = {
							INP_Default = 6,
							INP_MinScale = 0,
							INP_MaxScale = 60,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Exit Frames"
						}
					},
					CtrlWZoom = false,
					Inputs = {
						GlobalIn = Input { Value = -480 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						MS = Input { Expression = "(1 - E) * (({0, 0.045, 0, 0.035, 0, 0, 0})[WinStyle + 1]*2*Hh + Bd*({1, 1, 1, 1, 1, 0, 3})[WinStyle + 1])" },
						T = Input { Expression = "iif(WinFull == 1, 1, min(max((time - comp.RenderStart + 1)/max(WinIn, 1), 0), 1))" },
						MB = Input { Expression = "(1 - E) * (({0, 0.2, 0, 0.035, 0, 0.12, 0})[WinStyle + 1]*2*Hh + Bd*({1, 1, 1, 1, 1, 0, 3})[WinStyle + 1])" },
						Gone = Input { Expression = "iif(WinOut <= 0 or WinFull == 2, 0, 1 - min(max((comp.RenderEnd - time + 1)/WinOut, 0), 1))" },
						E = Input { Expression = "(function(t) return t*t*(3 - 2*t) end)(iif(WinFull == 1, 1 - min((time - comp.RenderStart)/WinFullFrames, 1), iif(WinFull == 2, 1 - min((comp.RenderEnd - time)/WinFullFrames, 1), 0)))" },
						Wave = Input { Expression = "iif(WinIdle == 0, 0, T * (1 - E) * WinIdleAmount * sin(6.2831853 * WinIdleSpeed * (time - comp.RenderStart) / iif(FpsOverride > 0, FpsOverride, comp:GetPrefs('Comp.FrameFormat.Rate') or 24)))" },
						Ang = Input { Expression = "(WinTilt + iif(WinIdle == 2, 4*Wave, 0)) * (1 - E)" },
						Hh = Input { Expression = "WinSize*Scale/2 + (0.5 - WinSize*Scale/2)*E" },
						Bd = Input { Expression = "WinBorder * Scale" },
						UseFrameFormatSettings = Input { Value = 1 },
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						Scale = Input { Expression = "(function(e, t, g)\n  local s = 1\n  if e == 0 then local u = t - 1 s = 1 + 2.70158*u*u*u + 1.70158*u*u\n  elseif e == 1 then s = 1 - (1 - t)^3 end\n  if e <= 1 then s = s*(1 - g*g) end\n  return math.max(s, 0)\nend)(WinEnter, T, Gone)" },
						At0 = Input { Expression = "(function(e, t, g, px, py, sz)\n  if e ~= 2 then return Point(px, py) end\n  local u = (1 - t)^3 + g*g*g\n  local dx = (px < 0.5) and -(px + sz) or (1 - px + sz)\n  local dy = (py < 0.5) and -(py + sz) or (1 - py + sz)\n  if math.min(px, 1 - px) < math.min(py, 1 - py) then return Point(px + dx*u, py) end\n  return Point(px, py + dy*u)\nend)(WinEnter, T, Gone, WinPos.X, WinPos.Y, WinSize)" },
						At = Input { Expression = "Point(At0.X + (0.5 - At0.X)*E, At0.Y + iif(WinIdle == 1, 0.02*Wave, 0) + (0.5 - At0.Y)*E)" },
						Box = Input { Expression = "(function(a, full, e, hh) return Point(hh*(a + (full - a)*e), hh) end)(\n  iif(WinStyle == 3, 0.48, iif(WinShape == 0 and (WinStyle == 0 or WinStyle == 4 or WinStyle == 6), 1, WinAspect)),\n  SrcA.Output.Width / SrcA.Output.Height, E, Hh)" },
						Rad = Input { Expression = "(function(st, m, k, ms, round)\n  local R = m * k * (({round, 0.04, 0.08, 0.36, round, 0, round})[st + 1])\n  local r = 0\n  if st == 0 or st == 3 or st == 4 or st == 6 then r = math.max(R - ms, 0) end\n  if st == 5 then r = m * k * 0.06 end\n  return Point(R, r)\nend)(WinStyle, min(Box.X, Box.Y), 1 - E, MS, iif(WinShape == 0, 1, iif(WinShape == 2, 0, WinRound)))" },
						Lk = Input { Expression = "Point(WinLook.X + (0.5 - WinLook.X)*E, WinLook.Y + (0.5 - WinLook.Y)*E)" },
						Zm = Input { Expression = "WinZoom + (1 - WinZoom)*E" },
						TopLeftAlpha = Input { Value = 0 },
						Fade = Input { Expression = "iif(WinEnter == 3, T*(1 - Gone), iif(WinEnter == 2 or WinEnter == 4, 1, min(T*4, 1)))" },
						MT = Input { Expression = "(1 - E) * (({0, 0.045, 0.1, 0.035, 0, 0.12, 0})[WinStyle + 1]*2*Hh + Bd*({1, 1, 1, 1, 1, 0, 3})[WinStyle + 1])" }
					},
					ViewInfo = OperatorInfo { Pos = { -495, -82.5 } }
				},
				SrcA = BrightnessContrast {
					ViewInfo = OperatorInfo { Pos = { -495, 16.5 } }
				},
				WinPic = Custom {
					ViewInfo = OperatorInfo { Pos = { 55, 16.5 } },
					Inputs = {
						Intermediate2 = Input { Value = "(y - p1y)*cos(n1) - (x - p1x)*w/h*sin(n1) - p3y" },
						Intermediate3 = Input { Value = "if(p2y <= 0.0005, 0, min(max(0.5 - h*(sqrt(max((abs(i1) - p2x + n2), 0)^2 + max((abs(i2) - p2y + n2), 0)^2) + min(max((abs(i1) - p2x + n2), (abs(i2) - p2y + n2)), 0) - n2), 0), 1))" },
						RedExpression = Input { Value = "if(n5 >= 1, r1, i3*getr1d(p4x + n4*i1/(2*p2y)*(h/w)/n3, p4y + i2/(2*p2y)/n3))" },
						GreenExpression = Input { Value = "if(n5 >= 1, g1, i3*getg1d(p4x + n4*i1/(2*p2y)*(h/w)/n3, p4y + i2/(2*p2y)/n3))" },
						PointIn1 = Input { Expression = "WinCtrl.At" },
						AlphaExpression = Input { Value = "if(n5 >= 1, 1, i3)" },
						PointIn2 = Input { Expression = "Point(WinCtrl.Box.X - WinCtrl.MS, WinCtrl.Box.Y - (WinCtrl.MT + WinCtrl.MB)/2)" },
						LUTIn1 = Input {
							SourceOp = "CustomTool1LUTIn1",
							Source = "Value"
						},
						PointIn3 = Input { Expression = "Point(0, (WinCtrl.MB - WinCtrl.MT)/2)" },
						LUTIn2 = Input {
							SourceOp = "CustomTool1LUTIn2",
							Source = "Value"
						},
						PointIn4 = Input { Expression = "WinCtrl.Lk" },
						LUTIn4 = Input {

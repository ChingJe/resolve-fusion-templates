						NumberIn2 = Input { Expression = "WinCtrl.Rad.X" },
						Intermediate7 = Input { Value = "n8*if(n3 == 4, 0.72, 1)*min(max(0.5 - h*(if(n3 == 2, sqrt((i1 + p2x - p3x*(0.6 + i6*0.42))^2 + (i2 - p2y + p3x*0.5)^2) - p3x*0.15, if(n3 == 3, sqrt(max(abs(i1) - p2x*0.26, 0)^2 + (i2 - p2y + p3x + p2x*0.2)^2) - p2x*0.07, if(n3 == 4, max(abs(i1*0.996 - (i2 - p2y)*0.087) - p2y*0.42, abs((i2 - p2y)*0.996 + i1*0.087) - p2y*0.1), 1)))), 0), 1)" },

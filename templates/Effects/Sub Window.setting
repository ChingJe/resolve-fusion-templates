						Intermediate4 = Input { Value = "min(max(0.5 - h*(if(n3 == 5, max(abs(frac(i1/(p3x*1.1) + 100.5) - 0.5)*p3x*1.1 - p3x*0.3, abs(abs(i2) - p2y + p3x*0.5) - p3x*0.26), if(n3 == 6, if(n4 > 0, max(i3 + n4, -i3 - 2*n4), 1), 1))), 0), 1)" },
						GreenExpression = Input { Value = "n6*((g1 + max(i5 - a1, 0)*if(abs(n3 - 4) == 1, 0.03, getg2b(0.5, 0.5)))*(1 - i7) + i7*if(n3 == 2, if(i6 < 0.5, 0.37, if(i6 < 1.5, 0.74, 0.79)), if(n3 == 4, 0.87, 0.03)))" },
						BlueExpression = Input { Value = "n6*((b1 + max(i5 - a1, 0)*if(abs(n3 - 4) == 1, 0.03, getb2b(0.5, 0.5)))*(1 - i7) + i7*if(n3 == 2, if(i6 < 0.5, 0.34, if(i6 < 1.5, 0.18, 0.25)), if(n3 == 4, 0.66, 0.03)))" },
						PointIn1 = Input { Expression = "WinCtrl.At" },
						AlphaExpression = Input { Value = "n6*(i5 + (1 - i5)*i7 + (1 - i5)*(1 - i7)*i8)" },

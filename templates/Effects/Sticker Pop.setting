{
	Tools = ordered() {
		StickerPop = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "SrcA", Source = "Input" },
				Input1 = InstanceInput { SourceOp = "StkCtrl", Source = "StkSize", Name = "Size" },
				Input2 = InstanceInput { SourceOp = "StkCtrl", Source = "StkTilt", Name = "Tilt (degrees)" },
				Input3 = InstanceInput { SourceOp = "StkCtrl", Source = "StkFlip", Name = "Mirror" },
				Input4 = InstanceInput { SourceOp = "StkCtrl", Source = "StkEnter", Name = "Entrance" },
				Input5 = InstanceInput { SourceOp = "StkCtrl", Source = "StkIn", Name = "Entrance Frames" },
				Input6 = InstanceInput { SourceOp = "StkCtrl", Source = "StkOut", Name = "Exit Frames" },
				Input7 = InstanceInput { SourceOp = "StkCtrl", Source = "StkBounce", Name = "Bounce" },
				Input8 = InstanceInput { SourceOp = "StkCtrl", Source = "StkIdle", Name = "While It Stays" },
				Input9 = InstanceInput { SourceOp = "StkCtrl", Source = "StkAmount", Name = "Movement Amount" },
				Input10 = InstanceInput { SourceOp = "StkCtrl", Source = "StkSpeed", Name = "Movements Per Second" },
				Input11 = InstanceInput { SourceOp = "StkCtrl", Source = "StkOutline", Name = "Outline Width" },
				Input12 = InstanceInput { SourceOp = "StkCtrl", Source = "StkShadow", Name = "Shadow" },
				Input13 = InstanceInput { SourceOp = "StkCtrl", Source = "StkShadowOff", Name = "Shadow Distance" },
				Input14 = InstanceInput { SourceOp = "StkCtrl", Source = "StkShadowSoft", Name = "Shadow Softness" },
				Input15 = InstanceInput { SourceOp = "StkCtrl", Source = "FpsOverride", Name = "Frame Rate Override" },
				Input16 = InstanceInput { SourceOp = "ColStkOutline", Source = "TopLeftRed", Name = "Outline Colour", ControlGroup = 3 },
				Input17 = InstanceInput { SourceOp = "ColStkOutline", Source = "TopLeftGreen", ControlGroup = 3 },
				Input18 = InstanceInput { SourceOp = "ColStkOutline", Source = "TopLeftBlue", ControlGroup = 3 },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "StkFinal", Source = "Output" }
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				SrcA = BrightnessContrast {
					ViewInfo = OperatorInfo { Pos = { -495, 16.5 } }
				},
				StkMove = Transform {
					Inputs = {
						Angle = Input { Expression = "StkCtrl.Ang" },
						FlipHoriz = Input { Expression = "StkCtrl.StkFlip" },
						Input = Input {
							Source = "Output",
							SourceOp = "SrcA"
						},
						Size = Input { Expression = "StkCtrl.Scale" },
						Center = Input { Expression = "StkCtrl.At" }
					},
					ViewInfo = OperatorInfo { Pos = { -275, 16.5 } }
				},
				StkRoom = SetDomain {
					Inputs = {
						Input = Input {
							Source = "Output",
							SourceOp = "StkMove"
						},
						Mode = Input { Value = FuID { "Set" } }
					},
					ViewInfo = OperatorInfo { Pos = { -165, 16.5 } }
				},
				StkGrow = ErodeDilate {
					Inputs = {
						Filter = Input { Value = 3 },
						XAmount = Input { Expression = "StkCtrl.StkOutline * StkCtrl.Scale" },
						Input = Input {
							Source = "Output",
							SourceOp = "StkRoom"
						}
					},
					ViewInfo = OperatorInfo { Pos = { -55, 49.5 } }
				},
				ColStkOutline = Background {
					Inputs = {
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						TopLeftBlue = Input { Value = 1 },
						TopLeftGreen = Input { Value = 1 },
						Width = Input { Value = 16 },
						Height = Input { Value = 16 },
						TopLeftRed = Input { Value = 1 },
						GlobalIn = Input { Value = -480 },
						GlobalOut = Input { Value = 3534 }
					},
					ViewInfo = OperatorInfo { Pos = { -275, -148.5 } }
				},
				StkInk = Custom {
					Inputs = {
						Image3 = Input {
							Source = "Output",
							SourceOp = "ColStkOutline"
						},
						Image2 = Input {
							Source = "Output",
							SourceOp = "StkGrow"
						},
						Image1 = Input {
							Source = "Output",
							SourceOp = "StkRoom"
						},
						AlphaExpression = Input { Value = "a1 + i1" },
						BlueExpression = Input { Value = "b1 + i1*getb3b(0.5, 0.5)" },
						LUTIn2 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn2"
						},
						RedExpression = Input { Value = "r1 + i1*getr3b(0.5, 0.5)" },
						LUTIn1 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn1"
						},
						GreenExpression = Input { Value = "g1 + i1*getg3b(0.5, 0.5)" },
						NumberIn1 = Input { Expression = "iif(StkCtrl.StkOutline > 0, 1, 0)" },
						LUTIn4 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn4"
						},
						LUTIn3 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn3"
						},
						Intermediate1 = Input { Value = "(1 - a1)*a2*n1" }
					},
					ViewInfo = OperatorInfo { Pos = { 55, 16.5 } }
				},
				CustomTool1LUTIn1 = LUTBezier {
					SplineColor = { Blue = 0, Red = 0, Green = 0 },
					CtrlWZoom = false,
					NameSet = true,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					}
				},
				CustomTool1LUTIn2 = LUTBezier {
					SplineColor = { Blue = 0, Red = 0, Green = 0 },
					CtrlWZoom = false,
					NameSet = true,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					}
				},
				CustomTool1LUTIn3 = LUTBezier {
					SplineColor = { Blue = 0, Red = 0, Green = 0 },
					CtrlWZoom = false,
					NameSet = true,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					}
				},
				CustomTool1LUTIn4 = LUTBezier {
					SplineColor = { Blue = 0, Red = 0, Green = 0 },
					CtrlWZoom = false,
					NameSet = true,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					}
				},
				StkSoft = Blur {
					Inputs = {
						Filter = Input { Value = FuID { "Fast Gaussian" } },
						Input = Input {
							Source = "Output",
							SourceOp = "StkInk"
						},
						XBlurSize = Input { Expression = "StkCtrl.StkShadowSoft * 60" }
					},
					ViewInfo = OperatorInfo { Pos = { 55, 49.5 } }
				},
				StkFinal = Custom {
					Inputs = {
						Image2 = Input {
							Source = "Output",
							SourceOp = "StkSoft"
						},
						NumberIn2 = Input { Expression = "StkCtrl.StkShadowOff" },
						Image1 = Input {
							Source = "Output",
							SourceOp = "StkInk"
						},
						NumberIn3 = Input { Expression = "StkCtrl.Fade" },
						AlphaExpression = Input { Value = "n3*(a1 + (1 - a1)*n1*geta2b(x - n2*h/w, y + n2))" },
						BlueExpression = Input { Value = "b1*n3" },
						RedExpression = Input { Value = "r1*n3" },
						LUTIn1 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn11"
						},
						LUTIn2 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn21"
						},
						LUTIn3 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn31"
						},
						LUTIn4 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn41"
						},
						GreenExpression = Input { Value = "g1*n3" },
						NumberIn1 = Input { Expression = "StkCtrl.StkShadow" }
					},
					ViewInfo = OperatorInfo { Pos = { 165, 16.5 } }
				},
				CustomTool1LUTIn11 = LUTBezier {
					SplineColor = { Blue = 0, Red = 0, Green = 0 },
					CtrlWZoom = false,
					NameSet = true,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					}
				},
				CustomTool1LUTIn21 = LUTBezier {
					SplineColor = { Blue = 0, Red = 0, Green = 0 },
					CtrlWZoom = false,
					NameSet = true,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					}
				},
				CustomTool1LUTIn31 = LUTBezier {
					SplineColor = { Blue = 0, Red = 0, Green = 0 },
					CtrlWZoom = false,
					NameSet = true,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					}
				},
				CustomTool1LUTIn41 = LUTBezier {
					SplineColor = { Blue = 0, Red = 0, Green = 0 },
					CtrlWZoom = false,
					NameSet = true,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					}
				},
				StkCtrl = Background {
					Inputs = {
						Fade = Input { Expression = "iif(StkEnter == 3, T*(1 - Gone), iif(StkEnter == 4, 1, min(T*4, 1)))" },
						UseFrameFormatSettings = Input { Value = 1 },
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						Ang = Input { Expression = "(function(e, t, idle, wave, amt)\n  local a = 0\n  if e == 1 then a = -220*(1 - t)^3 end\n  if idle == 1 then a = a + 6*wave end\n  if idle == 4 then a = a + 3*amt*t*(math.sin(time*91.7)*43758.5453 % 1 - 0.5) end\n  return a\nend)(StkEnter, T, StkIdle, Wave, StkAmount) + StkTilt" },
						GlobalIn = Input { Value = -480 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Wave = Input { Expression = "T * StkAmount * sin(6.2831853 * StkSpeed * (time - comp.RenderStart) / iif(FpsOverride > 0, FpsOverride, comp:GetPrefs('Comp.FrameFormat.Rate') or 24))" },
						At = Input { Expression = "(function(e, t, idle, wave, amt, b)\n  local x, y = 0.5, 0.5\n  if e == 2 then\n    local u, k = t, 1\n    if u < 0.3636 then k = 7.5625*u*u\n    elseif u < 0.7273 then u = u - 0.5455 k = 1 - b*(0.25 - 7.5625*u*u)\n    elseif u < 0.9091 then u = u - 0.8182 k = 1 - b*(0.0625 - 7.5625*u*u)\n    else u = u - 0.9545 k = 1 - b*(0.015625 - 7.5625*u*u) end\n    y = y + (t < 0.3636 and 1.1 or 0.4)*(1 - k)\n  end\n  if idle == 2 then y = y + 0.025*wave end\n  if idle == 4 then\n    x = x + 0.008*amt*t*(math.sin(time*12.9898)*43758.5453 % 1 - 0.5)\n    y = y + 0.008*amt*t*(math.sin(time*78.233)*43758.5453 % 1 - 0.5)\n  end\n  return Point(x, y)\nend)(StkEnter, T, StkIdle, Wave, StkAmount, StkBounce)" },
						TopLeftAlpha = Input { Value = 0 },
						Gone = Input { Expression = "iif(StkOut <= 0, 0, 1 - min(max((comp.RenderEnd - time + 1)/StkOut, 0), 1))" },
						T = Input { Expression = "min(max((time - comp.RenderStart + 1)/max(StkIn, 1), 0), 1)" },
						Scale = Input { Expression = "(function(e, t, g, b, idle, wave)\n  local s = 1\n  if e <= 1 then local u = t - 1 s = 1 + (1.70158*b + 1)*u*u*u + 1.70158*b*u*u end\n  if e <= 2 then s = s*(1 - g*g) end\n  if idle == 3 then s = s*(1 + 0.06*wave) end\n  return math.max(s, 0)\nend)(StkEnter, T, Gone, StkBounce, StkIdle, Wave) * StkSize" }
					},
					CtrlWZoom = false,
					UserControls = {
						Fade = {
							INP_MaxScale = 1,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Fade",
							INP_Default = 1,
							INP_MinScale = 0
						},
						StkAmount = {

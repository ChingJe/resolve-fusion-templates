{
	Tools = ordered() {
		FreezeFrame = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "SrcA", Source = "Input" },
				Input1 = InstanceInput { SourceOp = "FrzCtrl", Source = "FrzList", Name = "Freezes (0:00 seconds)" },
				Input2 = InstanceInput { SourceOp = "FrzCtrl", Source = "FrzAfter", Name = "After A Freeze" },
				Input3 = InstanceInput { SourceOp = "FrzCtrl", Source = "FpsOverride", Name = "Frame Rate Override" },
				Input4 = InstanceInput { SourceOp = "FrzCtrl", Source = "FrzLook", Name = "Colour" },
				Input5 = InstanceInput { SourceOp = "FrzCtrl", Source = "FrzZoom", Name = "Push In" },
				Input6 = InstanceInput { SourceOp = "FrzCtrl", Source = "FrzCenter", Name = "Push In Towards" },
				Input7 = InstanceInput { SourceOp = "FrzCtrl", Source = "FrzFlash", Name = "Flash" },
				Input8 = InstanceInput { SourceOp = "FrzCtrl", Source = "FrzEdge", Name = "Dark Corners" },
				Input9 = InstanceInput { SourceOp = "FrzCtrl", Source = "FrzIn", Name = "Settle Time (seconds)" },
				Input10 = InstanceInput { SourceOp = "ColFrzTint", Source = "TopLeftRed", Name = "Tint Colour", ControlGroup = 3 },
				Input11 = InstanceInput { SourceOp = "ColFrzTint", Source = "TopLeftGreen", ControlGroup = 3 },
				Input12 = InstanceInput { SourceOp = "ColFrzTint", Source = "TopLeftBlue", ControlGroup = 3 },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "FrzFinal", Source = "Output" }
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				FrzCtrl = Background {
					ViewInfo = OperatorInfo { Pos = { -495, -82.5 } },
					Inputs = {
						UseFrameFormatSettings = Input { Value = 1 },
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						GlobalIn = Input { Value = -480 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						State = Input { Expression = "(function(txt, fps, len, now, t0, after, pick)\n  local list = {}\n  for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n    local stamp, d = line:match(\"^%s*(%S+)%s*([%d%.]*)\")\n    if stamp then\n      local sec\n      local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n      if pct then sec = tonumber(pct) / 100 * len / fps\n      elseif fr then sec = tonumber(fr) / fps\n      elseif stamp:match(\"^[%d:%.]+$\") then\n        sec = 0\n        for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n      end\n      if sec then list[#list + 1] = {sec, tonumber(d) or 1} end\n    end\n  end\n  table.sort(list, function(a, b) return a[1] < b[1] end)\n  local ts = (now - t0) / fps\n  local late, since, left, src = 0, -1, 0, ts\n  for _, f in ipairs(list) do\n    -- in \"carry on\" mode every earlier freeze pushes the later ones back\n    local start = f[1] + (after == 1 and late or 0)\n    if ts >= start and ts < start + f[2] then since, left, src = ts - start, start + f[2] - ts, f[1] break end\n    if ts >= start + f[2] then late = late + f[2] end\n  end\n  if since < 0 then src = (after == 1) and ts - late or ts end\n  if pick == 1 then return t0 + math.floor(src * fps + 0.5) end\n  return Point(since, left)\nend)(FrzList.Value, iif(FpsOverride > 0, FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24),\n  max(comp.RenderEnd - comp.RenderStart, 1), time, comp.RenderStart, FrzAfter, 2)" },
						Src = Input { Expression = "(function(txt, fps, len, now, t0, after, pick)\n  local list = {}\n  for line in (txt .. \"\\n\"):gmatch(\"(.-)\\r?\\n\") do\n    local stamp, d = line:match(\"^%s*(%S+)%s*([%d%.]*)\")\n    if stamp then\n      local sec\n      local pct, fr = stamp:match(\"^([%d%.]+)%%$\"), stamp:match(\"^(%d+)[fF]$\")\n      if pct then sec = tonumber(pct) / 100 * len / fps\n      elseif fr then sec = tonumber(fr) / fps\n      elseif stamp:match(\"^[%d:%.]+$\") then\n        sec = 0\n        for part in stamp:gmatch(\"[^:]+\") do sec = sec and tonumber(part) and sec * 60 + tonumber(part) end\n      end\n      if sec then list[#list + 1] = {sec, tonumber(d) or 1} end\n    end\n  end\n  table.sort(list, function(a, b) return a[1] < b[1] end)\n  local ts = (now - t0) / fps\n  local late, since, left, src = 0, -1, 0, ts\n  for _, f in ipairs(list) do\n    -- in \"carry on\" mode every earlier freeze pushes the later ones back\n    local start = f[1] + (after == 1 and late or 0)\n    if ts >= start and ts < start + f[2] then since, left, src = ts - start, start + f[2] - ts, f[1] break end\n    if ts >= start + f[2] then late = late + f[2] end\n  end\n  if since < 0 then src = (after == 1) and ts - late or ts end\n  if pick == 1 then return t0 + math.floor(src * fps + 0.5) end\n  return Point(since, left)\nend)(FrzList.Value, iif(FpsOverride > 0, FpsOverride, comp:GetPrefs(\"Comp.FrameFormat.Rate\") or 24),\n  max(comp.RenderEnd - comp.RenderStart, 1), time, comp.RenderStart, FrzAfter, 1)" },
						TopLeftAlpha = Input { Value = 0 }
					},
					UserControls = {
						FrzZoom = {
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Push In",
							INP_Default = 0.15,
							INP_MinScale = 0,
							INP_MaxScale = 1
						},
						FrzCenter = {
							LINKID_DataType = "Point",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "OffsetControl",
							LINKS_Name = "Push In Towards",
							INPID_PreviewControl = "CrosshairControl"
						},
						FrzAfter = {
							{
								CCS_AddString = "Jump Ahead (stays with the sound)"
							},
							{
								CCS_AddString = "Carry On From The Frozen Frame (picture runs late)"
							},
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "ComboControl",
							LINKS_Name = "After A Freeze",
							INP_Default = 0,
							INP_Integer = true
						},
						FrzFlash = {
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Flash",
							INP_Default = 0.6,
							INP_MinScale = 0,
							INP_MaxScale = 3
						},
						FrzEdge = {
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Dark Corners",
							INP_Default = 0.4,
							INP_MinScale = 0,
							INP_MaxScale = 1
						},
						FpsOverride = {
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Frame Rate Override",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 120
						},
						FrzIn = {
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Settle Time (seconds)",
							INP_Default = 0.25,
							INP_MinScale = 0.02,
							INP_MaxScale = 2
						},
						FrzLook = {
							{
								CCS_AddString = "Unchanged"
							},
							{
								CCS_AddString = "Black And White"
							},
							{
								CCS_AddString = "Tinted"
							},
							{
								CCS_AddString = "High Contrast"
							},
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "ComboControl",
							LINKS_Name = "Colour",
							INP_Default = 1,
							INP_Integer = true
						},
						State = {
							LINKID_DataType = "Point",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "OffsetControl",
							LINKS_Name = "State"
						},
						Src = {
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Src",
							INP_Default = 0,
							INP_MinScale = -1000000,
							INP_MaxScale = 1000000
						},
						FrzList = {
							LINKID_DataType = "Text",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "TextEditControl",
							LINKS_Name = "Freezes (0:00 seconds)",
							INPS_DefaultText = "0:01.5 1.5",
							TEC_Lines = 5
						}
					},
					CtrlWZoom = false
				},
				SrcA = BrightnessContrast {
					ViewInfo = OperatorInfo { Pos = { -495, 16.5 } }
				},
				FrzHold = TimeStretcher {
					Inputs = {
						InterpolateBetweenFrames = Input { Value = 0 },
						SourceTime = Input {
							Expression = "FrzCtrl.Src",
							Source = "Value",
							SourceOp = "TimeStretcher1源时间"
						},
						Input = Input {
							Source = "Output",
							SourceOp = "SrcA"
						},
						SampleSpread = Input { Disabled = true }
					},
					ViewInfo = OperatorInfo { Pos = { -275, 49.5 } }
				},
				["TimeStretcher1源时间"] = BezierSpline {
					SplineColor = { Red = 233, Green = 217, Blue = 243 },
					NameSet = true,
					CtrlWZoom = false,
					KeyFrames = {
						[200] = { 0, Flags = { Linear = true } }
					}
				},
				ColFrzTint = Background {
					Inputs = {
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						TopLeftGreen = Input { Value = 0.82 },
						TopLeftBlue = Input { Value = 0.25 },
						Width = Input { Value = 16 },
						Height = Input { Value = 16 },
						GlobalIn = Input { Value = -480 },
						TopLeftRed = Input { Value = 1 },
						GlobalOut = Input { Value = 3534 }
					},
					ViewInfo = OperatorInfo { Pos = { -275, -148.5 } }
				},
				FrzFinal = Custom {
					Inputs = {
						NumberIn3 = Input { Expression = "FrzCtrl.FrzZoom" },
						NumberIn4 = Input { Expression = "iif(FrzCtrl.State.X < 0, 0, FrzCtrl.FrzFlash * max(1 - FrzCtrl.State.X/0.25, 0)^2)" },
						NumberIn5 = Input { Expression = "FrzCtrl.FrzEdge" },
						PointIn1 = Input { Expression = "FrzCtrl.FrzCenter" },
						Intermediate1 = Input { Value = "p1x + (x - p1x)/(1 + n3*n1)" },
						Intermediate2 = Input { Value = "p1y + (y - p1y)/(1 + n3*n1)" },
						Intermediate3 = Input { Value = "0.299*getr1b(i1, i2) + 0.587*getg1b(i1, i2) + 0.114*getb1b(i1, i2)" },
						Intermediate4 = Input { Value = "min(max((i3 - 0.45)*6 + 0.5, 0), 1)" },
						Intermediate5 = Input { Value = "1 - n5*n1*min(((x - 0.5)^2 + (y - 0.5)^2)*2.2, 1)" },
						LUTIn1 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn1"
						},
						LUTIn2 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn2"
						},
						LUTIn3 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn3"
						},
						LUTIn4 = Input {
							Source = "Value",
							SourceOp = "CustomTool1LUTIn4"
						},
						Image1 = Input {
							Source = "Output",
							SourceOp = "FrzHold"
						},
						RedExpression = Input { Value = "if(n1 <= 0 && n4 <= 0, r1, (getr1b(i1, i2) + (if(n2 == 0, getr1b(i1, i2), if(n2 == 1, i3, if(n2 == 2, i3*getr2b(0.5, 0.5)*1.2, i4*(0.35 + 0.65*getr2b(0.5, 0.5)) + (1 - i4)*0.06))) - getr1b(i1, i2))*n1)*i5 + n4)" },
						NumberIn1 = Input { Expression = "iif(FrzCtrl.State.X < 0, 0, (function(t) return t*t*(3 - 2*t) end)(min(FrzCtrl.State.X/FrzCtrl.FrzIn, FrzCtrl.State.Y/min(FrzCtrl.FrzIn, 0.12), 1)))" },
						GreenExpression = Input { Value = "if(n1 <= 0 && n4 <= 0, g1, (getg1b(i1, i2) + (if(n2 == 0, getg1b(i1, i2), if(n2 == 1, i3, if(n2 == 2, i3*getg2b(0.5, 0.5)*1.2, i4*(0.35 + 0.65*getg2b(0.5, 0.5)) + (1 - i4)*0.06))) - getg1b(i1, i2))*n1)*i5 + n4)" },
						Image2 = Input {
							Source = "Output",
							SourceOp = "ColFrzTint"
						},
						BlueExpression = Input { Value = "if(n1 <= 0 && n4 <= 0, b1, (getb1b(i1, i2) + (if(n2 == 0, getb1b(i1, i2), if(n2 == 1, i3, if(n2 == 2, i3*getb2b(0.5, 0.5)*1.2, i4*(0.35 + 0.65*getb2b(0.5, 0.5)) + (1 - i4)*0.06))) - getb1b(i1, i2))*n1)*i5 + n4)" },
						NumberIn2 = Input { Expression = "FrzCtrl.FrzLook" }
					},
					ViewInfo = OperatorInfo { Pos = { 165, 49.5 } }
				},
				CustomTool1LUTIn1 = LUTBezier {
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					},
					NameSet = true,
					CtrlWZoom = false,
					SplineColor = { Red = 0, Green = 0, Blue = 0 }
				},
				CustomTool1LUTIn2 = LUTBezier {
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					},
					NameSet = true,
					CtrlWZoom = false,
					SplineColor = { Red = 0, Green = 0, Blue = 0 }
				},
				CustomTool1LUTIn3 = LUTBezier {
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					},
					NameSet = true,
					CtrlWZoom = false,
					SplineColor = { Red = 0, Green = 0, Blue = 0 }
				},
				CustomTool1LUTIn4 = LUTBezier {
					KeyColorSplines = {
						[0] = {
							[0] = { 0, Flags = { Linear = true }, RH = { 0.333333333333333, 0.333333333333333 } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					},
					NameSet = true,
					CtrlWZoom = false,
					SplineColor = { Red = 0, Green = 0, Blue = 0 }
				}
			
			}
		}
	},
	ActiveTool = "FreezeFrame"
}

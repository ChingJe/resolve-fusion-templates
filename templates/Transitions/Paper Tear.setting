						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						UseFrameFormatSettings = Input { Value = 1 },
						Width = Input { Value = 1920 }
					},
					ViewInfo = OperatorInfo { Pos = { -275, 115.5 } }
				},
				TearField = Custom {
					Inputs = {
						AlphaExpression = Input { Value = "0.9 + 0.1*getr2b(frac(x*5), frac(y*5))" },
						NumberIn2 = Input { Expression = "TearCtrl.TearAngle" },
						NumberIn3 = Input { Expression = "TearCtrl.TearRough" },
						Image2 = Input {
							SourceOp = "TearNoise",
							Source = "Output"
						},
						Image1 = Input {
							SourceOp = "TearBase",
							Source = "Output"
						},
						Intermediate1 = Input { Value = "(y - 0.5)*(h/w)*cos(n2) - (x - 0.5)*sin(n2)" },
						BlueExpression = Input { Value = "0.25 + 1.5*getr2b(0.71, frac(i2*3.7))" },
						Intermediate2 = Input { Value = "0.5 + i1/(abs(sin(n2)) + (h/w)*abs(cos(n2)))" },
						GreenExpression = Input { Value = "i2" },
						RedExpression = Input { Value = "(x - 0.5)*cos(n2) + (y - 0.5)*(h/w)*sin(n2) - n1 - n3*2*(getr2b(0.27, 0.5 + 0.75*i1) - 0.5)" },
						LUTIn1 = Input {
							SourceOp = "CustomTool1LUTIn1",
							Source = "Value"
						},
						LUTIn2 = Input {
							SourceOp = "CustomTool1LUTIn2",
							Source = "Value"
						},
						LUTIn3 = Input {
							SourceOp = "CustomTool1LUTIn3",
							Source = "Value"
						},
						LUTIn4 = Input {
							SourceOp = "CustomTool1LUTIn4",
							Source = "Value"
						},
						NumberIn1 = Input { Expression = "TearCtrl.TearOffset" }
					},
					ViewInfo = OperatorInfo { Pos = { -55, 115.5 } }
				},
				CustomTool1LUTIn1 = LUTBezier {
					CtrlWZoom = false,
					SplineColor = { Red = 0, Green = 0, Blue = 0 },
					NameSet = true,
					KeyColorSplines = {

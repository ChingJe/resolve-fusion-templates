							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "EaseA",
							INP_Default = 0
						},
						EaseB = {
							INP_MinScale = 0,
							INP_MaxScale = 1,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",

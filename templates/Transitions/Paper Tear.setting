							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "Q",
							INP_Default = 0
						}
					},
					ViewInfo = OperatorInfo { Pos = { -495, -82.5 } }
				},
				TearProgress = LUTLookup {
					CtrlWZoom = false,
					Inputs = {
						Lookup = Input {
							SourceOp = "AnimCurves1查找表",

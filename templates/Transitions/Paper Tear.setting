{
	Tools = ordered() {
		PaperTear = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "SrcA", Source = "Input" },
				MainInput2 = InstanceInput { SourceOp = "SrcB", Source = "Input" },
				Input1 = InstanceInput { SourceOp = "TearCtrl", Source = "TearAngle", Name = "Angle" },
				Input2 = InstanceInput { SourceOp = "TearCtrl", Source = "TearOffset", Name = "Line Position" },
				Input3 = InstanceInput { SourceOp = "TearCtrl", Source = "TearGap", Name = "Rip Gap" },
				Input4 = InstanceInput { SourceOp = "TearCtrl", Source = "TearRough", Name = "Roughness" },
				Input5 = InstanceInput { SourceOp = "TearCtrl", Source = "TearSeed", Name = "Tear Shape" },
				Input6 = InstanceInput { SourceOp = "TearCtrl", Source = "TearEdge", Name = "Paper Edge Width" },
				Input7 = InstanceInput { SourceOp = "TearCtrl", Source = "TearShadow", Name = "Shadow" },
				Input8 = InstanceInput { SourceOp = "TearCtrl", Source = "TearShadowW", Name = "Shadow Width" },
				Input9 = InstanceInput { SourceOp = "TearCtrl", Source = "TearRip", Name = "Rip Time" },
				Input10 = InstanceInput { SourceOp = "TearCtrl", Source = "TearSwing", Name = "Swing (degrees)" },
				Input11 = InstanceInput { SourceOp = "TearCtrl", Source = "TearStagger", Name = "Second Half Delay" },
				Input12 = InstanceInput { SourceOp = "TearCtrl", Source = "TearSteps", Name = "Stop Motion Steps" },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "TearCut", Source = "Output" }
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				TearCtrl = Background {
					CtrlWZoom = false,
					Inputs = {
						Height = Input { Value = 1080 },
						U = Input { Expression = "min(max((Q - TearRip)/max(1 - TearRip, 0.001), 0), 1)" },
						EaseA = Input { Expression = "(function(t) t = min(max(t, 0), 1) return t*t*(2 - t) end)(U/(1 - TearStagger))" },
						EaseB = Input { Expression = "(function(t) t = min(max(t, 0), 1) return t*t*(2 - t) end)((U - TearStagger)/(1 - TearStagger))" },
						Pivot = Input { Expression = "(function(a, asp) local s = 0.5*(abs(sin(a)) + abs(cos(a))/asp) return Point(0.5 + cos(a)*TearOffset - sin(a)*s, 0.5 + (sin(a)*TearOffset + cos(a)*s)*asp) end)(math.rad(TearAngle), (comp:GetPrefs('Comp.FrameFormat.Width')/comp:GetPrefs('Comp.FrameFormat.Height')))" },
						MoveA = Input { Expression = "(function(a, asp, e, far) return Point(0.5 + (cos(a)*far + sin(a)*0.18)*e, 0.5 + (sin(a)*far - cos(a)*0.18)*e*asp) end)(math.rad(TearAngle), (comp:GetPrefs('Comp.FrameFormat.Width')/comp:GetPrefs('Comp.FrameFormat.Height')), EaseA, 0.5*(abs(cos(math.rad(TearAngle))) + abs(sin(math.rad(TearAngle)))/(comp:GetPrefs('Comp.FrameFormat.Width')/comp:GetPrefs('Comp.FrameFormat.Height'))) + abs(TearOffset) + TearRough + 0.05)" },
						MoveB = Input { Expression = "(function(a, asp, e, far) return Point(0.5 + (-cos(a)*far + sin(a)*0.18)*e, 0.5 + (-sin(a)*far - cos(a)*0.18)*e*asp) end)(math.rad(TearAngle), (comp:GetPrefs('Comp.FrameFormat.Width')/comp:GetPrefs('Comp.FrameFormat.Height')), EaseB, 0.5*(abs(cos(math.rad(TearAngle))) + abs(sin(math.rad(TearAngle)))/(comp:GetPrefs('Comp.FrameFormat.Width')/comp:GetPrefs('Comp.FrameFormat.Height'))) + abs(TearOffset) + TearRough + 0.05)" },
						Q = Input { Expression = "iif(TearSteps >= 1, floor(P*TearSteps + 0.5)/max(TearSteps, 1), P)" },
						P = Input {
							SourceOp = "TearProgress",
							Source = "Value"
						},
						GlobalIn = Input { Value = -480 },
						F = Input { Expression = "Q/TearRip" },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						UseFrameFormatSettings = Input { Value = 1 },
						Width = Input { Value = 1920 }
					},
					UserControls = {
						F = {
							INP_MinScale = -1,
							INP_MaxScale = 20,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",
							INP_Integer = false,
							LINKS_Name = "F",
							INP_Default = 0
						},
						U = {
							INP_MinScale = 0,
							INP_MaxScale = 1,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl",

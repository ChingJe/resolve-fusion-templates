						NumberIn4 = Input { Expression = "GcCtrl.GcShift" },
						NumberIn5 = Input { Expression = "GcCtrl.GcSplit" },
						NumberIn6 = Input { Expression = "floor(time/max(GcCtrl.GcHold, 1))" },
						RedExpression = Input { Value = "if(n1 <= 0, if(n2 >= 0.5, r2, r1), if(i8 > 0, getr2b(frac(i6 + 1*n5*n1*(0.5 + i1) + 4), i7), getr1b(frac(i6 + 1*n5*n1*(0.5 + i1) + 4), i7))*(1 - n8*n1*if(frac(y*h/4) < 0.5, 1, 0))*(1 + i5*0.3))" },
						NumberIn2 = Input { Expression = "GcCtrl.P" },
						GreenExpression = Input { Value = "if(n1 <= 0, if(n2 >= 0.5, g2, g1), if(i8 > 0, getg2b(frac(i6 + 0*n5*n1*(0.5 + i1) + 4), i7), getg1b(frac(i6 + 0*n5*n1*(0.5 + i1) + 4), i7))*(1 - n8*n1*if(frac(y*h/4) < 0.5, 1, 0))*(1 + i5*0.3))" },
						Intermediate7 = Input { Value = "if(i5 > 0, frac(y + (frac(i4*37.7) - 0.5)*0.3 + 4), y)" },
						BlueExpression = Input { Value = "if(n1 <= 0, if(n2 >= 0.5, b2, b1), if(i8 > 0, getb2b(frac(i6 + (-1)*n5*n1*(0.5 + i1) + 4), i7), getb1b(frac(i6 + (-1)*n5*n1*(0.5 + i1) + 4), i7))*(1 - n8*n1*if(frac(y*h/4) < 0.5, 1, 0))*(1 + i5*0.3))" },
						Intermediate3 = Input { Value = "n1*n4*(if(frac(i1*7.31) < 0.25 + 0.5*n1, (i1 - 0.5)*2, 0) + if(frac(i2*5.17) < 0.3*n1, (i2 - 0.5)*0.6, 0))" },
						AlphaExpression = Input { Value = "if(n2 >= 0.5, a2, a1)" },
						Intermediate4 = Input { Value = "abs(frac(sin((floor(x*12)*1.37 + floor(y*n3*1.5)*5.11 + 3.3)*12.9898 + n6*78.233 + p1x*3.7)*43758.5453))" },
						PointIn1 = Input { Expression = "Point(GcCtrl.GcSeed, 0)" },
						Intermediate5 = Input { Value = "if(i4 < n7*n1, 1, 0)" },

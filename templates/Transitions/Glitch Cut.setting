						Intermediate6 = Input { Value = "frac(x + i3 + i5*(frac(i4*91.3) - 0.5)*0.5 + 4)" },
						NumberIn1 = Input { Expression = "iif(GcCtrl.P <= 0 or GcCtrl.P >= 1, 0, GcCtrl.GcAmount * sin(GcCtrl.P*pi)^0.6)" },
						NumberIn7 = Input { Expression = "GcCtrl.GcBlocks" }

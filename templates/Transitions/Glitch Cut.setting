					Inputs = {
						Intermediate8 = Input { Value = "if(frac(i1*3.71 + i2*0.2) < n2, 1, 0)" },
						NumberIn8 = Input { Expression = "GcCtrl.GcLines" },
						Intermediate1 = Input { Value = "abs(frac(sin((floor(y*n3 + 10*abs(frac(sin((1)*12.9898 + n6*78.233 + p1x*3.7)*43758.5453))))*12.9898 + n6*78.233 + p1x*3.7)*43758.5453))" },
						Image2 = Input {

{
	Tools = ordered() {
		ChapterBar = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "BarCtrl", Source = "Chapters", Name = "Chapters" },

				Input29 = InstanceInput { SourceOp = "Label", Source = "Style", ControlGroup = 4 },
				Input30 = InstanceInput { SourceOp = "Label", Source = "Red1", Name = "Name Color", ControlGroup = 5 },
				Input31 = InstanceInput { SourceOp = "Label", Source = "Green1", ControlGroup = 5 },
				Input32 = InstanceInput { SourceOp = "Label", Source = "Blue1", ControlGroup = 5 },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "BarOut", Source = "Output" }
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				BarCtrl = Background {
					Inputs = {
						S1 = Input { Expression = "iif(1 < Chapters, iif(EvenSplit == 1, 1/Chapters, Start2), 2)" },
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						S2 = Input { Expression = "iif(2 < Chapters, iif(EvenSplit == 1, 2/Chapters, Start3), 2)" },
						S3 = Input { Expression = "iif(3 < Chapters, iif(EvenSplit == 1, 3/Chapters, Start4), 2)" },
						UseFrameFormatSettings = Input { Value = 1 },
						S4 = Input { Expression = "iif(4 < Chapters, iif(EvenSplit == 1, 4/Chapters, Start5), 2)" },
						GlobalIn = Input { Value = -480 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Cur = Input { Expression = "1 + iif(P >= S1, 1, 0) + iif(P >= S2, 1, 0) + iif(P >= S3, 1, 0) + iif(P >= S4, 1, 0) + iif(P >= S5, 1, 0)" },
						CurStart = Input { Expression = "iif(Cur == 2, S1, iif(Cur == 3, S2, iif(Cur == 4, S3, iif(Cur == 5, S4, iif(Cur == 6, S5, 0)))))" },
						CurEnd = Input { Expression = "iif(Cur == 1, min(S1, 1), iif(Cur == 2, min(S2, 1), iif(Cur == 3, min(S3, 1), iif(Cur == 4, min(S4, 1), iif(Cur == 5, min(S5, 1), 1)))))" },
						LabelFade = Input { Expression = "iif(Cur <= 1, 1, min(max((time - (comp.RenderStart + CurStart*(comp.RenderEnd - comp.RenderStart)))/10, 0), 1))" },
						TopLeftAlpha = Input { Value = 0 },
						S5 = Input { Expression = "iif(5 < Chapters, iif(EvenSplit == 1, 5/Chapters, Start6), 2)" },
						P = Input { Expression = "min(max((time - comp.RenderStart) / max(comp.RenderEnd - comp.RenderStart, 1), 0), 1)" }
					},
					UserControls = {
						Knob = {
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl",
							LINKID_DataType = "Number",
							LINKS_Name = "Knob Size",
							INP_Default = 1.3,
							INP_MinScale = 0,
							INP_MaxScale = 3,
							INP_Integer = false
						},
						Name2 = {

				},
				Fill = Background {
					Inputs = {
						TopLeftBlue = Input { Value = 0.16 },
						GlobalIn = Input { Value = -480 },
						Height = Input { Value = 1080 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						UseFrameFormatSettings = Input { Value = 1 },
						TopLeftRed = Input { Value = 0.93 },
						Width = Input { Value = 1920 },
						TopLeftGreen = Input { Value = 0.16 }
					},
					ViewInfo = OperatorInfo { Pos = { -385, 49.5 } }
				},
				BarDraw = Custom {
					Inputs = {
						LUTIn4 = Input {
							SourceOp = "CustomTool1LUTIn4",
							Source = "Value"
						},
						Intermediate1 = Input { Value = "(x - n4)/(1 - 2*n4)" },
						Intermediate2 = Input { Value = "if(abs(y - n2) < n3/2, 1, 0) * if(i1 >= 0, 1, 0) * if(i1 <= 1, 1, 0)" },
						Intermediate3 = Input { Value = "min(min(abs(i1 - p1x), abs(i1 - p1y)), min(min(abs(i1 - p2x), abs(i1 - p2y)), abs(i1 - p3x)))" },
						Intermediate4 = Input { Value = "i2 * if(i3 > n5/2, 1, 0)" },
						Intermediate5 = Input { Value = "if(i1 <= n1, 1, 0)" },
						Image1 = Input {
							SourceOp = "Track",
							Source = "Output"
						},
						Intermediate6 = Input { Value = "if(sqrt(((x - n4 - n1*(1 - 2*n4))*w/h)^2 + (y - n2)^2) < n3*n7/2, 1, 0)" },
						Image2 = Input {
							SourceOp = "Fill",
							Source = "Output"
						},
						NumberIn1 = Input { Expression = "BarCtrl.P" },
						NumberIn2 = Input { Expression = "BarCtrl.BarY" },
						RedExpression = Input { Value = "if(i6 > 0, r2, i4 * if(i5 > 0, r2, r1*n6))" },
						NumberIn3 = Input { Expression = "BarCtrl.BarH" },
						GreenExpression = Input { Value = "if(i6 > 0, g2, i4 * if(i5 > 0, g2, g1*n6))" },
						NumberIn4 = Input { Expression = "BarCtrl.BarMargin" },
						BlueExpression = Input { Value = "if(i6 > 0, b2, i4 * if(i5 > 0, b2, b1*n6))" },
						NumberIn5 = Input { Expression = "BarCtrl.BarGap" },
						AlphaExpression = Input { Value = "if(i6 > 0, 1, i4 * if(i5 > 0, 1, n6))" },
						NumberIn6 = Input { Expression = "BarCtrl.TrackOpacity" },
						NumberIn7 = Input { Expression = "BarCtrl.Knob" },
						PointIn1 = Input { Expression = "Point(BarCtrl.S1, BarCtrl.S2)" },
						LUTIn1 = Input {
							SourceOp = "CustomTool1LUTIn1",
							Source = "Value"
						},
						PointIn3 = Input { Expression = "Point(BarCtrl.S5, 2)" },
						PointIn2 = Input { Expression = "Point(BarCtrl.S3, BarCtrl.S4)" },
						LUTIn2 = Input {
							SourceOp = "CustomTool1LUTIn2",
							Source = "Value"
						},
						LUTIn3 = Input {
							SourceOp = "CustomTool1LUTIn3",
							Source = "Value"
						}
					},
					ViewInfo = OperatorInfo { Pos = { -275, 16.5 } }
				},
				CustomTool1LUTIn1 = LUTBezier {
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },

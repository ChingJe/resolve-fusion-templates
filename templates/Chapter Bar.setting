						Softness1 = Input { Value = 1 },
						StyledText = Input { Expression = "Text(iif(BarCtrl.Cur == 6, BarCtrl.Name6.Value, iif(BarCtrl.Cur == 5, BarCtrl.Name5.Value, iif(BarCtrl.Cur == 4, BarCtrl.Name4.Value, iif(BarCtrl.Cur == 3, BarCtrl.Name3.Value, iif(BarCtrl.Cur == 2, BarCtrl.Name2.Value, BarCtrl.Name1.Value))))))" }
					},
					Version = 1,
					ViewInfo = OperatorInfo { Pos = { -275, -49.5 } }
				},

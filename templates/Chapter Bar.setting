						Size = Input { Expression = "BarCtrl.LabelSize" },
						Center = Input { Expression = "Point(BarCtrl.BarMargin + (BarCtrl.CurStart + BarCtrl.CurEnd)/2*(1 - 2*BarCtrl.BarMargin), BarCtrl.BarY + BarCtrl.BarH/2 + BarCtrl.LabelSize*0.75)" },
						Wrap = Input { Value = 1 },

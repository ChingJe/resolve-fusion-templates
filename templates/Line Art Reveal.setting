{
	Tools = ordered() {
		LineArtReveal = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				MainInput1 = InstanceInput { SourceOp = "Src", Source = "Input" },
				Input1 = InstanceInput { SourceOp = "SketchCtrl", Source = "SktStart", Name = "Reveal Start" },
				Input2 = InstanceInput { SourceOp = "SketchCtrl", Source = "SktEnd", Name = "Reveal End" },
				Input3 = InstanceInput { SourceOp = "SketchCtrl", Source = "SktReverse", Name = "Reverse (Picture To Drawing)" },
				Input4 = InstanceInput { SourceOp = "SketchCtrl", Source = "SktAngle", Name = "Sweep Angle" },
				Input5 = InstanceInput { SourceOp = "SketchCtrl", Source = "SktSoft", Name = "Sweep Softness" },
				Input6 = InstanceInput { SourceOp = "SketchCtrl", Source = "SktGlow", Name = "Scan Line Glow" },
				Input7 = InstanceInput { SourceOp = "SketchCtrl", Source = "SktWidth", Name = "Line Width" },
				Input8 = InstanceInput { SourceOp = "SketchCtrl", Source = "SktGain", Name = "Line Strength" },
				Input9 = InstanceInput { SourceOp = "SketchCtrl", Source = "SktSmooth", Name = "Detail Smoothing" },
				Input10 = InstanceInput { SourceOp = "Paper", Source = "TopLeftRed", Name = "Paper Color", ControlGroup = 2 },
				Input11 = InstanceInput { SourceOp = "Paper", Source = "TopLeftGreen", ControlGroup = 2 },
				Input12 = InstanceInput { SourceOp = "Paper", Source = "TopLeftBlue", ControlGroup = 2 },
				Input13 = InstanceInput { SourceOp = "Ink", Source = "TopLeftRed", Name = "Ink Color", ControlGroup = 3 },
				Input14 = InstanceInput { SourceOp = "Ink", Source = "TopLeftGreen", ControlGroup = 3 },
				Input15 = InstanceInput { SourceOp = "Ink", Source = "TopLeftBlue", ControlGroup = 3 },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Reveal", Source = "Output" }
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				SketchCtrl = Background {
					UserControls = {
						SktStart = {
							LINKID_DataType = "Number",
							LINKS_Name = "Reveal Start",
							INP_Default = 0.2,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl"
						},
						SktEnd = {
							LINKID_DataType = "Number",
							LINKS_Name = "Reveal End",
							INP_Default = 0.8,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl"
						},
						T = {
							LINKID_DataType = "Number",
							LINKS_Name = "T",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Integer = false,
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl"
						},
						SktSoft = {
							LINKID_DataType = "Number",
							LINKS_Name = "Sweep Softness",
							INP_Default = 0.06,
							INP_MinScale = 0.001,
							INP_MaxScale = 0.5,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl"
						},
						SktGlow = {
							LINKID_DataType = "Number",
							LINKS_Name = "Scan Line Glow",
							INP_Default = 0.6,
							INP_MinScale = 0,
							INP_MaxScale = 2,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl"
						},
						SktAngle = {
							LINKID_DataType = "Number",
							LINKS_Name = "Sweep Angle",
							INP_Default = 0,
							INP_MinScale = -180,
							INP_MaxScale = 180,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl"
						},
						SktWidth = {
							LINKID_DataType = "Number",
							LINKS_Name = "Line Width",
							INP_Default = 1.5,
							INP_MinScale = 0.5,
							INP_MaxScale = 6,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl"
						},
						SktReverse = {
							LINKS_Name = "Reverse (Picture To Drawing)",
							INP_Default = 0,
							INP_Integer = true,
							LINKID_DataType = "Number",
							ICS_ControlPage = "Controls",
							INPID_InputControl = "CheckboxControl"
						},
						P = {
							LINKID_DataType = "Number",
							LINKS_Name = "P",
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Integer = false,
							ICS_ControlPage = "Driver",
							INPID_InputControl = "SliderControl"
						},
						SktGain = {
							LINKID_DataType = "Number",
							LINKS_Name = "Line Strength",
							INP_Default = 6,
							INP_MinScale = 0.5,
							INP_MaxScale = 20,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl"
						},
						SktSmooth = {
							LINKID_DataType = "Number",
							LINKS_Name = "Detail Smoothing",
							INP_Default = 1.5,
							INP_MinScale = 0,
							INP_MaxScale = 10,
							INP_Integer = false,
							ICS_ControlPage = "Controls",
							INPID_InputControl = "SliderControl"
						}
					},
					CtrlWZoom = false,
					Inputs = {
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						P = Input { Expression = "min(max((time - comp.RenderStart) / max(comp.RenderEnd - comp.RenderStart, 1), 0), 1)" },
						T = Input { Expression = "(function(t) return iif(SktReverse == 1, 1 - t, t) end)(min(max((P - SktStart)/max(SktEnd - SktStart, 0.001), 0), 1))" },
						UseFrameFormatSettings = Input { Value = 1 },
						Width = Input { Value = 1920 },
						GlobalIn = Input { Value = -480 },
						Height = Input { Value = 1080 }
					},
					ViewInfo = OperatorInfo { Pos = { -495, -82.5 } }
				},
				Src = BrightnessContrast {
					ViewInfo = OperatorInfo { Pos = { -495, 16.5 } }
				},
				Smooth = Blur {
					ViewInfo = OperatorInfo { Pos = { -385, 49.5 } },
					Inputs = {
						XBlurSize = Input { Expression = "SketchCtrl.SktSmooth" },
						Input = Input {
							SourceOp = "Src",
							Source = "Output"
						},
						Filter = Input { Value = FuID { "Fast Gaussian" } }
					}
				},
				Paper = Background {
					ViewInfo = OperatorInfo { Pos = { -385, 82.5 } },
					Inputs = {
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						TopLeftRed = Input { Value = 0.96 },
						UseFrameFormatSettings = Input { Value = 1 },
						TopLeftGreen = Input { Value = 0.95 },
						TopLeftBlue = Input { Value = 0.91 },
						GlobalIn = Input { Value = -480 }
					}
				},
				Ink = Background {
					ViewInfo = OperatorInfo { Pos = { -385, 115.5 } },
					Inputs = {
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						TopLeftRed = Input { Value = 0.08 },
						UseFrameFormatSettings = Input { Value = 1 },
						TopLeftGreen = Input { Value = 0.09 },
						TopLeftBlue = Input { Value = 0.14 },
						GlobalIn = Input { Value = -480 }
					}
				},
				Sketch = Custom {
					ViewInfo = OperatorInfo { Pos = { -275, 49.5 } },
					Inputs = {
						Intermediate3 = Input { Value = "0.299*getr1d(x, y + n1/h) + 0.587*getg1d(x, y + n1/h) + 0.114*getb1d(x, y + n1/h)" },
						Intermediate4 = Input { Value = "0.299*getr1d(x, y - n1/h) + 0.587*getg1d(x, y - n1/h) + 0.114*getb1d(x, y - n1/h)" },
						LUTIn1 = Input {
							SourceOp = "CustomTool1LUTIn1",
							Source = "Value"
						},
						LUTIn2 = Input {
							SourceOp = "CustomTool1LUTIn2",
							Source = "Value"
						},
						LUTIn3 = Input {
							SourceOp = "CustomTool1LUTIn3",
							Source = "Value"
						},
						LUTIn4 = Input {
							SourceOp = "CustomTool1LUTIn4",
							Source = "Value"
						},
						BlueExpression = Input { Value = "b2*(1 - i5) + b3*i5" },
						AlphaExpression = Input { Value = "1" },
						Image1 = Input {
							SourceOp = "Smooth",
							Source = "Output"
						},
						Image2 = Input {
							SourceOp = "Paper",
							Source = "Output"
						},
						Image3 = Input {
							SourceOp = "Ink",
							Source = "Output"
						},
						NumberIn1 = Input { Expression = "SketchCtrl.SktWidth" },
						NumberIn2 = Input { Expression = "SketchCtrl.SktGain" },
						RedExpression = Input { Value = "r2*(1 - i5) + r3*i5" },
						Intermediate1 = Input { Value = "0.299*getr1d(x + n1/w, y) + 0.587*getg1d(x + n1/w, y) + 0.114*getb1d(x + n1/w, y)" },
						Intermediate5 = Input { Value = "min(sqrt((i1 - i2)^2 + (i3 - i4)^2)*n2, 1)" },
						Intermediate2 = Input { Value = "0.299*getr1d(x - n1/w, y) + 0.587*getg1d(x - n1/w, y) + 0.114*getb1d(x - n1/w, y)" },
						GreenExpression = Input { Value = "g2*(1 - i5) + g3*i5" }
					}
				},
				CustomTool1LUTIn1 = LUTBezier {
					SplineColor = { Green = 0, Blue = 0, Red = 0 },
					NameSet = true,
					CtrlWZoom = false,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					}
				},
				CustomTool1LUTIn2 = LUTBezier {
					SplineColor = { Green = 0, Blue = 0, Red = 0 },
					NameSet = true,
					CtrlWZoom = false,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					}
				},
				CustomTool1LUTIn3 = LUTBezier {
					SplineColor = { Green = 0, Blue = 0, Red = 0 },
					NameSet = true,
					CtrlWZoom = false,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					}
				},
				CustomTool1LUTIn4 = LUTBezier {
					SplineColor = { Green = 0, Blue = 0, Red = 0 },
					NameSet = true,
					CtrlWZoom = false,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					}
				},
				Reveal = Custom {
					ViewInfo = OperatorInfo { Pos = { -165, 16.5 } },
					Inputs = {
						Intermediate3 = Input { Value = "-i2 - n3 + n1*(2*i2 + 2*n3)" },
						Intermediate4 = Input { Value = "min(max((i3 - i1)/n3, 0), 1)" },
						RedExpression = Input { Value = "if(n1 >= 1, r1, r2 + (r1 - r2)*i4 + i5)" },
						LUTIn2 = Input {
							SourceOp = "CustomTool1LUTIn21",
							Source = "Value"
						},
						LUTIn3 = Input {
							SourceOp = "CustomTool1LUTIn31",
							Source = "Value"
						},
						LUTIn4 = Input {
							SourceOp = "CustomTool1LUTIn41",
							Source = "Value"
						},
						BlueExpression = Input { Value = "if(n1 >= 1, b1, b2 + (b1 - b2)*i4 + i5)" },
						AlphaExpression = Input { Value = "1" },
						Image1 = Input {
							SourceOp = "Src",
							Source = "Output"
						},
						Image2 = Input {
							SourceOp = "Sketch",
							Source = "Output"
						},
						NumberIn1 = Input { Expression = "SketchCtrl.T" },
						NumberIn3 = Input { Expression = "SketchCtrl.SktSoft" },
						NumberIn2 = Input { Expression = "SketchCtrl.SktAngle" },
						NumberIn4 = Input { Expression = "SketchCtrl.SktGlow" },
						Intermediate5 = Input { Value = "max(1 - abs(i3 - i1 - n3*0.5)/0.01, 0) * n4 * if(n1 <= 0, 0, if(n1 >= 1, 0, 1))" },
						Intermediate1 = Input { Value = "(x - 0.5)*cos(n2) + (y - 0.5)*sin(n2)" },
						LUTIn1 = Input {
							SourceOp = "CustomTool1LUTIn11",
							Source = "Value"
						},
						Intermediate2 = Input { Value = "0.5*(abs(cos(n2)) + abs(sin(n2)))" },
						GreenExpression = Input { Value = "if(n1 >= 1, g1, g2 + (g1 - g2)*i4 + i5)" }
					}
				},
				CustomTool1LUTIn11 = LUTBezier {
					SplineColor = { Green = 0, Blue = 0, Red = 0 },
					NameSet = true,
					CtrlWZoom = false,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					}
				},
				CustomTool1LUTIn21 = LUTBezier {
					SplineColor = { Green = 0, Blue = 0, Red = 0 },
					NameSet = true,
					CtrlWZoom = false,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					}
				},
				CustomTool1LUTIn31 = LUTBezier {
					SplineColor = { Green = 0, Blue = 0, Red = 0 },
					NameSet = true,
					CtrlWZoom = false,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					}
				},
				CustomTool1LUTIn41 = LUTBezier {
					SplineColor = { Green = 0, Blue = 0, Red = 0 },
					NameSet = true,
					CtrlWZoom = false,
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.333333333333333, 0.333333333333333 }, Flags = { Linear = true } },
							{ 1, Flags = { Linear = true }, LH = { 0.666666666666667, 0.666666666666667 } }
						}
					}
				}
			
			}
		}
	},
	ActiveTool = "LineArtReveal"
}

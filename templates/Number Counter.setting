{
	Tools = ordered() {
		NumberCounter = MacroOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "CountCtrl", Source = "CntStart", Name = "Start Value" },
				Input2 = InstanceInput { SourceOp = "CountCtrl", Source = "CntEnd", Name = "End Value" },
				Input3 = InstanceInput { SourceOp = "CountCtrl", Source = "CntDecimals", Name = "Decimals" },
				Input4 = InstanceInput { SourceOp = "CountCtrl", Source = "CntSep", Name = "Thousands Separator" },
				Input5 = InstanceInput { SourceOp = "CountCtrl", Source = "CntPrefix", Name = "Prefix" },
				Input6 = InstanceInput { SourceOp = "CountCtrl", Source = "CntSuffix", Name = "Suffix" },
				Input7 = InstanceInput { SourceOp = "CountCtrl", Source = "CntFinish", Name = "Count Finishes At" },
				Input8 = InstanceInput { SourceOp = "CountCtrl", Source = "CntPop", Name = "Pop" },
				Input9 = InstanceInput { SourceOp = "CountCtrl", Source = "CntSize", Name = "Size" },
				Input10 = InstanceInput { SourceOp = "Number", Source = "Font", Name = "Font", ControlGroup = 2 },
				Input11 = InstanceInput { SourceOp = "Number", Source = "Style", ControlGroup = 2 },
				Input12 = InstanceInput { SourceOp = "Number", Source = "Red1", Name = "Color", ControlGroup = 3 },
				Input13 = InstanceInput { SourceOp = "Number", Source = "Green1", ControlGroup = 3 },
				Input14 = InstanceInput { SourceOp = "Number", Source = "Blue1", ControlGroup = 3 },
				Input15 = InstanceInput { SourceOp = "Number", Source = "Center", Name = "Position" },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "Number", Source = "Output" }
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				CountCtrl = Background {
					UserControls = {
						CntDecimals = {
							INP_MinScale = 0,
							INP_MaxScale = 3,
							INP_Integer = true,
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							ICS_ControlPage = "Controls",
							LINKS_Name = "Decimals",
							INP_Default = 0
						},
						Bump = {
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Integer = false,
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							ICS_ControlPage = "Driver",
							LINKS_Name = "Bump",
							INP_Default = 0
						},
						CntSep = {
							INP_Integer = true,
							ICS_ControlPage = "Controls",
							INPID_InputControl = "CheckboxControl",
							LINKID_DataType = "Number",
							LINKS_Name = "Thousands Separator",
							INP_Default = 1
						},
						CntPrefix = {
							INPS_DefaultText = "",
							TEC_Lines = 1,
							LINKID_DataType = "Text",
							INPID_InputControl = "TextEditControl",
							LINKS_Name = "Prefix",
							ICS_ControlPage = "Controls"
						},
						CntEnd = {
							INP_MinScale = 0,
							INP_MaxScale = 100000,
							INP_Integer = false,
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							ICS_ControlPage = "Controls",
							LINKS_Name = "End Value",
							INP_Default = 12500
						},
						CntSuffix = {
							INPS_DefaultText = "",
							TEC_Lines = 1,
							LINKID_DataType = "Text",
							INPID_InputControl = "TextEditControl",
							LINKS_Name = "Suffix",
							ICS_ControlPage = "Controls"
						},
						P = {
							INP_MinScale = 0,
							INP_MaxScale = 1,
							INP_Integer = false,
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							ICS_ControlPage = "Driver",
							LINKS_Name = "P",
							INP_Default = 0
						},
						CntFinish = {
							INP_MinScale = 0.05,
							INP_MaxScale = 1,
							INP_Integer = false,
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							ICS_ControlPage = "Controls",
							LINKS_Name = "Count Finishes At",
							INP_Default = 0.7
						},
						CntPop = {
							INP_MinScale = 0,
							INP_MaxScale = 0.5,
							INP_Integer = false,
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							ICS_ControlPage = "Controls",
							LINKS_Name = "Pop",
							INP_Default = 0.12
						},
						CntStart = {
							INP_MinScale = 0,
							INP_MaxScale = 1000,
							INP_Integer = false,
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							ICS_ControlPage = "Controls",
							LINKS_Name = "Start Value",
							INP_Default = 0
						},
						V = {
							INP_MinScale = 0,
							INP_MaxScale = 100000,
							INP_Integer = false,
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							ICS_ControlPage = "Driver",
							LINKS_Name = "V",
							INP_Default = 0
						},
						CntSize = {
							INP_MinScale = 0.02,
							INP_MaxScale = 0.5,
							INP_Integer = false,
							LINKID_DataType = "Number",
							INPID_InputControl = "SliderControl",
							ICS_ControlPage = "Controls",
							LINKS_Name = "Size",
							INP_Default = 0.18
						}
					},
					Inputs = {
						Bump = Input { Expression = "CntPop * sin(3.14159265 * min(max((P - CntFinish)/0.06, 0), 1))" },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						TopLeftAlpha = Input { Value = 0 },
						V = Input { Expression = "CntStart + (CntEnd - CntStart) * (1 - (1 - min(P/CntFinish, 1))^3)" },
						P = Input { Expression = "min(max((time - comp.RenderStart) / max(comp.RenderEnd - comp.RenderStart, 1), 0), 1)" },
						UseFrameFormatSettings = Input { Value = 1 },
						Width = Input { Value = 1920 },
						Height = Input { Value = 1080 },
						GlobalIn = Input { Value = -480 }
					},
					ViewInfo = OperatorInfo { Pos = { -495, -82.5 } }
				},
				Number = TextPlus {
					ViewInfo = OperatorInfo { Pos = { -275, 16.5 } },
					Inputs = {
						Size = Input { Expression = "CountCtrl.CntSize * (1 + CountCtrl.Bump)" },
						HorizontalJustificationNew = Input { Value = 3 },
						GlobalIn = Input { Value = -480 },
						VerticalJustificationNew = Input { Value = 3 },
						GlobalOut = Input { Value = 3534 },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" } },
						Style = Input { Value = "Bold" },
						UseFrameFormatSettings = Input { Value = 1 },
						StyledText = Input { Expression = "Text(CountCtrl.CntPrefix.Value .. (function(v, d, sep)\n  local s = string.format(\"%.\" .. d .. \"f\", v)\n  local whole, rest = s:match(\"^(-?%d+)(.*)$\")\n  if sep == 1 then whole = whole:reverse():gsub(\"(%d%d%d)\", \"%1,\"):reverse():gsub(\"^(-?),\", \"%1\") end\n  return whole .. rest\nend)(CountCtrl.V, CountCtrl.CntDecimals, CountCtrl.CntSep) .. CountCtrl.CntSuffix.Value)" },
						Width = Input { Value = 1920 },
						TransformRotation = Input { Value = 1 },
						Font = Input { Value = "Open Sans" },
						Wrap = Input { Value = 1 },
						LayoutRotation = Input { Value = 1 },
						Height = Input { Value = 1080 },
						Softness1 = Input { Value = 1 }
					},
					Version = 1
				}
			
			}
		}
	},
	ActiveTool = "NumberCounter"
}
